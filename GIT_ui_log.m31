// The `@` command-log overlay: the ring buffer of write operations
// (`Core.command_log`), one line each, newest at the bottom, scrollable.

import GIT_ui_core;
import GIT_ui_panel;
import term;
import tui.TUI_app;
import tui.TUI_buffer;
import tui.TUI_geometry;

type LogOverlay {
    GIT_ui_core.Core host;
    // The first line shown. Starts past the end so the first render clamps it
    // to the newest lines; render stores the clamped value back.
    int offset = 1000000000;
}

pub TUI_app.Action LogOverlay.handle_key(term.Code code) {
    match (GIT_ui_core.lookup(GIT_ui_core.SCOPE_LOG, code)) {
        case Some(str cmd): {
            if (cmd == GIT_ui_core.CMD_CLOSE) {
                host.pop_overlay();
            }
            if (cmd == GIT_ui_core.CMD_DOWN) {
                offset = offset + 1;
            }
            if (cmd == GIT_ui_core.CMD_UP) {
                offset = offset - 1;
                if (offset < 0) {
                    offset = 0;
                }
            }
            if (cmd == GIT_ui_core.CMD_TOP) {
                offset = 0;
            }
            if (cmd == GIT_ui_core.CMD_BOTTOM) {
                offset = 1000000000;
            }
            return TUI_app.Action.Redraw;
        }
        case None: {
        }
    }
    return TUI_app.Action.Continue;
}

pub void LogOverlay.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_geometry.Rect inner = GIT_ui_panel.frame(buffer, area, "command log (" + host.command_log.size().to_str() + ")");
    if (inner.is_empty()) {
        return;
    }
    List<str> text = host.command_log;
    if (text.size() == 0) {
        text = ["(no write operations yet)"];
    }
    offset = GIT_ui_panel.clamp(offset, text.size(), inner.height);
    GIT_ui_panel.draw_lines(buffer, inner, text, offset, -1);
}

pub List<GIT_ui_core.Hint> LogOverlay.hints() {
    return GIT_ui_core.hints_for(GIT_ui_core.SCOPE_LOG);
}

/// `@`: open the command log.
pub void open(GIT_ui_core.Core core) {
    core.push_overlay(LogOverlay(core));
}
