// The commit-history walk, factored out of `git.m31`'s own `-log` command so
// it is written exactly once. See `docs/design.md`, "Starting the
// client": the interactive client's commit section is populated "from the
// existing log/object read side" and is told to "reuse that logic rather
// than re-deriving it" -- this module is that logic, moved rather than
// copied. `git.m31`'s `-log` command now calls `walk` too, so there is one
// implementation of git's own date-ordered queue, not two that drift apart.
//
// API
// ---
//   GIT_log.walk(gitdir, rev, limit)  -> Result<List<Entry>, Error>
//
// `rev` is anything `GIT_revparse.commit_id` accepts (a ref, an object name or
// an abbreviation, `HEAD~3`, `main^{/fix}`, `@{-1}`, ...); `limit` stops after that many commits, newest committer date
// first, or walks everything reachable when negative -- `ourgit -log`'s own
// `--max` and default.

import GIT_object;
import GIT_refs;
import GIT_revparse;

/// Why the walk could not run. Payload-free where the underlying error
/// already says everything (docs/errors-decision.md §4); `NotACommit` names
/// the one object the walk itself found not to be one.
pub enum Error {
    Refs(GIT_refs.Error);
    Object(GIT_object.Error);
    NotACommit(str);
    Rev(GIT_revparse.Error);
}

pub str Error.to_str() {
    match (this) {
        case Refs(GIT_refs.Error error): {
            return "refs: " + error.to_str();
        }
        case Object(GIT_object.Error error): {
            return "object: " + error.to_str();
        }
        case NotACommit(str id): {
            return "not a commit: " + id;
        }
        case Rev(GIT_revparse.Error error): {
            return error.to_str();
        }
    }
}

/// One commit the walk visited: its object name and its parsed body.
pub type Entry {
    pub str id;
    pub GIT_object.Commit commit;
}

/// Every commit reachable from `rev`, newest committer date first.
///
/// git's own queue, moved here verbatim from `git.m31`'s original `log`: a
/// list kept in descending committer-date order, pop the front, keep it,
/// insert its parents by date -- equal dates keeping the order they were
/// inserted in, which is `commit_list_insert_by_date`'s own tie-break and is
/// why two commits made in the same second come out in a fixed order rather
/// than an arbitrary one.
pub Result<List<Entry>, Error> walk(str gitdir, str rev, int limit) {
    str tip = "";
    match (GIT_revparse.commit_id(gitdir, rev)) {
        case Ok(str resolved): {
            tip = resolved;
        }
        case Err(GIT_revparse.Error error): {
            return Result<List<Entry>, Error>.Err(Error.Rev(error));
        }
    }
    List<str> queue = [tip];
    List<int> dates = [0];
    Map<str, bool> seen = {};
    seen.set(tip, true);
    List<Entry> out = [];
    while (queue.size() > 0) {
        if (limit >= 0 && out.size() >= limit) {
            return Result<List<Entry>, Error>.Ok(out);
        }
        str id = queue.remove_at(0);
        dates.remove_at(0);
        match (GIT_object.read(gitdir, id)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        out.push(Entry(id, commit));
                        for (str par in commit.parents) {
                            if (seen.contains(par)) {
                                continue;
                            }
                            seen.set(par, true);
                            insert(queue, dates, par, commit_date(gitdir, par));
                        }
                    }
                    case Blob: {
                        return Result<List<Entry>, Error>.Err(Error.NotACommit(id));
                    }
                    case Tree: {
                        return Result<List<Entry>, Error>.Err(Error.NotACommit(id));
                    }
                    case Tag: {
                        return Result<List<Entry>, Error>.Err(Error.NotACommit(id));
                    }
                }
            }
            case Err(GIT_object.Error error): {
                return Result<List<Entry>, Error>.Err(Error.Object(error));
            }
        }
    }
    return Result<List<Entry>, Error>.Ok(out);
}

// `id` and `when` into the two parallel lists, before the first entry whose
// date is strictly older -- `git.m31`'s original comment on this, unchanged:
// two lists rather than a list of pairs because a struct here would be a
// third type for four lines of code, and `remove_at` on both is the pop.
void insert(List<str> queue, List<int> dates, str id, int when) {
    int index = 0;
    while (index < dates.size() && dates[index] >= when) {
        index = index + 1;
    }
    queue.insert(index, id);
    dates.insert(index, when);
}

// A commit's committer timestamp, or 0 for anything that is not a readable
// commit -- a parent in a packfile, say, which sorts to the end of the queue
// and reports itself when it is reached.
int commit_date(str gitdir, str id) {
    match (GIT_object.read(gitdir, id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    return commit.committer.when;
                }
                case Blob: {
                    return 0;
                }
                case Tree: {
                    return 0;
                }
                case Tag: {
                    return 0;
                }
            }
        }
        case Err: {
            return 0;
        }
    }
}
