// Writing the working tree from a tree -- the primitive `design.md` named as
// the missing piece behind branch switching ("no 'write the working tree
// from a tree' primitive exists"), and `git checkout <branch>` built on it.
//
// What `checkout` does, in git's own order and with git's own refusals:
//
//   1. Flatten HEAD's tree and the target commit's tree to `path -> (mode,
//      blob)` and keep only the paths that differ -- a path identical on both
//      sides is never touched, so a local modification to it survives the
//      switch exactly as it does under real git.
//   2. Refuse, writing nothing, if any differing path is dirty: staged or
//      unstaged changes (`GIT_status.status`'s own two lists), or an untracked
//      file already sitting where the target needs to write one. Refuse a
//      submodule (gitlink) outright: this program has no notion of a nested
//      repository. One named `Error` per refusal, so the client can say why.
//   3. Write exactly the differing paths: create or overwrite a file with the
//      target's mode (`0o100755` executable, `0o100644` plain) by removing
//      the old one first and creating anew with that permission -- `io.open`'s
//      `perm` only applies to a file it creates, and there is no `chmod` in
//      the stdlib; a symlink (`0o120000`) via `fs.symlink`; a deletion via
//      `fs.remove`, pruning directories left empty above it.
//   4. Update the index for those same paths -- `GIT_index.from_stat` on each
//      written file, exactly as `GIT_client.stage_path` builds an entry;
//      deleted paths dropped -- leaving every other entry (and its cached
//      stat fields) as it was, which is what keeps unrelated local changes
//      intact across the switch.
//   5. Move HEAD: symbolically to the branch (`GIT_refs.update_symbolic`), or
//      directly to the commit for a detached checkout (`GIT_refs.update`).
//
// A tree entry whose name is not UTF-8 is left out of the comparison, the
// same skip `GIT_status.m31` and `GIT_object.flatten_tree` already make -- a path
// this program cannot spell is one it should not be deleting or writing.
//
// `branches` lists `refs/heads/*`, the current one marked, for the client's
// "Branches" section; `create_branch` is `git branch <name>` + `git
// switch`: a new ref at HEAD's commit and HEAD moved onto it, nothing in the
// working tree or index touched -- the one checkout that never needs step 3.

import fs;
import GIT_index;
import io;
import GIT_object;
import GIT_refs;
import GIT_status;

/// Why a checkout did not happen (nothing written) or did not finish.
pub enum Error {
    /// A path the switch must rewrite has staged or unstaged changes.
    Dirty;
    /// An untracked file is already where the target tree needs to write.
    UntrackedCollision;
    /// The switch would have to touch a submodule, which this cannot do.
    Submodule;
    /// The target is not a commit.
    NotACommit;
    /// A working-tree file could not be written or removed.
    Io;
    /// An object could not be read.
    Object(GIT_object.Error);
    /// The index could not be written.
    Index(GIT_index.Error);
    /// HEAD, the branch, or the ref listing could not be read or written.
    Refs(GIT_refs.Error);
    /// `GIT_status.status` itself failed, so dirtiness could not be checked.
    Status(GIT_status.Error);
    /// A branch of that name already exists (`create_branch`).
    BranchExists;
    /// Not a name a branch can have (`create_branch`).
    BadName;
}

pub str Error.to_str() {
    match (this) {
        case Dirty: {
            return "local changes to a file the switch would overwrite -- commit, stage elsewhere, or discard them first";
        }
        case UntrackedCollision: {
            return "an untracked file is in the way of a file the switch would write";
        }
        case Submodule: {
            return "the switch would touch a submodule, which this client cannot check out";
        }
        case NotACommit: {
            return "the target is not a commit";
        }
        case Io: {
            return "a working-tree file could not be written or removed";
        }
        case Object(GIT_object.Error error): {
            return "object: " + error.to_str();
        }
        case Index(GIT_index.Error error): {
            return "index: " + error.to_str();
        }
        case Refs(GIT_refs.Error error): {
            return "refs: " + error.to_str();
        }
        case Status(GIT_status.Error error): {
            return "status: " + error.to_str();
        }
        case BranchExists: {
            return "a branch of that name already exists";
        }
        case BadName: {
            return "not a valid branch name";
        }
    }
}

/// One local branch: `name` is the short name (`main`), `full` the ref
/// (`refs/heads/main`), `id` its tip, `is_current` whether HEAD is on it.
pub type Branch {
    pub str name;
    pub str full;
    pub str id;
    pub bool is_current;
}

/// What `checkout` touched: how many paths it wrote and how many it removed.
pub type Summary {
    pub int written;
    pub int removed;
}

/// Every local branch, sorted by name, the current one marked -- `HEAD`
/// pointing at an unborn branch marks that name current too, since that is
/// where a commit would land.
pub Result<List<Branch>, Error> branches(str gitdir) {
    List<GIT_refs.Ref> all = [];
    match (GIT_refs.all(gitdir)) {
        case Ok(List<GIT_refs.Ref> listed): {
            all = listed;
        }
        case Err(GIT_refs.Error error): {
            return Result<List<Branch>, Error>.Err(Error.Refs(error));
        }
    }
    str current = "";
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    current = name;
                }
                case Unborn(str name): {
                    current = name;
                }
                case Detached(str id): {
                }
            }
        }
        case Err(GIT_refs.Error error): {
            return Result<List<Branch>, Error>.Err(Error.Refs(error));
        }
    }
    str prefix = "refs/heads/";
    Map<str, str> ids = {};
    List<str> names = [];
    for (GIT_refs.Ref branch_ref in all) {
        if (branch_ref.name.starts_with(prefix)) {
            names.push(branch_ref.name);
            ids.set(branch_ref.name, branch_ref.id);
        }
    }
    names.sort();
    List<Branch> out = [];
    for (str full in names) {
        out.push(Branch(full.substr(prefix.size(), full.size()), full, ids.get(full).or(""), full == current));
    }
    return Result<List<Branch>, Error>.Ok(out);
}

/// `git switch -c <name>`: a new branch at HEAD's commit, and HEAD moved
/// onto it. The working tree and the index are untouched -- the new branch's
/// tree IS HEAD's tree, so there is nothing to write. Refuses a name that
/// already exists, and a name git itself would refuse (empty, a leading `-`,
/// `..`, whitespace, a control character, `.lock`, a slash at either end).
pub Result<bool, Error> create_branch(str gitdir, str name) {
    if (!is_plausible_branch_name(name)) {
        return Result<bool, Error>.Err(Error.BadName);
    }
    str full = "refs/heads/" + name;
    if (GIT_refs.has_ref(gitdir, full)) {
        return Result<bool, Error>.Err(Error.BranchExists);
    }
    str head_id = "";
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(_, str id): {
                    head_id = id;
                }
                case Detached(str id): {
                    head_id = id;
                }
                case Unborn(_): {
                    // Nothing committed yet: the new branch is unborn too, so
                    // only HEAD moves. `git switch -c` on a fresh repository
                    // does exactly this.
                    match (GIT_refs.update_symbolic(gitdir, "HEAD", full)) {
                        case Ok: {
                            return Result<bool, Error>.Ok(true);
                        }
                        case Err(GIT_refs.Error error): {
                            return Result<bool, Error>.Err(Error.Refs(error));
                        }
                    }
                }
            }
        }
        case Err(GIT_refs.Error error): {
            return Result<bool, Error>.Err(Error.Refs(error));
        }
    }
    match (GIT_refs.update(gitdir, full, head_id, Option<str>.Some(""))) {
        case Ok: {
        }
        case Err(GIT_refs.Error error): {
            return Result<bool, Error>.Err(Error.Refs(error));
        }
    }
    match (GIT_refs.update_symbolic(gitdir, "HEAD", full)) {
        case Ok: {
            return Result<bool, Error>.Ok(true);
        }
        case Err(GIT_refs.Error error): {
            return Result<bool, Error>.Err(Error.Refs(error));
        }
    }
}

bool is_plausible_branch_name(str name) {
    if (name == "" || name == "HEAD" || name.starts_with("-") || name.starts_with("/") || name.ends_with("/") || name.ends_with(".lock") || name.ends_with(".")) {
        return false;
    }
    if (name.contains("..") || name.contains("//") || name.contains("@{") || name.contains("/.")) {
        return false;
    }
    for (int i in 0 .. name.size()) {
        int byte_value = name.byte_at(i);
        if (byte_value <= 32 || byte_value == 127 || byte_value == '~' || byte_value == '^' || byte_value == ':' || byte_value == '?' || byte_value == '*' || byte_value == '[' || byte_value == '\\') {
            return false;
        }
    }
    return true;
}

/// Check out `target_commit_id`: write the working tree and the index to its
/// tree (only the paths that differ from HEAD's tree), then point HEAD at
/// `target_ref` (a full ref name, `refs/heads/<branch>`), or directly at the
/// commit when `target_ref` is `""` -- a detached checkout. Refuses, writing
/// nothing, per the module header's rules; on success the repository is in
/// exactly the state `git checkout` would leave: `git status` clean for every
/// path the switch touched, the index matching the target tree for them,
/// HEAD moved.
pub Result<Summary, Error> checkout(str gitdir, str worktree, str target_commit_id, str target_ref) {
    Map<str, TreeEntry> target = {};
    match (tree_of_commit(gitdir, target_commit_id)) {
        case Ok(Map<str, TreeEntry> tree): {
            target = tree;
        }
        case Err(Error error): {
            return Result<Summary, Error>.Err(error);
        }
    }
    Map<str, TreeEntry> current = {};
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    match (tree_of_commit(gitdir, id)) {
                        case Ok(Map<str, TreeEntry> tree): {
                            current = tree;
                        }
                        case Err(Error error): {
                            return Result<Summary, Error>.Err(error);
                        }
                    }
                }
                case Detached(str id): {
                    match (tree_of_commit(gitdir, id)) {
                        case Ok(Map<str, TreeEntry> tree): {
                            current = tree;
                        }
                        case Err(Error error): {
                            return Result<Summary, Error>.Err(error);
                        }
                    }
                }
                case Unborn(str name): {
                }
            }
        }
        case Err(GIT_refs.Error error): {
            return Result<Summary, Error>.Err(Error.Refs(error));
        }
    }
    // --- 1. the paths that differ ----------------------------------------
    List<str> paths = [];
    for (str path in target.keys()) {
        paths.push(path);
    }
    for (str path in current.keys()) {
        if (!target.contains(path)) {
            paths.push(path);
        }
    }
    paths.sort();
    List<Step> plan = [];
    for (str path in paths) {
        TreeEntry old = current.get(path).or(TreeEntry(0, ""));
        TreeEntry new = target.get(path).or(TreeEntry(0, ""));
        if (old.mode == new.mode && old.id == new.id) {
            continue;
        }
        if (old.mode >> 12 == 0o16 || new.mode >> 12 == 0o16) {
            return Result<Summary, Error>.Err(Error.Submodule);
        }
        plan.push(Step(path, old, new));
    }
    // --- 2. refuse before touching anything ------------------------------
    Map<str, bool> dirty = {};
    Map<str, bool> untracked = {};
    match (GIT_status.status(gitdir, worktree)) {
        case Ok(GIT_status.Status status): {
            for (GIT_status.Delta delta in status.staged) {
                dirty.set(delta.path.utf8().or(""), true);
            }
            for (GIT_status.Delta delta in status.unstaged) {
                dirty.set(delta.path.utf8().or(""), true);
            }
            for (bytes untracked_path in status.untracked) {
                untracked.set(untracked_path.utf8().or(""), true);
            }
        }
        case Err(GIT_status.Error error): {
            return Result<Summary, Error>.Err(Error.Status(error));
        }
    }
    for (Step step in plan) {
        if (dirty.contains(step.path)) {
            return Result<Summary, Error>.Err(Error.Dirty);
        }
        if (step.old.id == "" && step.new.id != "") {
            // Nothing in HEAD at this path, so anything on disk here is
            // untracked (or ignored -- git overwrites an ignored file
            // silently; this refuses it too, the stricter and safer choice
            // for a client whose whole promise is never losing a file).
            str full = fs.join(worktree, step.path);
            if (untracked.contains(step.path) || fs.exists(full) || fs.is_link(full)) {
                return Result<Summary, Error>.Err(Error.UntrackedCollision);
            }
        }
    }
    // --- 3. the working tree ---------------------------------------------
    GIT_index.Index index = GIT_index.Index([]);
    match (GIT_index.read(gitdir)) {
        case Ok(GIT_index.Index got): {
            index = got;
        }
        case Err(GIT_index.Error error): {
            match (error) {
                case NotFound: {
                }
                case Io: {
                    return Result<Summary, Error>.Err(Error.Index(error));
                }
                case Truncated: {
                    return Result<Summary, Error>.Err(Error.Index(error));
                }
                case BadSignature: {
                    return Result<Summary, Error>.Err(Error.Index(error));
                }
                case BadVersion: {
                    return Result<Summary, Error>.Err(Error.Index(error));
                }
                case BadExtension: {
                    return Result<Summary, Error>.Err(Error.Index(error));
                }
                case Checksum: {
                    return Result<Summary, Error>.Err(Error.Index(error));
                }
            }
        }
    }
    int written = 0;
    int removed = 0;
    for (Step step in plan) {
        str full = fs.join(worktree, step.path);
        if (step.new.id == "") {
            match (remove_path(worktree, full)) {
                case Ok: {
                }
                case Err(Error error): {
                    return Result<Summary, Error>.Err(error);
                }
            }
            drop_entry(index, step.path.to_bytes());
            removed = removed + 1;
            continue;
        }
        bytes content = [];
        match (GIT_object.read(gitdir, step.new.id)) {
            case Ok(GIT_object.Object object): {
                content = object.raw;
            }
            case Err(GIT_object.Error error): {
                return Result<Summary, Error>.Err(Error.Object(error));
            }
        }
        match (write_path(full, content, step.new.mode)) {
            case Ok: {
            }
            case Err(Error error): {
                return Result<Summary, Error>.Err(error);
            }
        }
        // --- 4. its index entry ------------------------------------------
        GIT_index.Entry entry = GIT_index.Entry(0, 0, 0, 0, 0, 0, step.new.mode, 0, 0, content.size(), step.new.id, 0, false, step.path.to_bytes());
        if (step.new.mode >> 12 != 0o12) {
            match (fs.stat(full)) {
                case Ok(fs.Stat stat): {
                    entry = GIT_index.from_stat(step.path.to_bytes(), stat, false, step.new.id);
                }
                case Err(_): {
                    return Result<Summary, Error>.Err(Error.Io);
                }
            }
        }
        put_entry(index, entry);
        written = written + 1;
    }
    match (GIT_index.write(gitdir, index)) {
        case Ok: {
        }
        case Err(GIT_index.Error error): {
            return Result<Summary, Error>.Err(Error.Index(error));
        }
    }
    // --- 5. HEAD ---------------------------------------------------------
    if (target_ref == "") {
        match (GIT_refs.update(gitdir, "HEAD", target_commit_id, Option<str>.None)) {
            case Ok: {
            }
            case Err(GIT_refs.Error error): {
                return Result<Summary, Error>.Err(Error.Refs(error));
            }
        }
    } else {
        match (GIT_refs.update_symbolic(gitdir, "HEAD", target_ref)) {
            case Ok: {
            }
            case Err(GIT_refs.Error error): {
                return Result<Summary, Error>.Err(Error.Refs(error));
            }
        }
    }
    return Result<Summary, Error>.Ok(Summary(written, removed));
}

// One blob in a flattened tree: its mode and name. `mode` 0 / `id` "" is
// "absent", the value `checkout` compares against for an added or deleted
// path.
type TreeEntry {
    int mode;
    str id;
}

// One path `checkout` will touch: what is there now, what should be.
type Step {
    str path;
    TreeEntry old;
    TreeEntry new;
}

// The commit's tree, flattened. `GIT_object.flatten_tree` drops the mode, and the
// mode is exactly what a checkout needs (an executable bit changing is a
// change; a symlink is written differently from a file), so this is its own
// walk, the same shape with the mode kept.
Result<Map<str, TreeEntry>, Error> tree_of_commit(str gitdir, str commit_id) {
    str tree_id = "";
    match (GIT_object.read(gitdir, commit_id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    tree_id = commit.tree;
                }
                case Blob: {
                    return Result<Map<str, TreeEntry>, Error>.Err(Error.NotACommit);
                }
                case Tree(_): {
                    return Result<Map<str, TreeEntry>, Error>.Err(Error.NotACommit);
                }
                case Tag: {
                    return Result<Map<str, TreeEntry>, Error>.Err(Error.NotACommit);
                }
            }
        }
        case Err(GIT_object.Error error): {
            return Result<Map<str, TreeEntry>, Error>.Err(Error.Object(error));
        }
    }
    Map<str, TreeEntry> out = {};
    match (walk(gitdir, tree_id, "", out)) {
        case Ok: {
            return Result<Map<str, TreeEntry>, Error>.Ok(out);
        }
        case Err(Error error): {
            return Result<Map<str, TreeEntry>, Error>.Err(error);
        }
    }
}

Result<bool, Error> walk(str gitdir, str id, str prefix, Map<str, TreeEntry> out) {
    match (GIT_object.read(gitdir, id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Tree(List<GIT_object.Entry> entries): {
                    for (GIT_object.Entry entry in entries) {
                        match (entry.name.utf8()) {
                            case Some(str name): {
                                str full = name;
                                if (prefix != "") {
                                    full = prefix + "/" + name;
                                }
                                if (entry.is_tree()) {
                                    walk(gitdir, entry.id, full, out)?;
                                } else {
                                    out.set(full, TreeEntry(entry.mode, entry.id));
                                }
                            }
                            case None: {
                            }
                        }
                    }
                    return Result<bool, Error>.Ok(true);
                }
                case Blob: {
                    return Result<bool, Error>.Err(Error.Object(GIT_object.Error.BadTree));
                }
                case Commit: {
                    return Result<bool, Error>.Err(Error.Object(GIT_object.Error.BadTree));
                }
                case Tag: {
                    return Result<bool, Error>.Err(Error.Object(GIT_object.Error.BadTree));
                }
            }
        }
        case Err(GIT_object.Error error): {
            return Result<bool, Error>.Err(Error.Object(error));
        }
    }
}

// Write `content` at `full` with git's `mode`: a symlink for 0o120000,
// otherwise a file created with 0o755 or 0o644 (less the umask, as git's own
// 0o777/0o666 are). Any file already there is removed first -- `io.open`'s
// permission only applies to a file it creates, so an executable bit that
// changed would otherwise be kept as it was.
Result<bool, Error> write_path(str full, bytes content, int mode) {
    str parent = parent_directory(full);
    if (parent != "") {
        match (fs.makedirs(parent)) {
            case Ok: {
            }
            case Err(_): {
                return Result<bool, Error>.Err(Error.Io);
            }
        }
    }
    if (fs.exists(full) || fs.is_link(full)) {
        match (fs.remove(full)) {
            case Ok: {
            }
            case Err(_): {
                return Result<bool, Error>.Err(Error.Io);
            }
        }
    }
    if (mode >> 12 == 0o12) {
        str target = "";
        match (content.utf8()) {
            case Some(str found): {
                target = found;
            }
            case None: {
                return Result<bool, Error>.Err(Error.Io);
            }
        }
        match (fs.symlink(target, full)) {
            case Ok: {
                return Result<bool, Error>.Ok(true);
            }
            case Err(_): {
                return Result<bool, Error>.Err(Error.Io);
            }
        }
    }
    int perm = 0o644;
    if (mode & 0o111 != 0) {
        perm = 0o755;
    }
    match (io.open(full, mode: io.Mode.Write, perm: perm)) {
        case Ok(io.File file): {
            match (file.write(content)) {
                case Ok: {
                }
                case Err(_): {
                    return Result<bool, Error>.Err(Error.Io);
                }
            }
            match (file.close()) {
                case Ok: {
                    return Result<bool, Error>.Ok(true);
                }
                case Err(_): {
                    return Result<bool, Error>.Err(Error.Io);
                }
            }
        }
        case Err(_): {
            return Result<bool, Error>.Err(Error.Io);
        }
    }
}

// Remove the file at `full`, then every directory above it that is left
// empty, up to (never including) the working tree's root -- what `git
// checkout` does when a switch deletes the last file in a directory.
Result<bool, Error> remove_path(str worktree, str full) {
    if (fs.exists(full) || fs.is_link(full)) {
        match (fs.remove(full)) {
            case Ok: {
            }
            case Err(_): {
                return Result<bool, Error>.Err(Error.Io);
            }
        }
    }
    str directory = parent_directory(full);
    str root = fs.join(worktree, "");
    while (directory != "" && directory != worktree && directory != root && directory.starts_with(worktree)) {
        match (fs.rmdir(directory)) {
            case Ok: {
            }
            case Err(_): {
                return Result<bool, Error>.Ok(true);
            }
        }
        directory = parent_directory(directory);
    }
    return Result<bool, Error>.Ok(true);
}

// Everything before the last `/`, or `""` when there is none.
str parent_directory(str path) {
    int cut = -1;
    for (int i in 0 .. path.size()) {
        if (path.byte_at(i) == '/') {
            cut = i;
        }
    }
    if (cut <= 0) {
        return "";
    }
    return path.substr(0, cut);
}

void put_entry(GIT_index.Index index, GIT_index.Entry entry) {
    int position = 0;
    while (position < index.entries.size()) {
        if (is_same_bytes(index.entries[position].path, entry.path)) {
            index.entries[position] = entry;
            return;
        }
        position = position + 1;
    }
    index.entries.push(entry);
}

void drop_entry(GIT_index.Index index, bytes path) {
    int position = 0;
    while (position < index.entries.size()) {
        if (is_same_bytes(index.entries[position].path, path)) {
            index.entries.remove_at(position);
            return;
        }
        position = position + 1;
    }
}

bool is_same_bytes(bytes left, bytes right) {
    if (left.size() != right.size()) {
        return false;
    }
    for (int i in 0 .. left.size()) {
        if (left[i] != right[i]) {
            return false;
        }
    }
    return true;
}
