// Git's smart-HTTP protocol, the push half: `git-receive-pack` over
// `lib/http.m31`, the sibling of `GIT_http_fetch.m31` (which has the fetch half
// and whose pkt-line framing and advertisement parser this reuses rather
// than repeats). See `docs/design.md`'s "Going remote" for where this
// sits: a push is "compute what the remote lacks, pack it, send it with the
// ref update, read the server's verdict", and each of those is its own
// pure function here with one I/O-doing `push` tying them together.
//
// API
// ---
//   GIT_http_push.parse_remote(url)                  -> Result<Remote, Error>
//   GIT_http_push.discover(remote)                   -> Result<GIT_http_fetch.Advertisement, Error>
//   GIT_http_push.push(gitdir, remote, refname, id)  -> Result<Report, Error>
//
// The seam, testable with no socket:
//   GIT_http_push.command_body(old, new, refname, pack) -> bytes          Part 2
//   GIT_http_push.parse_report(body, refname)           -> Result<Report, Error>  Part 3
//   GIT_http_push.is_ancestor(gitdir, old, new)         -> bool
//
// --- the exchange ----------------------------------------------------------
//
// `GET <url>/info/refs?service=git-receive-pack` is the same advertisement
// `GIT_http_fetch.discover` reads for `upload-pack`, under a different content
// type and with receive-pack's own capabilities on the first line
// (`report-status`, `delete-refs`, `side-band-64k`, `atomic`, ...). An
// empty repository advertises exactly one line, the all-zero id against the
// pseudo-ref `capabilities^{}`, which `GIT_http_fetch.parse_advertisement`
// already drops.
//
// `POST <url>/git-receive-pack` carries one pkt-line per ref update --
// `<old-id> <new-id> <refname>`, the first with a NUL and the capabilities
// this client wants after it -- then a flush, then the packfile, raw (not
// pkt-line framed). This client sends exactly one update per push, asks for
// `report-status` only, and never `side-band-64k`: without it the server's
// answer is plain pkt-lines, `unpack ok` (or `unpack <why>`) then `ok
// <ref>` or `ng <ref> <why>`, which is all a single update needs to hear.
// (`httpfetch` *requires* side-band because a fetch's pack rides on it; a
// push's pack goes the other way, and its report is tiny.)
//
// --- the fast-forward rule is the client's, and it is checked first --------
//
// A receive-pack whose `receive.denyNonFastForwards` is unset -- every
// personal bare repository -- would accept a push that throws away the
// remote's commits. Real git refuses that on the client ("Updates were
// rejected because the tip of your current branch is behind") unless
// `--force` is given, and so does this: before a byte is sent, the remote's
// current id for the ref must be an ancestor of what is being pushed
// (`is_ancestor`), or `NonFastForward`; a remote id this repository has
// never heard of at all is `Behind` (fetch first). There is no force push.
//
// --- authentication ----------------------------------------------------------
//
// HTTP Basic, from `http://user:password@host/...` userinfo (stripped from
// the URL before `lib/http.m31` sees it -- that module refuses userinfo on
// principle, and is right to; the secret belongs in a header) or, when the
// URL carries none, from `GITUI_HTTP_USER`/`GITUI_HTTP_PASSWORD`. The
// password is never written to any message, log or error this module
// produces; `Remote.url` is the credential-free form for exactly that
// reason. `lib/http.m31` has no TLS, so this only ever speaks to an
// `http://` server -- a self-hosted or LAN one. Pushing to github.com (HTTPS
// only) waits on TLS in the standard library, not on anything here.

import base64;
import http;
import GIT_http_fetch;
import GIT_object;
import os;
import GIT_pack_write;

/// Why a push did not happen, or was refused. Payload-free
/// (`docs/errors-decision.md` §4).
pub enum Error {
    /// The HTTP exchange itself failed (`lib/http.m31` said why).
    Http;
    /// The server answered, but not `200`.
    Status;
    /// `401`/`403`: the server wants credentials this client did not have,
    /// or refuses push altogether (`http.receivepack` unset on the server).
    Auth;
    /// Not a smart-HTTP receive-pack answer: a dumb file server, or a
    /// server that does not serve this repository.
    NotSmart;
    /// The ref advertisement did not parse.
    BadAdvertisement;
    /// The server does not offer `report-status`, so it could never tell
    /// this client whether the update happened.
    NoReportStatus;
    /// A ref name or object id is not well-formed.
    BadName;
    /// The remote URL is not one this client can use (`https://`, or not a
    /// URL at all).
    BadUrl;
    /// The remote already has exactly this id on this ref.
    UpToDate;
    /// The remote's tip for this ref is not in this repository at all.
    Behind;
    /// The remote's tip is not an ancestor of what would be pushed.
    NonFastForward;
    /// The objects to send could not be collected or packed.
    Pack;
    /// The server's report-status answer did not parse, or did not mention
    /// the ref that was pushed.
    BadReport;
}

pub str Error.to_str() {
    match (this) {
        case Http: {
            return "the HTTP exchange failed";
        }
        case Status: {
            return "the server did not answer 200";
        }
        case Auth: {
            return "the server refused the push (credentials required or wrong, or http.receivepack is not enabled there)";
        }
        case NotSmart: {
            return "the server did not answer as a smart-HTTP git receive-pack service";
        }
        case BadAdvertisement: {
            return "the ref advertisement is not well-formed";
        }
        case NoReportStatus: {
            return "the server does not offer report-status";
        }
        case BadName: {
            return "not a well-formed ref name or object id";
        }
        case BadUrl: {
            return "the remote URL is not usable (only http:// is supported; lib/http has no TLS)";
        }
        case UpToDate: {
            return "everything up to date";
        }
        case Behind: {
            return "the remote has commits this repository does not; fetch first";
        }
        case NonFastForward: {
            return "not a fast-forward: the remote tip is not an ancestor of what would be pushed";
        }
        case Pack: {
            return "the objects to send could not be collected or packed";
        }
        case BadReport: {
            return "the server's report-status answer is not well-formed";
        }
    }
}

pub const str ZERO_ID = "0000000000000000000000000000000000000000";

/// HTTP Basic credentials -- `password` is never placed in a `str` any
/// message is built from; see the module note.
pub type Credentials {
    pub str user;
    pub str password;
}

/// A remote this client can talk to: the URL with any userinfo removed,
/// and the credentials that userinfo (or the environment) supplied.
pub type Remote {
    pub str url;
    pub Option<Credentials> auth;
}

/// Split userinfo out of `url`, falling back to `GITUI_HTTP_USER`/
/// `GITUI_HTTP_PASSWORD` when there is none. Refuses `https://` and anything
/// that is not `http://...` up front, the same way `lib/http.m31` would a
/// moment later -- but here, before a credential has been handled at all.
pub Result<Remote, Error> parse_remote(str url) {
    if (!url.starts_with("http://")) {
        return Result<Remote, Error>.Err(Error.BadUrl);
    }
    str rest = url.substr(7, url.size());
    int end = rest.size();
    match (rest.index_of("/")) {
        case Some(int found): {
            end = found;
        }
        case None: {
        }
    }
    match (rest.index_of("?")) {
        case Some(int found): {
            if (found < end) {
                end = found;
            }
        }
        case None: {
        }
    }
    str authority = rest.substr(0, end);
    str tail = rest.substr(end, rest.size());
    Option<Credentials> auth = Option<Credentials>.None;
    str host = authority;
    match (last_at(authority)) {
        case Some(int at_index): {
            str userinfo = authority.substr(0, at_index);
            host = authority.substr(at_index + 1, authority.size());
            str user = userinfo;
            str password = "";
            match (userinfo.index_of(":")) {
                case Some(int colon): {
                    user = userinfo.substr(0, colon);
                    password = userinfo.substr(colon + 1, userinfo.size());
                }
                case None: {
                }
            }
            user = decode(user)?;
            password = decode(password)?;
            auth = Option<Credentials>.Some(Credentials(user, password));
        }
        case None: {
            match (os.env("GITUI_HTTP_USER")) {
                case Some(str environment_user): {
                    auth = Option<Credentials>.Some(Credentials(environment_user, os.env("GITUI_HTTP_PASSWORD").or("")));
                }
                case None: {
                }
            }
        }
    }
    if (host == "") {
        return Result<Remote, Error>.Err(Error.BadUrl);
    }
    return Result<Remote, Error>.Ok(Remote("http://" + host + tail, auth));
}

// The offset of the last `@` in `s`, so a password containing an
// (unescaped) `@` still splits at the one that ends the userinfo.
Option<int> last_at(str text) {
    int position = text.size() - 1;
    while (position >= 0) {
        if (text.byte_at(position) == '@') {
            return Option<int>.Some(position);
        }
        position = position - 1;
    }
    return Option<int>.None;
}

Result<str, Error> decode(str encoded) {
    match (http.unquote(encoded)) {
        case Ok(str decoded): {
            return Result<str, Error>.Ok(decoded);
        }
        case Err(_): {
            return Result<str, Error>.Err(Error.BadUrl);
        }
    }
}

/// The `Authorization` header value for `r` (`Basic ...`), or `""` when it
/// has no credentials. Handed to `httpfetch` for a pull; never displayed.
pub str auth_header(Remote remote) {
    match (remote.auth) {
        case Some(Credentials credentials): {
            return "Basic " + base64.encode((credentials.user + ":" + credentials.password).to_bytes());
        }
        case None: {
            return "";
        }
    }
}

// `Authorization: Basic ...` on `request`, if the remote has credentials.
void apply_auth(http.Request request, Remote remote) {
    match (remote.auth) {
        case Some(Credentials credentials): {
            request.set("authorization", "Basic " + base64.encode((credentials.user + ":" + credentials.password).to_bytes()));
        }
        case None: {
        }
    }
}

/// `GET <url>/info/refs?service=git-receive-pack`, parsed with
/// `GIT_http_fetch.parse_advertisement` -- the same framing, a different service
/// name and content type.
pub Result<GIT_http_fetch.Advertisement, Error> discover(Remote remote) {
    str target = base_of(remote.url) + "/info/refs?service=git-receive-pack";
    match (http.request("GET", target)) {
        case Ok(http.Request request): {
            request.set("accept", "application/x-git-receive-pack-advertisement");
            apply_auth(request, remote);
            match (http.fetch(request)) {
                case Ok(http.Response response): {
                    if (response.status() == 401 || response.status() == 403) {
                        return Result<GIT_http_fetch.Advertisement, Error>.Err(Error.Auth);
                    }
                    if (response.status() != 200) {
                        return Result<GIT_http_fetch.Advertisement, Error>.Err(Error.Status);
                    }
                    str ctype = response.header("content-type").or("");
                    if (!ctype.starts_with("application/x-git-receive-pack-advertisement")) {
                        return Result<GIT_http_fetch.Advertisement, Error>.Err(Error.NotSmart);
                    }
                    match (GIT_http_fetch.parse_advertisement(response.body())) {
                        case Ok(GIT_http_fetch.Advertisement advertisement): {
                            return Result<GIT_http_fetch.Advertisement, Error>.Ok(advertisement);
                        }
                        case Err(_): {
                            return Result<GIT_http_fetch.Advertisement, Error>.Err(Error.BadAdvertisement);
                        }
                    }
                }
                case Err(_): {
                    return Result<GIT_http_fetch.Advertisement, Error>.Err(Error.Http);
                }
            }
        }
        case Err(_): {
            return Result<GIT_http_fetch.Advertisement, Error>.Err(Error.BadUrl);
        }
    }
}

// --- the request body (Part 2) ------------------------------------------------

/// One ref update and its pack: `<old> <new> <refname>\0report-status
/// agent=...\n` as a pkt-line, a flush, then `pack` raw. Pure, so the exact
/// bytes can be checked without a server.
pub bytes command_body(str old, str new, str refname, bytes pack) {
    bytes out = [];
    bytes line = (old + " " + new + " " + refname).to_bytes();
    line.push(0);
    line.extend("report-status agent=m31-httppush/1\n".to_bytes());
    out.extend(GIT_http_fetch.pkt_line(line));
    out.extend(GIT_http_fetch.FLUSH_PKT);
    out.extend(pack);
    return out;
}

// --- the server's verdict (Part 3) --------------------------------------------

/// What the server said about one update: whether it unpacked what was sent
/// (`is_unpacked`, with `reason` holding its words when it did not), and
/// whether the ref itself was updated (`is_ok`, `reason` otherwise).
pub type Report {
    pub bool is_unpacked;
    pub bool is_ok;
    pub str refname;
    pub str reason;
}

/// `report-status`'s plain pkt-lines: `unpack ok` or `unpack <why>`, then
/// `ok <ref>` or `ng <ref> <why>` per command, then a flush. Pure.
pub Result<Report, Error> parse_report(bytes body, str refname) {
    int offset = 0;
    bool is_unpacked = false;
    str unpack_reason = "";
    bool saw_unpack = false;
    bool saw_ref = false;
    bool is_accepted = false;
    str reason = "";
    while (offset < body.size()) {
        GIT_http_fetch.Packet packet = read(body, offset)?;
        offset = packet.next;
        if (packet.flush) {
            break;
        }
        str line = "";
        match (packet.payload.utf8()) {
            case Some(str text): {
                line = text.trim();
            }
            case None: {
                return Result<Report, Error>.Err(Error.BadReport);
            }
        }
        if (!saw_unpack) {
            if (!line.starts_with("unpack ")) {
                return Result<Report, Error>.Err(Error.BadReport);
            }
            saw_unpack = true;
            str rest = line.substr(7, line.size());
            is_unpacked = rest == "ok";
            if (!is_unpacked) {
                unpack_reason = rest;
            }
            continue;
        }
        if (line.starts_with("ok ")) {
            if (line.substr(3, line.size()) == refname) {
                saw_ref = true;
                is_accepted = true;
            }
        } else if (line.starts_with("ng ")) {
            str rest = line.substr(3, line.size());
            str name = rest;
            str why = "";
            match (rest.index_of(" ")) {
                case Some(int space_index): {
                    name = rest.substr(0, space_index);
                    why = rest.substr(space_index + 1, rest.size());
                }
                case None: {
                }
            }
            if (name == refname) {
                saw_ref = true;
                is_accepted = false;
                reason = why;
            }
        } else {
            return Result<Report, Error>.Err(Error.BadReport);
        }
    }
    if (!saw_unpack) {
        return Result<Report, Error>.Err(Error.BadReport);
    }
    if (!is_unpacked) {
        return Result<Report, Error>.Ok(Report(false, false, refname, unpack_reason));
    }
    if (!saw_ref) {
        return Result<Report, Error>.Err(Error.BadReport);
    }
    return Result<Report, Error>.Ok(Report(true, is_accepted, refname, reason));
}

Result<GIT_http_fetch.Packet, Error> read(bytes body, int offset) {
    match (GIT_http_fetch.read_packet(body, offset)) {
        case Ok(GIT_http_fetch.Packet packet): {
            return Result<GIT_http_fetch.Packet, Error>.Ok(packet);
        }
        case Err(_): {
            return Result<GIT_http_fetch.Packet, Error>.Err(Error.BadReport);
        }
    }
}

// --- the push itself ----------------------------------------------------------

/// Is `anc` reachable from `desc` by following parents? `true` when they
/// are the same commit. A commit that cannot be read ends that line of the
/// walk; `desc` itself unreadable is `false`.
pub bool is_ancestor(str gitdir, str anc, str desc) {
    if (anc == desc) {
        return true;
    }
    Map<str, bool> seen = {};
    List<str> queue = [desc];
    seen.set(desc, true);
    int position = 0;
    while (position < queue.size()) {
        str id = queue[position];
        position = position + 1;
        match (GIT_object.read(gitdir, id)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        for (str parent in commit.parents) {
                            if (parent == anc) {
                                return true;
                            }
                            if (!seen.contains(parent)) {
                                seen.set(parent, true);
                                queue.push(parent);
                            }
                        }
                    }
                    case Blob: {
                    }
                    case Tree: {
                    }
                    case Tag: {
                    }
                }
            }
            case Err: {
            }
        }
    }
    return false;
}

/// Push `new_id` to `refname` on `r`: discover, check the fast-forward
/// rule, collect and pack what the remote lacks, send, and return the
/// server's verdict. `Ok(report)` with `report.is_ok == false` is a push the
/// server itself refused (its `reason` says why); every `Err` is a push
/// that never reached the server, or an answer this client could not read.
pub Result<Report, Error> push(str gitdir, Remote remote, str refname, str new_id) {
    if (!GIT_object.is_name(new_id) || new_id.size() != 40 || !refname.starts_with("refs/")) {
        return Result<Report, Error>.Err(Error.BadName);
    }
    GIT_http_fetch.Advertisement advertisement = discover(remote)?;
    if (!has_cap(advertisement.capabilities, "report-status")) {
        return Result<Report, Error>.Err(Error.NoReportStatus);
    }
    str old = ZERO_ID;
    List<str> known = [];
    Map<str, bool> seen = {};
    for (GIT_http_fetch.RemoteRef remote_ref in advertisement.refs) {
        if (remote_ref.name == refname) {
            old = remote_ref.id;
        }
        if (!seen.contains(remote_ref.id)) {
            seen.set(remote_ref.id, true);
            known.push(remote_ref.id);
        }
    }
    if (old == new_id) {
        return Result<Report, Error>.Err(Error.UpToDate);
    }
    if (old != ZERO_ID) {
        match (GIT_object.read(gitdir, old)) {
            case Ok(_): {
            }
            case Err(_): {
                return Result<Report, Error>.Err(Error.Behind);
            }
        }
        if (!is_ancestor(gitdir, old, new_id)) {
            return Result<Report, Error>.Err(Error.NonFastForward);
        }
    }
    List<str> ids = [];
    match (GIT_pack_write.objects_to_send(gitdir, [new_id], known)) {
        case Ok(List<str> listed): {
            ids = listed;
        }
        case Err(_): {
            return Result<Report, Error>.Err(Error.Pack);
        }
    }
    bytes pack = [];
    match (GIT_pack_write.build(gitdir, ids)) {
        case Ok(bytes packed): {
            pack = packed;
        }
        case Err(_): {
            return Result<Report, Error>.Err(Error.Pack);
        }
    }
    str target = base_of(remote.url) + "/git-receive-pack";
    match (http.request("POST", target)) {
        case Ok(http.Request request): {
            request.set("content-type", "application/x-git-receive-pack-request");
            request.set("accept", "application/x-git-receive-pack-result");
            apply_auth(request, remote);
            request.set_body(command_body(old, new_id, refname, pack));
            match (http.fetch(request)) {
                case Ok(http.Response response): {
                    if (response.status() == 401 || response.status() == 403) {
                        return Result<Report, Error>.Err(Error.Auth);
                    }
                    if (response.status() != 200) {
                        return Result<Report, Error>.Err(Error.Status);
                    }
                    str ctype = response.header("content-type").or("");
                    if (!ctype.starts_with("application/x-git-receive-pack-result")) {
                        return Result<Report, Error>.Err(Error.NotSmart);
                    }
                    return parse_report(response.body(), refname);
                }
                case Err(_): {
                    return Result<Report, Error>.Err(Error.Http);
                }
            }
        }
        case Err(_): {
            return Result<Report, Error>.Err(Error.BadUrl);
        }
    }
}

bool has_cap(List<str> caps, str name) {
    for (str capability in caps) {
        if (capability == name || capability.starts_with(name + "=")) {
            return true;
        }
    }
    return false;
}

str base_of(str url) {
    if (url.ends_with("/")) {
        return url.substr(0, url.size() - 1);
    }
    return url;
}
