// Drives `GIT_http_push.m31` (and `GIT_config.m31`) for `test_push.sh`, against a
// real `git http-backend` for the exchange itself and against hand-built
// bytes for the parts that need no server.
//
//   ./t_push objects <gitdir> <tip> [<known> ...]
//       `GIT_pack_write.objects_to_send`, one id per line, sorted -- the same set
//       `git rev-list --objects <tip> ^<known>...` names, for diffing.
//
//   ./t_push push <gitdir> <url> <refname>
//       Pushes `<refname>`'s current local value to `<url>`. Prints
//       "ok <refname>" when the server updated the ref, "ng <refname>
//       <reason>" when the server refused it (exit 1), or "error: <message>"
//       on standard error (exit 1) when the push never happened -- a
//       non-fast-forward is one of those: refused here, nothing sent.
//
//   ./t_push origin <gitdir>
//       `remote.origin.url` from `.git/config`, or "none".
//
//   ./t_push remote <url>
//       `GIT_http_push.parse_remote`: prints "url <credential-free url>" and
//       "user <name>" or "user -". The password is never printed.
//
//   ./t_push report <file> <refname>
//       `GIT_http_push.parse_report` over the file's bytes: prints
//       "unpacked <bool> ok <bool> reason <text>".
//
//   ./t_push config <file> <section> <subsection> <key>
//       `GIT_config.find` over the file's text: the value, or "none".
//
//   ./t_push ancestor <gitdir> <anc> <desc>
//       "yes" or "no".

import GIT_config;
import GIT_http_push;
import io;
import os;
import GIT_pack_write;
import GIT_refs;

List<str> argv = os.args();
if (argv.size() < 2) {
    usage();
}
str cmd = argv[1];
if (cmd == "objects" && argv.size() >= 4) {
    do_objects(argv[2], argv[3], argv.slice(4, argv.size()));
} else if (cmd == "push" && argv.size() == 5) {
    do_push(argv[2], argv[3], argv[4]);
} else if (cmd == "origin" && argv.size() == 3) {
    do_origin(argv[2]);
} else if (cmd == "remote" && argv.size() == 3) {
    do_remote(argv[2]);
} else if (cmd == "report" && argv.size() == 4) {
    do_report(argv[2], argv[3]);
} else if (cmd == "config" && argv.size() == 6) {
    do_config(argv[2], argv[3], argv[4], argv[5]);
} else if (cmd == "ancestor" && argv.size() == 5) {
    do_ancestor(argv[2], argv[3], argv[4]);
} else {
    usage();
}

void usage() {
    io.eprint("usage: t_push objects <gitdir> <tip> [<known> ...]");
    io.eprint("       t_push push <gitdir> <url> <refname>");
    io.eprint("       t_push origin <gitdir>");
    io.eprint("       t_push remote <url>");
    io.eprint("       t_push report <file> <refname>");
    io.eprint("       t_push config <file> <section> <subsection> <key>");
    io.eprint("       t_push ancestor <gitdir> <anc> <desc>");
    os.exit(2);
}

void fail(str message) {
    io.eprint("error: " + message);
    os.exit(1);
}

void do_objects(str gitdir, str tip, List<str> known) {
    match (GIT_pack_write.objects_to_send(gitdir, [tip], known)) {
        case Ok(List<str> ids): {
            List<str> sorted = clone(ids);
            sorted.sort();
            for (str id in sorted) {
                print(id);
            }
        }
        case Err(GIT_pack_write.Error error): {
            fail(error.to_str());
        }
    }
}

void do_push(str gitdir, str url, str refname) {
    str id = "";
    match (GIT_refs.resolve(gitdir, refname)) {
        case Ok(str resolved_id): {
            id = resolved_id;
        }
        case Err(GIT_refs.Error error): {
            fail("resolve " + refname + ": " + error.to_str());
        }
    }
    GIT_http_push.Remote remote = GIT_http_push.Remote("", Option<GIT_http_push.Credentials>.None);
    match (GIT_http_push.parse_remote(url)) {
        case Ok(GIT_http_push.Remote parsed): {
            remote = parsed;
        }
        case Err(GIT_http_push.Error error): {
            fail(error.to_str());
        }
    }
    match (GIT_http_push.push(gitdir, remote, refname, id)) {
        case Ok(GIT_http_push.Report report): {
            if (report.is_ok) {
                print("ok " + report.refname);
            } else {
                print("ng " + report.refname + " " + report.reason);
                os.exit(1);
            }
        }
        case Err(GIT_http_push.Error error): {
            fail(error.to_str());
        }
    }
}

void do_origin(str gitdir) {
    print(GIT_config.get(gitdir, "remote", "origin", "url").or("none"));
}

void do_remote(str url) {
    match (GIT_http_push.parse_remote(url)) {
        case Ok(GIT_http_push.Remote remote): {
            print("url " + remote.url);
            match (remote.auth) {
                case Some(GIT_http_push.Credentials credentials): {
                    print("user " + credentials.user);
                }
                case None: {
                    print("user -");
                }
            }
        }
        case Err(GIT_http_push.Error error): {
            fail(error.to_str());
        }
    }
}

void do_report(str path, str refname) {
    match (io.read_bytes(path)) {
        case Ok(bytes body): {
            match (GIT_http_push.parse_report(body, refname)) {
                case Ok(GIT_http_push.Report report): {
                    print("unpacked " + bool_text(report.is_unpacked) + " ok " + bool_text(report.is_ok) + " reason " + report.reason);
                }
                case Err(GIT_http_push.Error error): {
                    fail(error.to_str());
                }
            }
        }
        case Err(io.Error error): {
            fail("cannot read " + path + ": " + error.to_str());
        }
    }
}

void do_config(str path, str section, str subsection, str key) {
    match (io.read(path)) {
        case Ok(str text): {
            print(GIT_config.find(text, section, subsection, key).or("none"));
        }
        case Err(io.Error error): {
            fail("cannot read " + path + ": " + error.to_str());
        }
    }
}

void do_ancestor(str gitdir, str anc, str desc) {
    if (GIT_http_push.is_ancestor(gitdir, anc, desc)) {
        print("yes");
    } else {
        print("no");
    }
}

str bool_text(bool is_true) {
    if (is_true) {
        return "true";
    }
    return "false";
}
