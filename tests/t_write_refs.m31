// Exercises `GIT_refs.update` and `GIT_refs.update_symbolic` against the repository
// named on the command line, given two already-existing commit names, and
// prints one canonical line per check for `test_write.sh` to compare against
// real `git`.
//
//   ./t_write_refs <gitdir> <commit-a> <commit-b>
//
// `commit-a` and `commit-b` must both already exist in the repository -- the
// program only writes refs, never objects.

import GIT_hash;
import GIT_refs;
import io;
import os;

List<str> argv = os.args();
if (argv.size() < 4) {
    io.eprint("usage: t_write_refs <gitdir> <commit-a> <commit-b>");
    os.exit(2);
}
str git_directory = argv[1];
str first_id = argv[2];
str second_id = argv[3];
// A plain, unconditional write of a new branch.
match (GIT_refs.update(git_directory, "refs/heads/newbranch", first_id, Option<str>.None)) {
    case Ok: {
        print("update-plain ok");
    }
    case Err(GIT_refs.Error error): {
        print("update-plain err " + error.to_str());
    }
}
// A symbolic HEAD, pointed at that branch.
match (GIT_refs.update_symbolic(git_directory, "HEAD", "refs/heads/newbranch")) {
    case Ok: {
        print("symbolic-head ok");
    }
    case Err(GIT_refs.Error error): {
        print("symbolic-head err " + error.to_str());
    }
}
// A compare-and-swap against the WRONG current value must fail, and leave
// the branch exactly where it was.
match (GIT_refs.update(git_directory, "refs/heads/newbranch", second_id, Option<str>.Some(GIT_hash.zero(GIT_hash.raw_len(git_directory))))) {
    case Ok: {
        print("cas-wrong ok (should have been a Mismatch)");
    }
    case Err(GIT_refs.Error error): {
        print("cas-wrong err " + error.to_str());
    }
}
// A compare-and-swap against the RIGHT current value must succeed.
match (GIT_refs.update(git_directory, "refs/heads/newbranch", second_id, Option<str>.Some(first_id))) {
    case Ok: {
        print("cas-right ok");
    }
    case Err(GIT_refs.Error error): {
        print("cas-right err " + error.to_str());
    }
}
// A detached HEAD, direct.
match (GIT_refs.update(git_directory, "HEAD", first_id, Option<str>.None)) {
    case Ok: {
        print("detached-head ok");
    }
    case Err(GIT_refs.Error error): {
        print("detached-head err " + error.to_str());
    }
}
// A compare-and-swap creating a brand new branch -- `expect_old` is `""`
// because there is nothing there yet.
match (GIT_refs.update(git_directory, "refs/heads/fresh", first_id, Option<str>.Some(""))) {
    case Ok: {
        print("cas-create ok");
    }
    case Err(GIT_refs.Error error): {
        print("cas-create err " + error.to_str());
    }
}
