// Drives `GIT_pull.m31` and `GIT_pack.read_pack` for `test_pull.sh`.
//
//   ./t_pull pull <gitdir> <worktree> <url>
//       `GIT_pull.pull` against `<url>` (credentials, if any, from its userinfo
//       or the environment). Prints "pulled <old> <new> <objects>" or "up to
//       date <id>"; on any refusal prints "error: <message>" to standard
//       error and exits 1.
//
//   ./t_pull unpack <gitdir> <pack>
//       Every object `GIT_pack.read_pack` finds in `<pack>` written loose into
//       `<gitdir>`; prints "<count>" -- real git then judges the result.

import GIT_http_push;
import io;
import GIT_object;
import os;
import GIT_pack;
import GIT_pull;

List<str> argv = os.args();
if (argv.size() == 5 && argv[1] == "pull") {
    do_pull(argv[2], argv[3], argv[4]);
} else if (argv.size() == 4 && argv[1] == "unpack") {
    do_unpack(argv[2], argv[3]);
} else {
    io.eprint("usage: t_pull pull <gitdir> <worktree> <url>");
    io.eprint("       t_pull unpack <gitdir> <pack>");
    os.exit(2);
}

void fail(str message) {
    io.eprint("error: " + message);
    os.exit(1);
}

void do_pull(str gitdir, str worktree, str url) {
    GIT_http_push.Remote remote = GIT_http_push.Remote("", Option<GIT_http_push.Credentials>.None);
    match (GIT_http_push.parse_remote(url)) {
        case Ok(GIT_http_push.Remote parsed): {
            remote = parsed;
        }
        case Err(GIT_http_push.Error error): {
            fail(error.to_str());
        }
    }
    match (GIT_pull.pull(gitdir, worktree, remote)) {
        case Ok(GIT_pull.Outcome outcome): {
            if (outcome.has_moved) {
                print("pulled " + outcome.old_id + " " + outcome.new_id + " " + outcome.objects.to_str());
            } else {
                print("up to date " + outcome.old_id);
            }
        }
        case Err(GIT_pull.Error error): {
            fail(error.to_str());
        }
    }
}

void do_unpack(str gitdir, str path) {
    bytes raw = [];
    match (io.read_bytes(path)) {
        case Ok(bytes contents): {
            raw = contents;
        }
        case Err(io.Error error): {
            fail("cannot read " + path + ": " + error.to_str());
        }
    }
    match (GIT_pack.read_pack(gitdir, raw)) {
        case Ok(List<GIT_pack.Unpacked> objs): {
            for (GIT_pack.Unpacked unpacked in objs) {
                match (GIT_object.write(gitdir, unpacked.kind, unpacked.content)) {
                    case Ok(str id): {
                        if (id != unpacked.id) {
                            fail("object name mismatch: " + id + " vs " + unpacked.id);
                        }
                    }
                    case Err(GIT_object.Error error): {
                        fail("write: " + error.to_str());
                    }
                }
            }
            print(objs.size().to_str());
        }
        case Err(GIT_pack.Error error): {
            fail(error.to_str());
        }
    }
}
