// Drives `GIT_graph.m31` so `test_graph.sh` can compare it with git on a
// generated history.
//
//   ./t_graph <gitdir> pairs <file>      per line `a b`: print
//        `a b | <merge bases, space separated, sorted> | <ahead> <behind> | <a anc b> <b anc a>`
//   ./t_graph <gitdir> revlist <file>    per line of ids, `^id` excluding: print the
//        resulting ids on one line in order, after `include... ^exclude... =>`
//   ./t_graph <gitdir> count <id>        the number of commits reachable from <id>

import GIT_graph;
import io;
import os;

List<str> argv = os.args();
if (argv.size() < 4) {
    io.eprint("usage: t_graph <gitdir> pairs|revlist <file> | count <id>");
    os.exit(2);
}
str gitdir = argv[1];
str operation = argv[2];
GIT_graph.Graph graph = GIT_graph.open(gitdir);

void fail(GIT_graph.Error error) {
    print("refused: " + error.to_str());
    os.exit(1);
}

str flag(bool value) {
    if (value) {
        return "1";
    }
    return "0";
}

if (operation == "count") {
    match (graph.ancestors(argv[3])) {
        case Ok(Map<str, bool> all): {
            print(all.size().to_str());
        }
        case Err(GIT_graph.Error error): {
            fail(error);
        }
    }
    os.exit(0);
}
str body = "";
match (io.read(argv[3])) {
    case Ok(str text): {
        body = text;
    }
    case Err(_): {
        io.eprint("cannot read " + argv[3]);
        os.exit(2);
    }
}
for (str line in body.split("\n")) {
    if (line.trim() == "") {
        continue;
    }
    List<str> words = line.trim().split(" ");
    if (operation == "pairs") {
        str a = words[0];
        str b = words[1];
        List<str> bases = [];
        match (graph.merge_bases(a, b)) {
            case Ok(List<str> found): {
                bases = found;
            }
            case Err(GIT_graph.Error error): {
                fail(error);
            }
        }
        bases.sort();
        GIT_graph.AheadBehind counts = GIT_graph.AheadBehind(0, 0);
        match (graph.ahead_behind(a, b)) {
            case Ok(GIT_graph.AheadBehind found): {
                counts = found;
            }
            case Err(GIT_graph.Error error): {
                fail(error);
            }
        }
        bool a_in_b = false;
        bool b_in_a = false;
        match (graph.is_ancestor(a, b)) {
            case Ok(bool found): {
                a_in_b = found;
            }
            case Err(GIT_graph.Error error): {
                fail(error);
            }
        }
        match (graph.is_ancestor(b, a)) {
            case Ok(bool found): {
                b_in_a = found;
            }
            case Err(GIT_graph.Error error): {
                fail(error);
            }
        }
        print(a + " " + b + " | " + bases.join(" ") + " | " + counts.ahead.to_str() + " " + counts.behind.to_str() + " | " + flag(a_in_b) + " " + flag(b_in_a));
    } else {
        List<str> include = [];
        List<str> exclude = [];
        for (str word in words) {
            if (word.starts_with("^")) {
                exclude.push(word.substr(1, word.size()));
            } else {
                include.push(word);
            }
        }
        match (graph.rev_list(include, exclude)) {
            case Ok(List<str> ids): {
                print(line.trim() + " => " + ids.join(" "));
            }
            case Err(GIT_graph.Error error): {
                fail(error);
            }
        }
    }
}
