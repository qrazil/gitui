// `GIT_hunks.hunks`, printed the way `diff -u`'s own body prints -- a leading
// ` `/`+`/`-` and the line, `@@ ... @@` before each group -- so `test.sh` can
// diff this output directly against a real `diff -u`'s (with its `---`/`+++`
// file-header lines stripped) as an oracle for hunk boundaries and line
// classification. Not part of `gitui`'s command surface: a throwaway
// harness for `GIT_hunks.m31`'s own tests, the same role `t_object.m31` and
// friends play for the rest of this program.
//
//   t_hunks <old-file> <new-file>

import os;
import io;
import GIT_hunks;
import tui.TUI_diff_view;

List<str> argv = os.arguments();
if (argv.size() != 3) {
    print("usage: t_hunks <old-file> <new-file>");
    os.exit(1);
}
bytes old = read(argv[1]);
bytes new = read(argv[2]);
match (GIT_hunks.hunks(old, new)) {
    case Binary: {
        print("Binary files differ");
    }
    case Hunks(List<TUI_diff_view.Hunk> hunks): {
        for (TUI_diff_view.Hunk hunk in hunks) {
            print(hunk.header);
            for (TUI_diff_view.Line line in hunk.lines) {
                print(marker(line.kind) + line.text);
            }
        }
    }
}

bytes read(str path) {
    match (io.read_bytes(path)) {
        case Ok(bytes contents): {
            return contents;
        }
        case Err(io.Error error): {
            print("cannot read " + path + ": " + error.to_str());
            os.exit(1);
            return [];
        }
    }
}

str marker(TUI_diff_view.Kind kind) {
    match (kind) {
        case Context: {
            return " ";
        }
        case Add: {
            return "+";
        }
        case Remove: {
            return "-";
        }
    }
}
