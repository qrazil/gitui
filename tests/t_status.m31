// Runs `GIT_status.status` on the repository named on the command line and
// prints it in `git status --short`'s own shape -- `XY path`, one combined,
// path-sorted list, `??` for untracked -- so `test_write.sh` can diff this
// program's output against that command's, unmodified.
//
//   ./t_status <gitdir> <worktree>

import GIT_status;
import io;
import os;

List<str> argv = os.args();
if (argv.size() < 3) {
    io.eprint("usage: t_status <gitdir> <worktree>");
    os.exit(2);
}
str git_directory = argv[1];
str worktree = argv[2];
match (GIT_status.status(git_directory, worktree)) {
    case Ok(GIT_status.Status status): {
        show(status);
    }
    case Err(GIT_status.Error error): {
        io.eprint(error.to_str());
        os.exit(1);
    }
}

void show(GIT_status.Status status) {
    Map<str, int> staged_counts = {};
    Map<str, int> unstaged_counts = {};
    Map<str, bool> untr = {};
    for (GIT_status.Delta delta in status.staged) {
        staged_counts.set(delta.path.utf8().or("<non-utf8>"), staged_char(delta.kind));
    }
    for (GIT_status.Delta delta in status.unstaged) {
        unstaged_counts.set(delta.path.utf8().or("<non-utf8>"), unstaged_char(delta.kind));
    }
    for (bytes path in status.untracked) {
        untr.set(path.utf8().or("<non-utf8>"), true);
    }
    // `git status --short` prints two separate blocks, each sorted on its
    // own -- every tracked change (staged, unstaged, or both), then every
    // untracked path -- not one merge across both. Matching that grouping
    // here is purely about matching that command's output for the test to
    // diff against; `GIT_status.Status` itself keeps the three lists apart for
    // exactly the reason its module header gives, and a caller with a
    // different presentation in mind is free to merge them however it likes.
    List<str> tracked = [];
    for (str path_text in staged_counts.keys()) {
        tracked.push(path_text);
    }
    for (str path_text in unstaged_counts.keys()) {
        if (!staged_counts.contains(path_text)) {
            tracked.push(path_text);
        }
    }
    tracked.sort();
    for (str path_text in tracked) {
        bytes code = [staged_counts.get(path_text).or(32), unstaged_counts.get(path_text).or(32)];
        print(code.utf8().or("??") + " " + path_text);
    }
    List<str> untracked = [];
    for (str path_text in untr.keys()) {
        untracked.push(path_text);
    }
    untracked.sort();
    for (str path_text in untracked) {
        print("?? " + path_text);
    }
}

int staged_char(GIT_status.Change change) {
    match (change) {
        case Added: {
            return 'A';
        }
        case Modified: {
            return 'M';
        }
        case Deleted: {
            return 'D';
        }
    }
}

int unstaged_char(GIT_status.Change change) {
    match (change) {
        case Added: {
            return 'A';
        }
        case Modified: {
            return 'M';
        }
        case Deleted: {
            return 'D';
        }
    }
}
