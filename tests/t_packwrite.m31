// Drives `GIT_pack_write.m31` for `test_push.sh`.
//
//   ./t_packwrite build <gitdir> <out.pack> [<id> ...]
//       A pack of exactly the ids given -- every object in the repository
//       (`GIT_object.all`) if none are -- written to `out.pack`. Prints
//       "pack <bytes> <count>". Real `git index-pack --strict` is what then
//       judges the bytes.
//
//   ./t_packwrite header <type-num> <size>
//       The varint entry header for that type and size, as hex -- checked
//       against the values the format's own definition gives.
//
//   ./t_packwrite stat <gitdir> <id>
//       "<kind> <size>" for one object, read through `GIT_object.read` -- which,
//       once `index-pack` has built the `.idx`, means through `GIT_pack.m31`'s
//       own reader: the round trip "wrote it, git indexed it, this program
//       reads it back and the SHA-1 still checks" in one call.
//
// Every command prints "error: <message>" to standard error and exits 1 on
// failure.

import io;
import GIT_object;
import os;
import GIT_pack_write;

List<str> argv = os.args();
if (argv.size() < 2) {
    usage();
}
str cmd = argv[1];
if (cmd == "build" && argv.size() >= 4) {
    do_build(argv[2], argv[3], argv.slice(4, argv.size()));
} else if (cmd == "header" && argv.size() == 4) {
    do_header(argv[2], argv[3]);
} else if (cmd == "stat" && argv.size() == 4) {
    do_stat(argv[2], argv[3]);
} else {
    usage();
}

void usage() {
    io.eprint("usage: t_packwrite build <gitdir> <out.pack> [<id> ...]");
    io.eprint("       t_packwrite header <type-num> <size>");
    io.eprint("       t_packwrite stat <gitdir> <id>");
    os.exit(2);
}

void fail(str message) {
    io.eprint("error: " + message);
    os.exit(1);
}

void do_build(str gitdir, str out_path, List<str> ids) {
    List<str> want = ids;
    if (want.size() == 0) {
        match (GIT_object.all(gitdir)) {
            case Ok(List<str> all): {
                want = all;
            }
            case Err(GIT_object.Error error): {
                fail("object.all: " + error.to_str());
            }
        }
    }
    match (GIT_pack_write.build(gitdir, want)) {
        case Ok(bytes pack): {
            match (io.write_bytes(out_path, pack)) {
                case Ok: {
                    print("pack " + pack.size().to_str() + " " + want.size().to_str());
                }
                case Err(io.Error error): {
                    fail("write: " + error.to_str());
                }
            }
        }
        case Err(GIT_pack_write.Error error): {
            fail(error.to_str());
        }
    }
}

void do_header(str type_text, str size_text) {
    int type_code = type_text.parse_int().or(-1);
    int size = size_text.parse_int().or(-1);
    if (type_code < 0 || size < 0) {
        fail("type and size must be non-negative integers");
    }
    print(GIT_pack_write.entry_header(type_code, size).hex());
}

void do_stat(str gitdir, str id) {
    match (GIT_object.read(gitdir, id)) {
        case Ok(GIT_object.Object object): {
            print(object.kind() + " " + object.raw.size().to_str());
        }
        case Err(GIT_object.Error error): {
            fail(error.to_str());
        }
    }
}
