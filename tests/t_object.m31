// Every object in a repository -- loose or packed -- read and printed
// canonically, for `oracle_object.py` to be diffed against.
//
//   bash scripts/build.sh tests/t_object.m31 -o t_object && ./t_object <repo>
//
// This is the end-to-end check: it runs `GIT_object.read` (loose, then
// `GIT_pack.m31`, exactly as every other reader in this program does) over every
// object `GIT_object.all` names, which checks each one's SHA-1 against the name
// it is filed under -- reconstructed through a delta chain first, when it is
// packed -- and prints its parse in a form that has no text decoding in it --
// a path, a name, an email and a message are hex or a digest, never
// characters. So a disagreement is a disagreement about the format and not
// about UTF-8. `GIT_object.all` rather than `GIT_object.loose` is what makes this the
// same check on a packed repository as on a loose one: on an all-loose
// fixture (everything `tests/test.sh` built before packfiles existed
// here) the two name exactly the same ids, so nothing about this file's
// output changes for them.

import GIT_object;
import io;
import os;
import fs;
import crypto.sha1digest;
import date;

List<str> argv = os.arguments();
if (argv.size() < 2) {
    io.eprint("usage: t_object <repo-or-gitdir>");
    os.exit(2);
}
str git_directory = gitdir(argv[1]);
List<str> names = [];
match (GIT_object.all(git_directory)) {
    case Ok(List<str> ids): {
        names = ids;
    }
    case Err(GIT_object.Error error): {
        io.eprint(error.to_str());
        os.exit(2);
    }
}
int start_nanoseconds = date.now_ns();
int total = 0;
for (str id in names) {
    match (GIT_object.read(git_directory, id)) {
        case Ok(GIT_object.Object object): {
            total = total + object.raw.size();
            show(object);
        }
        case Err(GIT_object.Error error): {
            print(id + " ERROR " + error.to_str());
        }
    }
}
int elapsed_nanoseconds = date.now_ns() - start_nanoseconds;
if (elapsed_nanoseconds > 0) {
    io.eprint("objects: " + names.size().to_str() + " objects, " + total.to_str() + " octets of content in " + (elapsed_nanoseconds / 1_000_000).to_str() + " ms = " + (total * 1_000 / elapsed_nanoseconds).to_str() + " MB/s");
}

void show(GIT_object.Object object) {
    str id = object.id;
    match (object.body) {
        case Blob: {
            print(id + " blob " + object.raw.size().to_str() + " " + sha1digest.hex(object.raw));
        }
        case Tree(List<GIT_object.Entry> entries): {
            print(id + " tree " + object.raw.size().to_str() + " " + entries.size().to_str());
            for (int i in 0 .. entries.size()) {
                print(id + " tree-entry " + i.to_str() + " " + entries[i].mode_text() + " " + entries[i].id + " " + hex_or_dash(entries[i].name));
            }
        }
        case Commit(GIT_object.Commit commit): {
            print(id + " commit " + object.raw.size().to_str() + " tree=" + commit.tree + " parents=" + joined(commit.parents) + " author=" + ident(commit.author) + " committer=" + ident(commit.committer) + " extra=" + commit.extra.size().to_str() + "/" + sha1digest.hex(commit.extra.join(newline_bytes())) + " msg=" + commit.message.size().to_str() + "/" + sha1digest.hex(commit.message));
        }
        case Tag(GIT_object.Tag tag): {
            str tagger = "-";
            match (tag.tagger) {
                case Some(GIT_object.Ident who): {
                    tagger = ident(who);
                }
                case None: {
                }
            }
            print(id + " tag " + object.raw.size().to_str() + " object=" + tag.object + " type=" + tag.kind + " name=" + hex_or_dash(tag.name) + " tagger=" + tagger + " extra=" + tag.extra.size().to_str() + "/" + sha1digest.hex(tag.extra.join(newline_bytes())) + " msg=" + tag.message.size().to_str() + "/" + sha1digest.hex(tag.message));
        }
    }
}

str ident(GIT_object.Ident who) {
    return hex_or_dash(who.name) + "|" + hex_or_dash(who.email) + "|" + who.when.to_str() + "|" + who.zone + "|" + who.offset.to_str();
}

// Hex, or `-` for nothing at all: an empty field and a field of no octets
// print the same in hex, and the two are told apart in the Python twin the
// same way.
str hex_or_dash(bytes data) {
    if (data.size() == 0) {
        return "-";
    }
    return data.hex();
}

str joined(List<str> items) {
    if (items.size() == 0) {
        return "-";
    }
    return items.join(",");
}

// A one-octet `bytes` holding a newline. There is no `bytes` literal
// (reference §3.10), and `join` on a `List<bytes>` takes a `bytes`, so the
// separator has to be built -- and built here rather than at each call,
// because a literal of a mutable type allocates every time it is evaluated.
bytes newline_bytes() {
    return "\n".to_bytes();
}

// A repository directory, or the git directory itself.
//
// Deliberately the naive version, and NOT `GIT_repository.find`: a `.git` file, a
// linked worktree's `commondir` and the walk up to a parent are all
// `GIT_repository.m31`'s job, and this program is the one that has to notice if
// `GIT_repository.m31` gets them wrong. `test.sh` hands it the common git directory
// that `git rev-parse --git-common-dir` printed, so the two sides of the
// comparison agree about which store is being read without either of them
// deciding it.
str gitdir(str path) {
    str inner = fs.join(path, ".git");
    if (fs.is_directory(inner)) {
        return inner;
    }
    return path;
}
