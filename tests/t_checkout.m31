// Drives `GIT_checkout.m31` directly -- no terminal, no `TUI_app.Loop` -- against
// a real, disposable fixture, so `test_checkout.sh` can check each switch's
// on-disk effect against real git the same way `t_gitclient_ops.m31` does
// for staging and committing.
//
//   ./t_checkout <gitdir> <worktree> branches
//   ./t_checkout <gitdir> <worktree> checkout <branch>
//   ./t_checkout <gitdir> <worktree> detach <commit-id>
//   ./t_checkout <gitdir> <worktree> new <branch>
//
// `branches` prints one `<mark> <name> <id>` line per local branch, `*` for
// the current one and `-` otherwise. `checkout`/`detach`/`new` print
// `ok written=N removed=M` (or just `ok`) and exit 0, or `refused: <why>`
// and exit 1 -- the shell test checks both the word and the repository.

import GIT_checkout;
import io;
import os;

List<str> argv = os.args();
if (argv.size() < 4) {
    io.eprint("usage: t_checkout <gitdir> <worktree> branches|checkout <branch>|detach <id>|new <branch>");
    os.exit(2);
}
str git_directory = argv[1];
str worktree = argv[2];
str operation = argv[3];
if (operation == "branches") {
    match (GIT_checkout.branches(git_directory)) {
        case Ok(List<GIT_checkout.Branch> branches): {
            for (GIT_checkout.Branch branch in branches) {
                str mark = "-";
                if (branch.is_current) {
                    mark = "*";
                }
                print(mark + " " + branch.name + " " + branch.id);
            }
        }
        case Err(GIT_checkout.Error error): {
            io.eprint(error.to_str());
            os.exit(1);
        }
    }
} else if (operation == "checkout") {
    if (argv.size() < 5) {
        io.eprint("usage: t_checkout <gitdir> <worktree> checkout <branch>");
        os.exit(2);
    }
    str want = argv[4];
    str id = "";
    str full = "";
    match (GIT_checkout.branches(git_directory)) {
        case Ok(List<GIT_checkout.Branch> branches): {
            for (GIT_checkout.Branch branch in branches) {
                if (branch.name == want) {
                    id = branch.id;
                    full = branch.full;
                }
            }
        }
        case Err(GIT_checkout.Error error): {
            io.eprint(error.to_str());
            os.exit(1);
        }
    }
    if (id == "") {
        io.eprint("no such branch: " + want);
        os.exit(2);
    }
    report(GIT_checkout.checkout(git_directory, worktree, id, full));
} else if (operation == "detach") {
    if (argv.size() < 5) {
        io.eprint("usage: t_checkout <gitdir> <worktree> detach <commit-id>");
        os.exit(2);
    }
    report(GIT_checkout.checkout(git_directory, worktree, argv[4], ""));
} else if (operation == "new") {
    if (argv.size() < 5) {
        io.eprint("usage: t_checkout <gitdir> <worktree> new <branch>");
        os.exit(2);
    }
    match (GIT_checkout.create_branch(git_directory, argv[4])) {
        case Ok: {
            print("ok");
        }
        case Err(GIT_checkout.Error error): {
            print("refused: " + error.to_str());
            os.exit(1);
        }
    }
} else {
    io.eprint("unknown op: " + operation);
    os.exit(2);
}

void report(Result<GIT_checkout.Summary, GIT_checkout.Error> result) {
    match (result) {
        case Ok(GIT_checkout.Summary summary): {
            print("ok written=" + summary.written.to_str() + " removed=" + summary.removed.to_str());
        }
        case Err(GIT_checkout.Error error): {
            print("refused: " + error.to_str());
            os.exit(1);
        }
    }
}
