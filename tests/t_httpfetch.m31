// Drives `GIT_http_fetch.m31` against a real smart-HTTP git server for
// `test_httpfetch.sh`, and against hand-built bytes for the cases that do
// not need a server at all (a truncated or corrupted pack).
//
//   ./t_httpfetch ls-remote <url>
//       Prints "<id>\t<name>" per advertised ref, in the server's own order
//       -- the same shape `git ls-remote <url>` prints, so the two can be
//       diffed directly.
//
//   ./t_httpfetch clone <url> <out.pack>
//       Discovers, wants every advertised ref (deduplicated), sends no
//       `have`s, and writes the verified pack to `out.pack`. Prints
//       "caps <c1> <c2> ..." and "pack <bytes> <objects>".
//
//   ./t_httpfetch fetch <url> <gitdir> <out.pack>
//       As `clone`, but `have`s are every commit reachable from every ref in
//       `gitdir` (`GIT_refs.all` + `GIT_log.walk`, exactly as `-log` walks) --
//       the case where negotiation is expected to shrink the pack.
//
//   ./t_httpfetch verify <pack-file> <out-path> [sha1|sha256]
//       Reads `pack-file` as plain bytes (no network, no server -- this is
//       how a truncated or corrupted transfer is tested, per the task's own
//       "simulate this at the test level") and calls `GIT_http_fetch.verify_pack`
//       on them, with the trailer width of the object format named (SHA-1 if none). Prints "ok <bytes> <objects>" or "error: <message>".
//
// Every command prints "error: <message>" to standard error and exits 1 on
// failure; a successful command exits 0.

import GIT_hash;
import GIT_http_fetch;
import GIT_log;
import io;
import os;
import GIT_refs;

List<str> argv = os.arguments();
if (argv.size() < 2) {
    usage();
}
str cmd = argv[1];
if (cmd == "ls-remote" && argv.size() == 3) {
    ls_remote(argv[2]);
} else if (cmd == "clone" && argv.size() == 4) {
    do_clone(argv[2], argv[3]);
} else if (cmd == "fetch" && argv.size() == 5) {
    do_fetch(argv[2], argv[3], argv[4]);
} else if (cmd == "verify" && argv.size() == 4) {
    do_verify(argv[2], argv[3], "sha1");
} else if (cmd == "verify" && argv.size() == 5) {
    do_verify(argv[2], argv[3], argv[4]);
} else {
    usage();
}

void usage() {
    io.eprint("usage: t_httpfetch ls-remote <url>");
    io.eprint("       t_httpfetch clone <url> <out.pack>");
    io.eprint("       t_httpfetch fetch <url> <gitdir> <out.pack>");
    io.eprint("       t_httpfetch verify <pack-file> <out-path> [sha1|sha256]");
    os.exit(2);
}

void fail(str message) {
    io.eprint("error: " + message);
    os.exit(1);
}

void ls_remote(str url) {
    match (GIT_http_fetch.discover(url)) {
        case Ok(GIT_http_fetch.Advertisement advertisement): {
            for (GIT_http_fetch.RemoteRef remote_ref in advertisement.refs) {
                print(remote_ref.id + "\t" + remote_ref.name);
            }
        }
        case Err(GIT_http_fetch.Error error): {
            fail(error.to_str());
        }
    }
}

void do_clone(str url, str out_path) {
    match (GIT_http_fetch.discover(url)) {
        case Ok(GIT_http_fetch.Advertisement advertisement): {
            List<str> wants = unique_ids(advertisement.refs);
            List<str> no_haves = [];
            print("caps " + advertisement.capabilities.join(" "));
            print("refs " + wants.size().to_str());
            run_fetch(url, advertisement, wants, no_haves, out_path);
        }
        case Err(GIT_http_fetch.Error error): {
            fail(error.to_str());
        }
    }
}

void do_fetch(str url, str gitdir, str out_path) {
    match (GIT_http_fetch.discover(url)) {
        case Ok(GIT_http_fetch.Advertisement advertisement): {
            List<str> wants = unique_ids(advertisement.refs);
            List<str> haves = local_haves(gitdir);
            print("caps " + advertisement.capabilities.join(" "));
            print("refs " + wants.size().to_str());
            print("haves " + haves.size().to_str());
            run_fetch(url, advertisement, wants, haves, out_path);
        }
        case Err(GIT_http_fetch.Error error): {
            fail(error.to_str());
        }
    }
}

void run_fetch(str url, GIT_http_fetch.Advertisement advertisement, List<str> wants, List<str> haves, str out_path) {
    match (GIT_http_fetch.fetch(url, advertisement, wants, haves, out_path)) {
        case Ok(GIT_http_fetch.Summary summary): {
            print("pack " + summary.pack_bytes.to_str() + " " + summary.object_count.to_str());
        }
        case Err(GIT_http_fetch.Error error): {
            fail(error.to_str());
        }
    }
}

void do_verify(str pack_path, str out_path, str format_name) {
    int raw = GIT_hash.raw_of_name(format_name);
    if (raw == 0) {
        fail("unknown object format " + format_name);
    }
    match (io.read_bytes(pack_path)) {
        case Ok(bytes data): {
            match (GIT_http_fetch.verify_pack(data, out_path, raw: raw)) {
                case Ok(GIT_http_fetch.Summary summary): {
                    print("ok " + summary.pack_bytes.to_str() + " " + summary.object_count.to_str());
                }
                case Err(GIT_http_fetch.Error error): {
                    fail(error.to_str());
                }
            }
        }
        case Err(io.Error error): {
            fail("cannot read " + pack_path + ": " + error.to_str());
        }
    }
}

List<str> unique_ids(List<GIT_http_fetch.RemoteRef> advertised) {
    Map<str, bool> seen = {};
    List<str> out = [];
    for (GIT_http_fetch.RemoteRef remote_ref in advertised) {
        if (!seen.contains(remote_ref.id)) {
            seen.set(remote_ref.id, true);
            out.push(remote_ref.id);
        }
    }
    return out;
}

// Every commit reachable from every local ref -- what a real `fetch` already
// has, and so must not be asked for again. `GIT_refs.all` + `GIT_log.walk` is
// exactly what `-log` already does for one ref; this does it for all of
// them, matching the module note's own recipe.
List<str> local_haves(str gitdir) {
    Map<str, bool> seen = {};
    List<str> out = [];
    match (GIT_refs.all(gitdir)) {
        case Ok(List<GIT_refs.Ref> all): {
            for (GIT_refs.Ref git_ref in all) {
                match (GIT_log.walk(gitdir, git_ref.name, -1)) {
                    case Ok(List<GIT_log.Entry> entries): {
                        for (GIT_log.Entry entry in entries) {
                            if (!seen.contains(entry.id)) {
                                seen.set(entry.id, true);
                                out.push(entry.id);
                            }
                        }
                    }
                    case Err: {
                    }
                }
            }
        }
        case Err: {
        }
    }
    return out;
}
