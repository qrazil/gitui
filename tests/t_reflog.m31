// Drives `GIT_reflog.m31` so `test_reflog.sh` can compare it with `git reflog`.
//
//   ./t_reflog <gitdir> show <ref>                     one `old new message` per line, oldest first
//   ./t_reflog <gitdir> append <ref> <old> <new> <msg>  (`-` for no id)
//   ./t_reflog <gitdir> update <ref> <old> <new> <msg>  log_update (HEAD mirroring)
//   ./t_reflog <gitdir> delete <ref> <n> [rewrite]
//   ./t_reflog <gitdir> drop <ref>
//   ./t_reflog <gitdir> should <ref>                    prints yes | no

import GIT_object;
import GIT_reflog;
import io;
import os;

List<str> argv = os.args();
if (argv.size() < 4) {
    io.eprint("usage: t_reflog <gitdir> show|append|update|delete|drop|should <ref> ...");
    os.exit(2);
}
str gitdir = argv[1];
str operation = argv[2];
str ref = argv[3];

str id_arg(str raw) {
    if (raw == "-") {
        return "";
    }
    return raw;
}

if (operation == "show") {
    match (GIT_reflog.read(gitdir, ref)) {
        case Ok(List<GIT_reflog.Entry> entries): {
            for (GIT_reflog.Entry entry in entries) {
                print(entry.old + " " + entry.new + " " + entry.name + " <" + entry.email + "> " + entry.when.to_str() + " " + entry.zone + " | " + entry.message);
            }
        }
        case Err(GIT_reflog.Error error): {
            print("refused: " + error.to_str());
            os.exit(1);
        }
    }
} else if (operation == "should") {
    if (GIT_reflog.should_log(gitdir, ref)) {
        print("yes");
    } else {
        print("no");
    }
} else if (operation == "drop") {
    match (GIT_reflog.delete_log(gitdir, ref)) {
        case Ok(_): {
            print("ok");
        }
        case Err(GIT_reflog.Error error): {
            print("refused: " + error.to_str());
            os.exit(1);
        }
    }
} else if (operation == "delete") {
    bool rewrite = argv.size() > 5 && argv[5] == "rewrite";
    match (GIT_reflog.delete(gitdir, ref, argv[4].parse_int().or(0), rewrite)) {
        case Ok(_): {
            print("ok");
        }
        case Err(GIT_reflog.Error error): {
            print("refused: " + error.to_str());
            os.exit(1);
        }
    }
} else if (operation == "append" || operation == "update") {
    if (argv.size() < 7) {
        io.eprint("usage: t_reflog <gitdir> " + operation + " <ref> <old> <new> <msg>");
        os.exit(2);
    }
    Result<bool, GIT_reflog.Error> done = Result<bool, GIT_reflog.Error>.Ok(false);
    if (operation == "append") {
        done = GIT_reflog.append(gitdir, ref, id_arg(argv[4]), id_arg(argv[5]), GIT_reflog.default_ident(gitdir), argv[6]);
    } else {
        done = GIT_reflog.log_update(gitdir, ref, id_arg(argv[4]), id_arg(argv[5]), argv[6]);
    }
    match (done) {
        case Ok(bool wrote): {
            if (wrote) {
                print("ok");
            } else {
                print("skipped");
            }
        }
        case Err(GIT_reflog.Error error): {
            print("refused: " + error.to_str());
            os.exit(1);
        }
    }
} else {
    io.eprint("unknown operation " + operation);
    os.exit(2);
}
