// Reads `.git/index` at the repository named on the command line and writes
// it straight back -- re-encoded by this module, every extension real git
// may have added dropped -- so `test_write.sh` can confirm real `git`
// (`status`, `ls-files --stage`) still agrees with the result.
//
//   ./t_index_rewrite <gitdir>

import GIT_index;
import io;
import os;

List<str> argv = os.arguments();
if (argv.size() < 2) {
    io.eprint("usage: t_index_rewrite <gitdir>");
    os.exit(2);
}
str git_directory = argv[1];
GIT_index.Index original = GIT_index.Index([]);
match (GIT_index.read(git_directory)) {
    case Ok(GIT_index.Index index): {
        original = index;
    }
    case Err(GIT_index.Error error): {
        io.eprint("read: " + error.to_str());
        os.exit(1);
    }
}
match (GIT_index.write(git_directory, original)) {
    case Ok: {
    }
    case Err(GIT_index.Error error): {
        io.eprint("write: " + error.to_str());
        os.exit(1);
    }
}
print("rewritten " + original.entries.size().to_str());
