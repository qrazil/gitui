// Reads `.git/index` at the repository named on the command line and writes
// it straight back -- re-encoded by this module, every extension real git
// may have added dropped -- so `test_write.sh` can confirm real `git`
// (`status`, `ls-files --stage`) still agrees with the result.
//
//   ./t_index_rewrite <gitdir>

import GIT_index;
import io;
import os;

List<str> argv = os.args();
if (argv.size() < 2) {
    io.eprint("usage: t_index_rewrite <gitdir>");
    os.exit(2);
}
str gd = argv[1];
GIT_index.Index ix = GIT_index.Index([]);
match (GIT_index.read(gd)) {
    case Ok(GIT_index.Index v): {
        ix = v;
    }
    case Err(GIT_index.Error e): {
        io.eprint("read: " + e.to_str());
        os.exit(1);
    }
}
match (GIT_index.write(gd, ix)) {
    case Ok: {
    }
    case Err(GIT_index.Error e): {
        io.eprint("write: " + e.to_str());
        os.exit(1);
    }
}
print("rewritten " + ix.entries.size().to_str());
