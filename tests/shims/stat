#!/usr/bin/env python3
# `stat -c %a FILE...` (octal permission bits) for hosts whose `stat` is BSD's (macOS); nothing else is needed.
import os, stat, sys

if len(sys.argv) >= 4 and sys.argv[1] == "-c" and sys.argv[2] == "%a":
    for path in sys.argv[3:]:
        print("%o" % stat.S_IMODE(os.stat(path).st_mode))
    sys.exit(0)
sys.stderr.write("stat shim: only `stat -c %a FILE...` is supported\n")
sys.exit(2)
