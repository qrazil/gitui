#!/usr/bin/env python3
# GNU `md5sum` for hosts that lack it (macOS): `<hex>  <file>` per file, `<hex>  -` for stdin.
import hashlib, sys

def digest(f):
    h = hashlib.md5()
    for chunk in iter(lambda: f.read(1 << 16), b""):
        h.update(chunk)
    return h.hexdigest()

args = [a for a in sys.argv[1:] if a != "--"]
if not args:
    args = ["-"]
rc = 0
for a in args:
    try:
        if a == "-":
            print("%s  -" % digest(sys.stdin.buffer))
        else:
            with open(a, "rb") as f:
                print("%s  %s" % (digest(f), a))
    except OSError as e:
        sys.stderr.write("md5sum: %s: %s\n" % (a, e.strerror))
        rc = 1
sys.exit(rc)
