// `GIT_zlib.decompress_at`/`GIT_zlib.inflate_at` against `oracle_inflate_at.py`'s
// two concatenated-stream fixtures -- isolated from `GIT_pack.m31`'s own framing,
// exactly as that oracle's own header explains.
//
//   python3 tests/oracles/oracle_inflate_at.py DIR > want
//   bash scripts/build.sh tests/t_inflate_at.m31 -o t_inflate_at
//   ./t_inflate_at DIR > got
//   diff got want
//
// One line per stream, in the order it starts at in its buffer:
//
//   <kind> <index> <start> ok <used> <sha1-of-the-payload>
//   <kind> <index> <start> err

import GIT_zlib;
import GIT_sha1;
import io;
import os;
import fs;

List<str> argv = os.args();
if (argv.size() < 2) {
    io.eprint("usage: t_inflate_at <fixture-dir>");
    os.exit(2);
}
str directory = argv[1];
bytes zbuf = [];
match (io.read_bytes(fs.join(directory, "streams.zlib"))) {
    case Ok(bytes contents): {
        zbuf = contents;
    }
    case Err(io.Error error): {
        io.eprint("cannot read streams.zlib: " + error.to_str());
        os.exit(2);
    }
}
bytes rbuf = [];
match (io.read_bytes(fs.join(directory, "streams.raw"))) {
    case Ok(bytes contents): {
        rbuf = contents;
    }
    case Err(io.Error error): {
        io.eprint("cannot read streams.raw: " + error.to_str());
        os.exit(2);
    }
}
int zlib_index = 0;
int zoff = 0;
while (zoff < zbuf.size()) {
    match (GIT_zlib.decompress_at(zbuf, zoff)) {
        case Ok(GIT_zlib.Decoded decoded): {
            print("zlib " + zlib_index.to_str() + " " + zoff.to_str() + " ok " + decoded.used.to_str() + " " + GIT_sha1.hex(decoded.data));
            if (decoded.used <= 0) {
                // Refuse to spin forever on a bug that reports no progress.
                io.eprint("zlib stream " + zlib_index.to_str() + " reported used <= 0");
                os.exit(2);
            }
            zoff = zoff + decoded.used;
        }
        case Err(GIT_zlib.Error error): {
            print("zlib " + zlib_index.to_str() + " " + zoff.to_str() + " err");
            io.eprint("  zlib " + zlib_index.to_str() + ": " + error.to_str());
            zoff = zbuf.size();
        }
    }
    zlib_index = zlib_index + 1;
}
int raw_index = 0;
int roff = 0;
while (roff < rbuf.size()) {
    match (GIT_zlib.inflate_at(rbuf, roff)) {
        case Ok(GIT_zlib.Decoded decoded): {
            print("raw " + raw_index.to_str() + " " + roff.to_str() + " ok " + decoded.used.to_str() + " " + GIT_sha1.hex(decoded.data));
            if (decoded.used <= 0) {
                io.eprint("raw stream " + raw_index.to_str() + " reported used <= 0");
                os.exit(2);
            }
            roff = roff + decoded.used;
        }
        case Err(GIT_zlib.Error error): {
            print("raw " + raw_index.to_str() + " " + roff.to_str() + " err");
            io.eprint("  raw " + raw_index.to_str() + ": " + error.to_str());
            roff = rbuf.size();
        }
    }
    raw_index = raw_index + 1;
}
