// Reads `.git/index` at the repository named on the command line and prints
// it in exactly the shape `git ls-files --stage` uses --
// `<mode> <sha1> <stage>\t<path>`, one line per entry -- so `test_write.sh`
// can diff this program's output against that command's, unmodified.
//
//   ./t_index_read <gitdir>

import GIT_index;
import io;
import os;

List<str> argv = os.arguments();
if (argv.size() < 2) {
    io.eprint("usage: t_index_read <gitdir>");
    os.exit(2);
}
str git_directory = argv[1];
match (GIT_index.read(git_directory)) {
    case Ok(GIT_index.Index index): {
        for (GIT_index.Entry entry in index.entries) {
            str path = entry.path.utf8().or("<non-utf8>");
            print(mode6(entry.mode) + " " + entry.id + " " + entry.stage.to_str() + "\t" + path);
        }
    }
    case Err(GIT_index.Error error): {
        io.eprint(error.to_str());
        os.exit(1);
    }
}

// The six-digit zero-padded octal `git ls-files --stage` prints.
str mode6(int mode) {
    str text = "";
    int digit_index = 5;
    while (digit_index >= 0) {
        text = text + (mode >> digit_index * 3 & 7).to_str();
        digit_index = digit_index - 1;
    }
    return text;
}
