// Unit tests for `GIT_client.m31`'s pure logic -- the pieces that need no
// repository at all: building the outline from a `GIT_status.Status` and a
// commit walk, and stripping a commit message down to what git would
// actually commit, empty-message refusal included.
//
//   ./t_gitclient
//
// Prints one `<case> ok` or `<case> FAIL ...` line per check; `test.sh`
// greps for the `ok` lines and fails the suite if any `FAIL` line appears
// (the same convention `t_write_refs.m31` already uses). No repository, no
// filesystem, no `gitdir` -- this is exactly what a pure function buys.

import GIT_checkout;
import GIT_client;
import GIT_log;
import GIT_object;
import GIT_status;
import tui.TUI_diff_view;
import tui.TUI_outline;
import tui.TUI_text;

// A local of the top-level program body is invisible to a function
// (`docs/FRICTION.md` §6, `git.m31`'s own `dispatch` comment) -- so the
// running totals live in a small struct, passed to `check` and mutated
// through it, the way `GIT_index.Index.entries` is mutated through every
// staging function above.
type Counter {
    int checks = 0;
    int failed = 0;
}

void Counter.check(str name, bool is_ok, str detail) {
    checks = checks + 1;
    if (is_ok) {
        print(name + " ok");
    } else {
        failed = failed + 1;
        print(name + " FAIL " + detail);
    }
}

Counter counter = Counter();

// --- build_outline -----------------------------------------------------------

GIT_status.Status status = GIT_status.Status([GIT_status.Delta("a.txt".to_bytes(), GIT_status.Change.Modified), GIT_status.Delta("newfile.txt".to_bytes(), GIT_status.Change.Added)], [GIT_status.Delta("b.txt".to_bytes(), GIT_status.Change.Modified)], ["c.txt".to_bytes()]);
GIT_object.Ident who = GIT_object.Ident("A U Thor".to_bytes(), "a@example.com".to_bytes(), 1700000000, 0, "+0000");
GIT_object.Commit first_commit = GIT_object.Commit("0000000000000000000000000000000000000000", [], who, who, [], "first commit\n\nwith a body\n".to_bytes());
List<GIT_log.Entry> log = [GIT_log.Entry("1111111111111111111111111111111111111111", first_commit)];
Map<str, bool> collapsed = {};
Map<str, bytes> paths = {};
Map<str, List<GIT_client.CommitFileDiff>> changes = {};
changes.set("1111111111111111111111111111111111111111", [GIT_client.CommitFileDiff("x.txt".to_bytes(), GIT_status.Change.Modified, Option<str>.Some("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), Option<str>.Some("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"), false, 3, 1)]);
Map<str, GIT_client.CommitFileDiff> file_diffs = {};
TUI_outline.Outline outline = GIT_client.build_outline(status, log, changes, collapsed, paths, file_diffs, []);
List<TUI_outline.Row> rows = outline.rows();
List<str> ids = [];
for (TUI_outline.Row row in rows) {
    ids.push(row.node.id);
}
str joined = ids.join(",");
counter.check("outline: five top-level sections plus their children, commits collapsed by default", joined == "untracked,untracked:c.txt,unstaged,unstaged:b.txt,staged,staged:a.txt,staged:newfile.txt,commits,commit:1111111111111111111111111111111111111111,branches", joined);
List<GIT_client.BranchRow> brs = [GIT_client.BranchRow(GIT_checkout.Branch("feature", "refs/heads/feature", "2222222222222222222222222222222222222222", false), "second thing"), GIT_client.BranchRow(GIT_checkout.Branch("main", "refs/heads/main", "1111111111111111111111111111111111111111", true), "first commit")];
TUI_outline.Outline branch_outline = GIT_client.build_outline(status, log, changes, collapsed, paths, file_diffs, brs);
List<str> bids = [];
List<str> blabels = [];
for (TUI_outline.Row row in branch_outline.rows()) {
    if (row.node.id == "branches" || row.node.id.starts_with("branch:")) {
        bids.push(row.node.id);
        blabels.push(row.node.label);
    }
}
counter.check("outline: branches section lists one leaf per branch, expanded by default", bids.join(",") == "branches,branch:feature,branch:main", bids.join(","));
counter.check("outline: branches header counts the branches", blabels[0] == "Branches (2)", blabels[0]);
counter.check("outline: a branch row shows name, short tip id and subject", blabels[1] == "  feature  2222222  second thing", blabels[1]);
counter.check("outline: the current branch is marked with *", blabels[2] == "* main  1111111  first commit", blabels[2]);
counter.check("outline: staged section counts both staged deltas", rows[4].node.label == "Staged changes (2)", rows[4].node.label);
counter.check("outline: a staged, modified path is marked M", rows[5].node.label == "M  a.txt", rows[5].node.label);
counter.check("outline: a staged, newly-added path is marked A", rows[6].node.label == "A  newfile.txt", rows[6].node.label);
counter.check("outline: the commit row shows its short id and first message line", rows[8].node.label == "1111111  first commit", rows[8].node.label);
match (paths.get("staged:a.txt")) {
    case Some(bytes path): {
        counter.check("outline: paths map recovers the real bytes for a staged row", path.utf8().or("") == "a.txt", path.utf8().or("<none>"));
    }
    case None: {
        counter.check("outline: paths map recovers the real bytes for a staged row", false, "no entry for staged:a.txt");
    }
}
match (paths.get("untracked:c.txt")) {
    case Some(bytes path): {
        counter.check("outline: paths map recovers the real bytes for an untracked row", path.utf8().or("") == "c.txt", path.utf8().or("<none>"));
    }
    case None: {
        counter.check("outline: paths map recovers the real bytes for an untracked row", false, "no entry for untracked:c.txt");
    }
}
// A commit section defaults collapsed, so its body rows (author/date/message)
// must not appear in the flattened, visible list yet.
bool has_seen_body = false;
for (str id in ids) {
    if (id.starts_with("commit:1111111111111111111111111111111111111111:")) {
        has_seen_body = true;
    }
}
counter.check("outline: a commit's body is hidden until expanded", !has_seen_body, "body row leaked into the collapsed view");
// Recorded as expanded (via `collapsed`), the same build must show it.
collapsed.set("commit:1111111111111111111111111111111111111111", false);
TUI_outline.Outline second_outline = GIT_client.build_outline(status, log, changes, collapsed, paths, file_diffs, []);
bool has_seen_second_body = false;
for (TUI_outline.Row row in second_outline.rows()) {
    if (row.node.id == "commit:1111111111111111111111111111111111111111:author") {
        has_seen_second_body = true;
    }
}
counter.check("outline: an expanded commit shows its author/date/message rows", has_seen_second_body, "author row missing after expanding");
str files_label = "";
bool has_seen_file_row = false;
for (TUI_outline.Row row in second_outline.rows()) {
    if (row.node.id == "commit:1111111111111111111111111111111111111111:files") {
        files_label = row.node.label;
    }
    if (row.node.id == "commit:1111111111111111111111111111111111111111:file:0") {
        has_seen_file_row = true;
    }
}
counter.check("outline: an expanded commit shows its own Files changed section, counting changes' entries", files_label == "Files changed (1)", files_label);
counter.check("outline: a commit's Files changed section is open by default once the commit is", has_seen_file_row, "file row missing with the commit expanded and no fold recorded");
str file_label = "";
for (TUI_outline.Row row in second_outline.rows()) {
    if (row.node.id == "commit:1111111111111111111111111111111111111111:file:0") {
        file_label = row.node.label;
    }
}
counter.check("outline: a commit's file row shows mark, path and +insertions -deletions", file_label == "M  x.txt  +3 -1", file_label);
// A fold the user recorded on the Files changed section itself still wins
// over that default, the same way every other section's does.
collapsed.set("commit:1111111111111111111111111111111111111111:files", true);
TUI_outline.Outline o2b = GIT_client.build_outline(status, log, changes, collapsed, paths, file_diffs, []);
bool has_seen_folded_file_row = false;
for (TUI_outline.Row row in o2b.rows()) {
    if (row.node.id == "commit:1111111111111111111111111111111111111111:file:0") {
        has_seen_folded_file_row = true;
    }
}
counter.check("outline: a recorded fold on Files changed hides its file rows again", !has_seen_folded_file_row, "file row shown despite a recorded fold");
collapsed.set("commit:1111111111111111111111111111111111111111:files", false);
// A log as long as one page may have more behind it: the Commits section
// then ends in the "load more" row (and says so in its count); a shorter
// log has no such row -- `outline` above, one commit, proved the absence already
// via its exact id list.
List<GIT_log.Entry> long_log = [];
int line_index = 0;
while (line_index < 200) {
    str hex = line_index.to_str();
    while (hex.size() < 40) {
        hex = "0" + hex;
    }
    long_log.push(GIT_log.Entry(hex, first_commit));
    line_index = line_index + 1;
}
Map<str, bool> collapsed_long = {};
Map<str, bytes> paths_long = {};
Map<str, List<GIT_client.CommitFileDiff>> changes_long = {};
Map<str, GIT_client.CommitFileDiff> file_diffs_long = {};
TUI_outline.Outline o_long = GIT_client.build_outline(status, long_log, changes_long, collapsed_long, paths_long, file_diffs_long, []);
List<TUI_outline.Row> long_rows = o_long.rows();
str last_id = long_rows[long_rows.size() - 1].node.id;
str commits_label_long = "";
for (TUI_outline.Row row in long_rows) {
    if (row.node.id == "commits") {
        commits_label_long = row.node.label;
    }
}
counter.check("outline: a page-long log ends its Commits section with the load-more row", last_id == "commits:more", last_id);
counter.check("outline: a page-long log's Commits count says there may be more", commits_label_long == "Commits (200+)", commits_label_long);
match (file_diffs.get("commit:1111111111111111111111111111111111111111:file:0")) {
    case Some(GIT_client.CommitFileDiff commit_file_diff): {
        counter.check("outline: file_diffs recovers the same CommitFileDiff show_diff_current reads on Enter", commit_file_diff.path.utf8().or("") == "x.txt", commit_file_diff.path.utf8().or("<none>"));
    }
    case None: {
        counter.check("outline: file_diffs recovers the same CommitFileDiff show_diff_current reads on Enter", false, "no entry for the file row");
    }
}

// --- commit_node: wrapping a long message line into multiple leaf rows -------
//
// `commit_node` wraps each logical message line to `COMMIT_BODY_WRAP_COLUMNS`
// (72, see its own comment in `GIT_client.m31`) rather than clipping it --
// this is the fix itself, so it gets its own commit and its own checks
// rather than piggybacking on `first_commit` above.

str long_words = "lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod ";
str long_line = long_words.repeat(3).trim();
GIT_object.Commit second_commit = GIT_object.Commit("0000000000000000000000000000000000000000", [], who, who, [], (long_line + "\n\nshort tail line\n").to_bytes());
List<GIT_log.Entry> log2 = [GIT_log.Entry("2222222222222222222222222222222222222222", second_commit)];
Map<str, bool> collapsed2 = {};
collapsed2.set("commit:2222222222222222222222222222222222222222", false);
Map<str, bytes> paths2 = {};
Map<str, List<GIT_client.CommitFileDiff>> changes2 = {};
Map<str, GIT_client.CommitFileDiff> file_diffs2 = {};
TUI_outline.Outline third_outline = GIT_client.build_outline(status, log2, changes2, collapsed2, paths2, file_diffs2, []);
List<str> m0_rows = [];
List<str> m2_rows = [];
bool has_seen_blank_line_row = false;
for (TUI_outline.Row row in third_outline.rows()) {
    str rid = row.node.id;
    if (rid.starts_with("commit:2222222222222222222222222222222222222222:m0:")) {
        m0_rows.push(row.node.label);
    }
    if (rid == "commit:2222222222222222222222222222222222222222:m1:0") {
        has_seen_blank_line_row = row.node.label == "  ";
    }
    if (rid.starts_with("commit:2222222222222222222222222222222222222222:m2:")) {
        m2_rows.push(row.node.label);
    }
}
counter.check("commit message wrap: a line far longer than the fallback width becomes more than one leaf row", m0_rows.size() > 1, m0_rows.size().to_str() + " row(s)");
bool is_all_fitting = true;
List<str> pieces = [];
for (str row in m0_rows) {
    str content = row.substr(2, row.size());
    if (TUI_text.width(content) > 72) {
        is_all_fitting = false;
    }
    pieces.push(content);
}
counter.check("commit message wrap: every wrapped row fits within the fallback width", is_all_fitting, m0_rows.join(" | "));
counter.check("commit message wrap: rejoining the wrapped rows reproduces the original line losslessly", pieces.join(" ") == long_line, "got: " + pieces.join(" ") + "\nwant: " + long_line);
counter.check("commit message wrap: a blank message line still yields exactly one, empty leaf row", has_seen_blank_line_row, "no lone blank-line row found");
counter.check("commit message wrap: a line that already fits still yields exactly one leaf row", m2_rows.size() == 1 && m2_rows[0] == "  short tail line", m2_rows.join(" | "));
// An empty commit message: no message rows at all, matching `first_line`'s
// own "nothing to show" reading of an empty message (just the author/date
// leaves).
GIT_object.Commit third_commit = GIT_object.Commit("0000000000000000000000000000000000000000", [], who, who, [], "".to_bytes());
List<GIT_log.Entry> log3 = [GIT_log.Entry("3333333333333333333333333333333333333333", third_commit)];
Map<str, bool> collapsed3 = {};
collapsed3.set("commit:3333333333333333333333333333333333333333", false);
Map<str, bytes> paths3 = {};
Map<str, List<GIT_client.CommitFileDiff>> changes3 = {};
Map<str, GIT_client.CommitFileDiff> file_diffs3 = {};
TUI_outline.Outline fourth_outline = GIT_client.build_outline(status, log3, changes3, collapsed3, paths3, file_diffs3, []);
bool has_seen_any_message_row = false;
for (TUI_outline.Row row in fourth_outline.rows()) {
    if (row.node.id.starts_with("commit:3333333333333333333333333333333333333333:m")) {
        has_seen_any_message_row = true;
    }
}
counter.check("commit message wrap: an empty commit message yields no message rows", !has_seen_any_message_row, "unexpected message row for an empty commit message");

// --- strip_comment_lines -------------------------------------------------------

counter.check("commit message: comments dropped, body kept", GIT_client.strip_comment_lines("a summary\n\nbody line\n# comment 1\n#comment 2\nmore body\n") == "a summary\n\nbody line\nmore body", GIT_client.strip_comment_lines("a summary\n\nbody line\n# comment 1\n#comment 2\nmore body\n"));
counter.check("commit message: leading and trailing blank lines trimmed", GIT_client.strip_comment_lines("\n\n  hello  \n\n") == "hello", GIT_client.strip_comment_lines("\n\n  hello  \n\n"));
counter.check("commit message: all-comment input strips to empty (refused by finish_commit)", GIT_client.strip_comment_lines(GIT_client.commit_template()) == "", GIT_client.strip_comment_lines(GIT_client.commit_template()));
counter.check("commit message: whitespace-only input strips to empty", GIT_client.strip_comment_lines("   \n\t\n   ") == "", GIT_client.strip_comment_lines("   \n\t\n   "));
// --- open_diff / close_diff: the GIT_hunks.hunks/DiffView wiring, no repository ---
//
// `open_diff` and the comparison it feeds are `GIT_hunks.hunks(old, new)` and
// `TUI_diff_view.DiffView`, both already tested elsewhere (`tests/t_hunks.m31`,
// `tui`'s own suite) -- what these checks are actually for is that
// `GIT_client.State` wires the two together correctly: a text change becomes a
// non-binary `DiffView` with an addressable cursor, and a NUL-bearing buffer
// on either side becomes `is_diff_binary` instead of a garbled render. Which
// on-disk/index/HEAD comparison feeds `open_diff` for each of the
// unstaged/staged/untracked cases is exercised against real git in
// `test_gitui.sh` instead, since that needs an actual repository.
GIT_client.State diff_state = GIT_client.State.open("", "");
diff_state.open_diff("t.txt", "a\nb\nc\n".to_bytes(), "a\nB\nc\n".to_bytes());
counter.check("open_diff: a one-line text change opens a non-binary, single-hunk view", diff_state.is_diff_open && !diff_state.is_diff_binary && diff_state.diff_view.hunks.size() == 1, "diff_open=" + diff_state.is_diff_open.to_str() + " binary=" + diff_state.is_diff_binary.to_str() + " hunks=" + diff_state.diff_view.hunks.size().to_str());
str header0 = "<no hunk>";
if (diff_state.diff_view.hunks.size() > 0) {
    header0 = diff_state.diff_view.hunks[0].header;
}
counter.check("open_diff: the hunk header is a unified-diff @@ line", header0 == "@@ -1,3 +1,3 @@", header0);
match (diff_state.diff_view.at()) {
    case Some(TUI_diff_view.Row row): {
        bool is_header = false;
        match (row.kind) {
            case Header: {
                is_header = true;
            }
            case Body: {
                is_header = false;
            }
        }
        counter.check("open_diff: the cursor starts on the first hunk's header (DiffView.at addressing)", is_header && row.hunk == 0, "row: kind is not Header or hunk != 0");
    }
    case None: {
        counter.check("open_diff: the cursor starts on the first hunk's header (DiffView.at addressing)", false, "at() returned None on a non-empty diff");
    }
}
diff_state.diff_view.move(1);
match (diff_state.diff_view.at()) {
    case Some(TUI_diff_view.Row row): {
        bool is_body = false;
        match (row.kind) {
            case Header: {
                is_body = false;
            }
            case Body: {
                is_body = true;
            }
        }
        counter.check("open_diff: moving the cursor addresses a body line of hunk 0", is_body && row.hunk == 0 && row.line == 0, "row did not address hunk 0's first body line");
    }
    case None: {
        counter.check("open_diff: moving the cursor addresses a body line of hunk 0", false, "at() returned None after move(1)");
    }
}
diff_state.close_diff();
counter.check("close_diff: closing drops back to the outline and clears the view", !diff_state.is_diff_open && !diff_state.is_diff_binary && diff_state.diff_view.hunks.size() == 0, "diff_open=" + diff_state.is_diff_open.to_str() + " binary=" + diff_state.is_diff_binary.to_str() + " hunks=" + diff_state.diff_view.hunks.size().to_str());
// A NUL on either side is `diff.is_binary`'s own heuristic (`lib/diff.m31`) --
// checked here only to confirm `open_diff` reports it as `is_diff_binary` rather
// than trying to line-diff it.
GIT_client.State branch_state = GIT_client.State.open("", "");
bytes nul_old = [104, 101, 108, 108, 111, 0, 119, 111, 114, 108, 100, 10];
branch_state.open_diff("bin.dat", nul_old, "hello world\n".to_bytes());
counter.check("open_diff: a NUL-bearing old side reports diff_binary, not a garbled hunk view", branch_state.is_diff_open && branch_state.is_diff_binary && branch_state.diff_view.hunks.size() == 0, "diff_open=" + branch_state.is_diff_open.to_str() + " binary=" + branch_state.is_diff_binary.to_str() + " hunks=" + branch_state.diff_view.hunks.size().to_str());
// Untracked: no "old" side at all -- open_diff against an empty old, exactly
// what `show_diff_current` does for an untracked row, should be one
// all-added hunk covering the whole file.
GIT_client.State unstaged_state = GIT_client.State.open("", "");
unstaged_state.open_diff("new.txt", [], "one\ntwo\n".to_bytes());
bool is_all_added = unstaged_state.diff_view.hunks.size() == 1;
if (is_all_added) {
    for (TUI_diff_view.Line line in unstaged_state.diff_view.hunks[0].lines) {
        match (line.kind) {
            case Add: {
            }
            case Context: {
                is_all_added = false;
            }
            case Remove: {
                is_all_added = false;
            }
        }
    }
}
counter.check("open_diff: an untracked file (empty old) is one all-added hunk", !unstaged_state.is_diff_binary && is_all_added, "binary=" + unstaged_state.is_diff_binary.to_str() + " hunks=" + unstaged_state.diff_view.hunks.size().to_str());

// --- pick_editor ---------------------------------------------------------------

counter.check("pick_editor: $EDITOR set is used as-is", GIT_client.pick_editor(Option<str>.Some("emacs -nw")) == "emacs -nw", GIT_client.pick_editor(Option<str>.Some("emacs -nw")));
counter.check("pick_editor: $EDITOR unset falls back to vi, real git's own default", GIT_client.pick_editor(Option<str>.None) == "vi", GIT_client.pick_editor(Option<str>.None));
print("");
print(counter.checks.to_str() + " checks, " + counter.failed.to_str() + " failed");
