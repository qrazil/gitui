// Batch driver for `GIT_patch.apply_lines` / `revert_lines`, for
// `tests/oracles/oracle_lines.py`: for each case DIR/NNNNN.{old,new,sel} (`sel`:
// the indices, separated by spaces, of the ops of diff(old, new) -- as
// `GIT_xdiff.diff_text` makes it -- that are selected) writes
//
//   NNNNN.applied    apply_lines(old, ops, sel)
//   NNNNN.reverted   revert_lines(new, ops, sel)
//   NNNNN.stale_applied, .stale_reverted, .far
//                    only when NNNNN.stale exists: apply/revert of that text with
//                    the same ops, and apply_lines with the index ops.size()
//   NNNNN.ops        the number of ops, then the script, a ` `, `+` or `-` and
//                    the line, so the oracle can cross-check the numbering
//
// A result of None is written as the single word `NONE`.
//
//   ./t_lines DIR COUNT

import os;
import io;
import fs;
import text.diff;
import GIT_xdiff;
import GIT_patch;

void run() {
    List<str> argv = os.arguments();
    if (argv.size() != 3) {
        print("usage: t_lines DIR COUNT");
        os.exit(1);
    }
    str directory = argv[1];
    int count = argv[2].parse_int().or(0);
    int counter = 0;
    while (counter < count) {
        str stem = directory + "/" + pad(counter);
        bytes old = read(stem + ".old");
        bytes new = read(stem + ".new");
        List<int> selected = [];
        for (str token in read_text(stem + ".sel").split(" ")) {
            if (token.size() > 0) {
                selected.push(token.parse_int().or(-1));
            }
        }
        match (GIT_xdiff.diff_text(old, new)) {
            case Binary: {
                write(stem + ".applied", "NONE".to_bytes());
                write(stem + ".reverted", "NONE".to_bytes());
                write(stem + ".ops", "BINARY".to_bytes());
            }
            case Lines(List<diff.Op> ops): {
                write(stem + ".applied", or_none(GIT_patch.apply_lines(old, ops, selected)));
                write(stem + ".reverted", or_none(GIT_patch.revert_lines(new, ops, selected)));
                write(stem + ".ops", listing(ops));
                if (fs.is_present(stem + ".stale")) {
                    // a text the ops were not made from, and an index no op has: both None
                    bytes stale = read(stem + ".stale");
                    write(stem + ".stale_applied", or_none(GIT_patch.apply_lines(stale, ops, selected)));
                    write(stem + ".stale_reverted", or_none(GIT_patch.revert_lines(stale, ops, selected)));
                    List<int> far = [ops.size()];
                    write(stem + ".far", or_none(GIT_patch.apply_lines(old, ops, far)));
                }
            }
        }
        counter = counter + 1;
    }
}

bytes or_none(Option<bytes> result) {
    match (result) {
        case Some(bytes data): {
            return data;
        }
        case None: {
            return "NONE".to_bytes();
        }
    }
}

bytes listing(List<diff.Op> ops) {
    bytes out = (ops.size().to_str() + "\n").to_bytes();
    for (diff.Op operation in ops) {
        match (operation.kind) {
            case Keep: {
                out.push(32);
            }
            case Add: {
                out.push(43);
            }
            case Remove: {
                out.push(45);
            }
        }
        out.extend(operation.line);
        if (operation.line[operation.line.size() - 1] != 10) {
            out.push(10);
        }
    }
    return out;
}

str pad(int number) {
    str text_number = number.to_str();
    while (text_number.size() < 5) {
        text_number = "0" + text_number;
    }
    return text_number;
}

bytes read(str path) {
    match (io.read_bytes(path)) {
        case Ok(bytes contents): {
            return contents;
        }
        case Err(io.Error error): {
            print("cannot read " + path + ": " + error.to_str());
            os.exit(1);
            return [];
        }
    }
}

str read_text(str path) {
    return read(path).utf8().or("");
}

void write(str path, bytes data) {
    match (io.write_bytes(path, data)) {
        case Ok(_): {
        }
        case Err(io.Error error): {
            print("cannot write " + path + ": " + error.to_str());
            os.exit(1);
        }
    }
}

run();
