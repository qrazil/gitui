// Drives `GIT_client.State`'s staging, unstaging, committing and diffing
// directly -- no terminal, no `TUI_app.Loop` -- against a real, disposable
// fixture, so `test_gitui.sh` can check each action's on-disk effect against
// real git the same way `t_index_stage.m31` and `t_write_refs.m31` already
// do for the plumbing underneath this client.
//
//   ./t_gitclient_ops <gitdir> <worktree> stage <relative-path>
//   ./t_gitclient_ops <gitdir> <worktree> unstage <relative-path>
//   ./t_gitclient_ops <gitdir> <worktree> commit
//   ./t_gitclient_ops <gitdir> <worktree> diff <untracked|unstaged|staged> <relative-path>
//   ./t_gitclient_ops <gitdir> <worktree> edit
//   ./t_gitclient_ops <gitdir> <worktree> stage_hunk <relative-path> <k>
//   ./t_gitclient_ops <gitdir> <worktree> unstage_hunk <relative-path> <k>
//   ./t_gitclient_ops <gitdir> <worktree> hunk_patch <unstaged|staged> <relative-path> <k>
//   ./t_gitclient_ops <gitdir> <worktree> discard <untracked|unstaged|staged> <relative-path>
//   ./t_gitclient_ops <gitdir> <worktree> amend
//
// `commit` reads whatever is already at `<gitdir>/COMMIT_EDITMSG` -- the
// caller writes it first, the same file a person editing it by hand would
// have left there -- and prints `State.message` afterward either way, so the
// shell test can tell a refusal (an empty message) from an actual commit.
//
// `diff` moves the outline's cursor onto the named row (`did_select_id`, the
// same lookup `State.reload()` itself uses to keep the cursor on a rebuild)
// and calls `show_diff_current()`, then prints the result the same way
// `tests/t_hunks.m31` prints `GIT_hunks.hunks`'s own output -- one `@@ ...`
// header line per hunk, one marker-prefixed line per body row -- so a shell
// test can diff this against real `git diff`/`git diff --cached`'s body
// exactly as `test_hunks.sh` already does against `diff -u`'s. `Binary files
// differ` on its own line if the pair was binary; `no diff shown: <message>`
// if the row could not be found at all (a bad section/path argument).
//
// `stage_hunk`/`unstage_hunk` drive `State.did_stage_hunk`/`did_unstage_hunk` --
// the diff view's own `s`/`u` -- on hunk `k` (0-based, in the order
// `diff` above prints them) and print `State.message`, so `test_gitui.sh`
// can check the index against real git's `add -p`/`reset -p` outcome.
// `hunk_patch` prints hunk `k` of the named comparison as a minimal unified
// diff (`--- a/path`, `+++ b/path`, the one `@@` block) -- the exact patch
// real `git apply --cached` (or `--cached -R`) is given in a copy of the
// fixture, so the two index blobs can be compared byte for byte.
//
// `edit` calls `edit_message()` then `launch_editor()` exactly as
// `gitui.m31`'s own driver does once `TUI_app.Loop.run` has handed the
// terminal back -- there is no terminal or `Session` in this harness at all,
// which is exactly what makes it able to drive `os.run`'s every outcome
// (success, nonzero exit, signal, `$EDITOR` unset or not found)
// deterministically: the caller sets `$EDITOR` (or leaves it unset, to drive
// the `vi` fallback with a `$PATH` this process controls) to a stand-in
// editor script before running this, and checks `State.message` and the
// repository afterward the same way `commit` above is checked.

import GIT_client;
import io;
import os;
import tui.TUI_diff_view;

List<str> argv = os.args();
if (argv.size() < 4) {
    io.eprint("usage: t_gitclient_ops <gitdir> <worktree> stage|unstage <path>");
    io.eprint("       t_gitclient_ops <gitdir> <worktree> commit");
    os.exit(2);
}
str git_directory = argv[1];
str worktree = argv[2];
str operation = argv[3];
GIT_client.State state = GIT_client.State.open(git_directory, worktree);
state.refresh();
if (operation == "stage") {
    if (argv.size() < 5) {
        io.eprint("usage: t_gitclient_ops <gitdir> <worktree> stage <path>");
        os.exit(2);
    }
    state.stage_path(argv[4].to_bytes());
} else if (operation == "unstage") {
    if (argv.size() < 5) {
        io.eprint("usage: t_gitclient_ops <gitdir> <worktree> unstage <path>");
        os.exit(2);
    }
    state.unstage_path(argv[4].to_bytes());
} else if (operation == "commit") {
    state.finish_commit();
} else if (operation == "diff") {
    if (argv.size() < 6) {
        io.eprint("usage: t_gitclient_ops <gitdir> <worktree> diff <untracked|unstaged|staged> <path>");
        os.exit(2);
    }
    state.reload();
    str id = argv[4] + ":" + argv[5];
    if (state.outline.did_select_id(id)) {
        state.show_diff_current();
        if (state.is_diff_open) {
            if (state.is_diff_binary) {
                print("Binary files differ");
            } else {
                for (TUI_diff_view.Hunk hunk in state.diff_view.hunks) {
                    print(hunk.header);
                    for (TUI_diff_view.Line line in hunk.lines) {
                        print(marker(line.kind) + line.text);
                    }
                }
            }
        } else {
            print("no diff shown: " + state.message);
        }
        os.exit(0);
    } else {
        io.eprint("no such row: " + id);
        os.exit(2);
    }
} else if (operation == "edit") {
    state.edit_message();
    state.launch_editor();
} else if (operation == "stage_hunk" || operation == "unstage_hunk") {
    if (argv.size() < 6) {
        io.eprint("usage: t_gitclient_ops <gitdir> <worktree> " + operation + " <path> <k>");
        os.exit(2);
    }
    int hunk_index = argv[5].parse_int().or(-1);
    if (operation == "stage_hunk") {
        state.did_stage_hunk(argv[4].to_bytes(), hunk_index);
    } else {
        state.did_unstage_hunk(argv[4].to_bytes(), hunk_index);
    }
} else if (operation == "hunk_patch") {
    if (argv.size() < 7) {
        io.eprint("usage: t_gitclient_ops <gitdir> <worktree> hunk_patch <unstaged|staged> <path> <k>");
        os.exit(2);
    }
    state.reload();
    str id = argv[4] + ":" + argv[5];
    int hunk_index = argv[6].parse_int().or(-1);
    if (state.outline.did_select_id(id)) {
        state.show_diff_current();
        if (state.is_diff_open && !state.is_diff_binary && hunk_index >= 0 && hunk_index < state.diff_view.hunks.size()) {
            print("--- a/" + argv[5]);
            print("+++ b/" + argv[5]);
            TUI_diff_view.Hunk hunk = state.diff_view.hunks[hunk_index];
            print(hunk.header);
            for (TUI_diff_view.Line line in hunk.lines) {
                print(marker(line.kind) + line.text);
            }
            os.exit(0);
        }
        io.eprint("no such hunk: " + id + " " + hunk_index.to_str() + " (" + state.message + ")");
        os.exit(2);
    } else {
        io.eprint("no such row: " + id);
        os.exit(2);
    }
} else if (operation == "discard") {
    // `discard <untracked|unstaged|staged> <path>`: `discard_path` directly,
    // the step the `x` prompt's own `y` takes -- the prompt itself is pure
    // key handling, covered under a pty by pty_e2e.py.
    if (argv.size() < 6) {
        io.eprint("usage: t_gitclient_ops <gitdir> <worktree> discard <untracked|unstaged|staged> <path>");
        os.exit(2);
    }
    state.discard_path(argv[4], argv[5].to_bytes());
} else if (operation == "amend") {
    // `amend`: `start_amend` (prefills COMMIT_EDITMSG with HEAD's message)
    // then `finish_commit` -- `c`, `A`, `f` with no edit in between, real
    // git's `--amend --no-edit`. A refusal leaves `start_amend`'s own
    // message to print.
    state.start_amend();
    if (state.is_amending) {
        state.finish_commit();
    }
} else {
    io.eprint("unknown op: " + operation);
    os.exit(2);
}
print(state.message);

str marker(TUI_diff_view.Kind kind) {
    match (kind) {
        case Context: {
            return " ";
        }
        case Add: {
            return "+";
        }
        case Remove: {
            return "-";
        }
    }
}
