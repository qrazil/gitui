// `GIT_zlib.decompress` against Python's `zlib`, over the fixtures
// `oracle_inflate.py` writes.
//
//   python3 tests/oracles/oracle_inflate.py DIR > want
//   bash scripts/build.sh tests/t_inflate.m31 -o t_inflate && ./t_inflate DIR > got
//   diff got want
//
// One line per `.z` file in DIR, sorted by name:
//
//   <name> ok <octets> <sha1-of-the-output>
//   <name> err
//
// The digest rather than the octets, because the fixtures include a two-
// megabyte case and a diff of two megabytes of binary is not a diagnostic.
// `t_object.m31` compares real objects octet for octet.

import GIT_zlib;
import crypto.sha1digest;
import io;
import os;
import fs;
import text;
import date;

List<str> argv = os.arguments();
if (argv.size() < 2) {
    io.eprint("usage: t_inflate <fixture-dir>");
    os.exit(2);
}
str directory = argv[1];
List<str> names = [];
match (fs.listdir(directory)) {
    case Ok(List<str> found): {
        for (str file_name in found) {
            // The name WITHOUT the extension, because that is what is
            // printed and the order has to be the order of the printed
            // lines: `fixed-match.z` sorts before `fixed.z` (`-` is below
            // `.`) while `fixed` sorts before `fixed-match`.
            str name = text.strip_suffix(file_name, ".z");
            if (name != file_name) {
                names.push(name);
            }
        }
    }
    case Err(io.Error error): {
        io.eprint("cannot list " + directory + ": " + error.to_str());
        os.exit(2);
    }
}
names.sort();
int slowest = 0;
int slowest_bytes = 0;
str slowest_name = "";
for (str name in names) {
    match (io.read_bytes(fs.join(directory, name + ".z"))) {
        case Ok(bytes stream): {
            int start_nanoseconds = date.now_ns();
            match (GIT_zlib.decompress(stream)) {
                case Ok(bytes out): {
                    int elapsed_nanoseconds = date.now_ns() - start_nanoseconds;
                    print(name + " ok " + out.size().to_str() + " " + sha1digest.hex(out));
                    if (out.size() > slowest_bytes) {
                        slowest_bytes = out.size();
                        slowest = elapsed_nanoseconds;
                        slowest_name = name;
                    }
                }
                case Err(GIT_zlib.Error error): {
                    print(name + " err");
                    // The message is not compared -- no oracle has an opinion
                    // about it -- but a refusal nobody can read is not much of
                    // a refusal, so every one of them is shown on stderr.
                    io.eprint("  " + name + ": " + error.to_str());
                }
            }
        }
        case Err(io.Error error): {
            io.eprint("cannot read " + name + ": " + error.to_str());
            os.exit(2);
        }
    }
}
if (slowest > 0) {
    io.eprint("inflate: " + slowest_name + ", " + slowest_bytes.to_str() + " octets out in " + (slowest / 1_000_000).to_str() + " ms = " + (slowest_bytes * 1_000 / slowest).to_str() + " MB/s");
}
