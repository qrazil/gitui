// A line diff that makes the same choices git's xdiff library makes.
//
// `lib/diff.m31`'s Myers returns a shortest edit script, but a shortest edit
// script is rarely unique, and when it is not, WHICH one you get decides where
// a three-way merge sees two changes touch, and so whether it reports a
// conflict. `git merge-file` and `git merge` run on xdiff; to merge the way they
// do, byte for byte, the diff underneath has to be xdiff's. This is a port of
// the parts of it that matter, in the order xdiff runs them:
//
//   1. classify  -- every distinct line gets a small integer; equal lines have
//                   equal integers, so comparing lines is comparing ints.
//   2. trim      -- the common first and last lines are never looked at again.
//   3. cleanup   -- a line with no equal in the other file is changed for sure
//                   and is dropped from the search; so is a line that is
//                   repeated very often (xdl_cleanup_records).
//   4. recs_cmp  -- Myers' divide-and-conquer middle-snake search in linear
//                   space (xdl_split / xdl_recs_cmp), with xdiff's cost cut-off
//                   and its "good snake" heuristics, which only engage on
//                   large, very different inputs.
//   5. compact   -- every group of changed lines is slid up and down as far as
//                   identical neighbours allow, merging with a neighbouring
//                   group it touches, and left where it lines up with a change
//                   in the other file (xdl_change_compact; the indent
//                   heuristic is only on for `diff_lines_indent`: merge does
//                   not use it, `git diff` and `git blame` do).
//
// API
// ---
//   GIT_xdiff.split_lines(content)   -> List<bytes>   each line keeps its terminator
//   GIT_xdiff.diff_lines(a, b)       -> Diff          which lines of a / b changed
//   GIT_xdiff.diff_lines_indent(a, b) -> Diff         the same with git's indent heuristic (blame, diff)
//   GIT_xdiff.edits(diff)            -> List<Edit>    the change script, in order
//   GIT_xdiff.ops(a, b)              -> List<diff.Op> the same script as `lib/diff`'s ops
//   GIT_xdiff.diff_text(old, new)         -> diff.Diff     `diff.diff`, but with git's choices
//
// A line is a run of bytes up to and including its `\n`; the last line of a
// buffer has none if the buffer does not end in one, and "a" is a different
// line from "a\n" (as in git). `\r\n` is not special here.

import text.diff;

const int SNAKE_CNT = 20;
const int HEUR_MIN_COST = 256;
const int MAX_COST_MIN = 256;
const int K_HEUR = 4;
const int MAX_EQLIMIT = 1024;
const int SIMSCAN_WINDOW = 100;
const int KPDIS_RUN = 4;
const int LINE_MAX = 1073741823;

/// One run of difference: `a[a_start .. a_start + a_len)` is replaced by
/// `b[b_start .. b_start + b_len)`. Either length may be 0 (a pure insertion
/// or deletion).
pub type Edit {
    pub int a_start;
    pub int a_len;
    pub int b_start;
    pub int b_len;
}

/// The result of comparing two line lists: for each line, whether it was
/// changed (removed from `a`, added to `b`), and each line's class number
/// (`a_class[i] == b_class[j]` iff the two lines are equal).
pub type Diff {
    pub List<bool> a_changed;
    pub List<bool> b_changed;
    pub List<int> a_class;
    pub List<int> b_class;
}

/// `content` as lines, each with its own terminator; an empty buffer has none.
pub List<bytes> split_lines(bytes content) {
    List<bytes> out = [];
    int size = content.size();
    int start = 0;
    int position = 0;
    while (position < size) {
        if (content[position] == 10) {
            out.push(content.substr(start, position + 1));
            start = position + 1;
        }
        position = position + 1;
    }
    if (start < size) {
        out.push(content.substr(start, size));
    }
    return out;
}

// --- classification --------------------------------------------------------------

type LineKey {
    bytes line;
    int digest;
}

int LineKey.hash() {
    return digest;
}

bool LineKey.eq(LineKey other) {
    return line == other.line;
}

LineKey key_of(bytes line) {
    int digest = 5381;
    for (int byte in line) {
        digest = (digest * 33 + byte) % 1000000007;
    }
    return LineKey(line, digest);
}

// `a` / `b` are the class number of every line; `count_a` / `count_b` say how
// many lines of each file belong to each class.
type Classes {
    List<int> a;
    List<int> b;
    List<int> count_a;
    List<int> count_b;
}

Classes classify(List<bytes> lines_a, List<bytes> lines_b) {
    Map<LineKey, int> seen = {};
    Classes classes = Classes([], [], [], []);
    for (bytes line in lines_a) {
        int id = class_of(seen, classes, line);
        classes.a.push(id);
        classes.count_a[id] = classes.count_a[id] + 1;
    }
    for (bytes line in lines_b) {
        int id = class_of(seen, classes, line);
        classes.b.push(id);
        classes.count_b[id] = classes.count_b[id] + 1;
    }
    return classes;
}

int class_of(Map<LineKey, int> seen, Classes classes, bytes line) {
    LineKey key = key_of(line);
    match (seen.get(key)) {
        case Some(int id): {
            return id;
        }
        case None: {
            int id = classes.count_a.size();
            seen.set(key, id);
            classes.count_a.push(0);
            classes.count_b.push(0);
            return id;
        }
    }
}

// --- the search -----------------------------------------------------------------------

// xdl_bogosqrt: not a square root, but what xdiff uses as one.
int bogosqrt(int value) {
    int power = 1;
    int rest = value;
    while (rest > 0) {
        power = power * 2;
        rest = rest / 4;
    }
    return power;
}

type Split {
    int i1;
    int i2;
    bool min_lo;
    bool min_hi;
}

// The two files after cleanup: class numbers of the lines that are still in
// play (`ha*`), where each came from (`rindex*`), and the change flags being
// filled in (`rchg*`, indexed by original line number).
type Env {
    List<int> ha1;
    List<int> ha2;
    List<int> rindex1;
    List<int> rindex2;
    List<bool> rchg1;
    List<bool> rchg2;
    List<int> kvdf;
    List<int> kvdb;
    int kv_off;
    int mxcost;
}

// xdl_recs_cmp: shrink the box by its common ends, then split it at the
// middle snake and recurse on both halves.
void Env.recs_cmp(int off1_in, int lim1_in, int off2_in, int lim2_in, bool needs_minimum) {
    int off1 = off1_in;
    int lim1 = lim1_in;
    int off2 = off2_in;
    int lim2 = lim2_in;
    while (off1 < lim1 && off2 < lim2 && ha1[off1] == ha2[off2]) {
        off1 = off1 + 1;
        off2 = off2 + 1;
    }
    while (off1 < lim1 && off2 < lim2 && ha1[lim1 - 1] == ha2[lim2 - 1]) {
        lim1 = lim1 - 1;
        lim2 = lim2 - 1;
    }
    if (off1 == lim1) {
        while (off2 < lim2) {
            rchg2[rindex2[off2]] = true;
            off2 = off2 + 1;
        }
    } else if (off2 == lim2) {
        while (off1 < lim1) {
            rchg1[rindex1[off1]] = true;
            off1 = off1 + 1;
        }
    } else {
        Split spl = split_box(off1, lim1, off2, lim2, needs_minimum);
        recs_cmp(off1, spl.i1, off2, spl.i2, spl.min_lo);
        recs_cmp(spl.i1, lim1, spl.i2, lim2, spl.min_hi);
    }
}

// xdl_split: find the middle snake of the box by running a forward and a
// backward search until they meet.
Split Env.split_box(int off1, int lim1, int off2, int lim2, bool needs_minimum) {
    int offset = kv_off;
    int dmin = off1 - lim2;
    int dmax = lim1 - off2;
    int fmid = off1 - off2;
    int bmid = lim1 - lim2;
    int odd = (fmid - bmid) & 1;
    int fmin = fmid;
    int fmax = fmid;
    int bmin = bmid;
    int bmax = bmid;
    Split spl = Split(0, 0, false, false);
    kvdf[fmid + offset] = off1;
    kvdb[bmid + offset] = lim1;
    int edit_cost = 1;
    while (true) {
        bool did_find_snake = false;
        if (fmin > dmin) {
            fmin = fmin - 1;
            kvdf[fmin - 1 + offset] = -1;
        } else {
            fmin = fmin + 1;
        }
        if (fmax < dmax) {
            fmax = fmax + 1;
            kvdf[fmax + 1 + offset] = -1;
        } else {
            fmax = fmax - 1;
        }
        int diagonal = fmax;
        while (diagonal >= fmin) {
            int index1 = 0;
            if (kvdf[diagonal - 1 + offset] >= kvdf[diagonal + 1 + offset]) {
                index1 = kvdf[diagonal - 1 + offset] + 1;
            } else {
                index1 = kvdf[diagonal + 1 + offset];
            }
            int prev1 = index1;
            int index2 = index1 - diagonal;
            while (index1 < lim1 && index2 < lim2 && ha1[index1] == ha2[index2]) {
                index1 = index1 + 1;
                index2 = index2 + 1;
            }
            if (index1 - prev1 > SNAKE_CNT) {
                did_find_snake = true;
            }
            kvdf[diagonal + offset] = index1;
            if (odd == 1 && bmin <= diagonal && diagonal <= bmax && kvdb[diagonal + offset] <= index1) {
                spl.i1 = index1;
                spl.i2 = index2;
                spl.min_lo = true;
                spl.min_hi = true;
                return spl;
            }
            diagonal = diagonal - 2;
        }
        if (bmin > dmin) {
            bmin = bmin - 1;
            kvdb[bmin - 1 + offset] = LINE_MAX;
        } else {
            bmin = bmin + 1;
        }
        if (bmax < dmax) {
            bmax = bmax + 1;
            kvdb[bmax + 1 + offset] = LINE_MAX;
        } else {
            bmax = bmax - 1;
        }
        diagonal = bmax;
        while (diagonal >= bmin) {
            int index1 = 0;
            if (kvdb[diagonal - 1 + offset] < kvdb[diagonal + 1 + offset]) {
                index1 = kvdb[diagonal - 1 + offset];
            } else {
                index1 = kvdb[diagonal + 1 + offset] - 1;
            }
            int prev1 = index1;
            int index2 = index1 - diagonal;
            while (index1 > off1 && index2 > off2 && ha1[index1 - 1] == ha2[index2 - 1]) {
                index1 = index1 - 1;
                index2 = index2 - 1;
            }
            if (prev1 - index1 > SNAKE_CNT) {
                did_find_snake = true;
            }
            kvdb[diagonal + offset] = index1;
            if (odd == 0 && fmin <= diagonal && diagonal <= fmax && index1 <= kvdf[diagonal + offset]) {
                spl.i1 = index1;
                spl.i2 = index2;
                spl.min_lo = true;
                spl.min_hi = true;
                return spl;
            }
            diagonal = diagonal - 2;
        }
        if (!needs_minimum) {
            if (did_find_snake && edit_cost > HEUR_MIN_COST) {
                if (heuristic_forward(spl, off1, lim1, off2, lim2, fmin, fmax, fmid, edit_cost)) {
                    return spl;
                }
                if (heuristic_backward(spl, off1, lim1, off2, lim2, bmin, bmax, bmid, edit_cost)) {
                    return spl;
                }
            }
            if (edit_cost >= mxcost) {
                return furthest(spl, off1, lim1, off2, lim2, fmin, fmax, bmin, bmax);
            }
        }
        edit_cost = edit_cost + 1;
    }
}

// The forward half of xdiff's "interesting snake" heuristic: a diagonal that
// has already run a long way along a long match is taken as the split.
bool Env.heuristic_forward(Split spl, int off1, int lim1, int off2, int lim2, int fmin, int fmax, int fmid, int edit_cost) {
    int offset = kv_off;
    int best = 0;
    int diagonal = fmax;
    while (diagonal >= fmin) {
        int diagonal_distance = abs_of(diagonal - fmid);
        int index1 = kvdf[diagonal + offset];
        int index2 = index1 - diagonal;
        int progress = (index1 - off1) + (index2 - off2) - diagonal_distance;
        if (progress > K_HEUR * edit_cost && progress > best && off1 + SNAKE_CNT <= index1 && index1 < lim1 && off2 + SNAKE_CNT <= index2 && index2 < lim2) {
            int run_length = 1;
            while (ha1[index1 - run_length] == ha2[index2 - run_length]) {
                if (run_length == SNAKE_CNT) {
                    best = progress;
                    spl.i1 = index1;
                    spl.i2 = index2;
                    break;
                }
                run_length = run_length + 1;
            }
        }
        diagonal = diagonal - 2;
    }
    if (best > 0) {
        spl.min_lo = true;
        spl.min_hi = false;
        return true;
    }
    return false;
}

bool Env.heuristic_backward(Split spl, int off1, int lim1, int off2, int lim2, int bmin, int bmax, int bmid, int edit_cost) {
    int offset = kv_off;
    int best = 0;
    int diagonal = bmax;
    while (diagonal >= bmin) {
        int diagonal_distance = abs_of(diagonal - bmid);
        int index1 = kvdb[diagonal + offset];
        int index2 = index1 - diagonal;
        int progress = (lim1 - index1) + (lim2 - index2) - diagonal_distance;
        if (progress > K_HEUR * edit_cost && progress > best && off1 < index1 && index1 <= lim1 - SNAKE_CNT && off2 < index2 && index2 <= lim2 - SNAKE_CNT) {
            int run_length = 0;
            while (ha1[index1 + run_length] == ha2[index2 + run_length]) {
                if (run_length == SNAKE_CNT - 1) {
                    best = progress;
                    spl.i1 = index1;
                    spl.i2 = index2;
                    break;
                }
                run_length = run_length + 1;
            }
        }
        diagonal = diagonal - 2;
    }
    if (best > 0) {
        spl.min_lo = false;
        spl.min_hi = true;
        return true;
    }
    return false;
}

// "Enough is enough": the search has cost `mxcost`; take the furthest-reaching
// path found so far, from whichever end got further.
Split Env.furthest(Split spl, int off1, int lim1, int off2, int lim2, int fmin, int fmax, int bmin, int bmax) {
    int offset = kv_off;
    int fbest = -1;
    int fbest1 = -1;
    int diagonal = fmax;
    while (diagonal >= fmin) {
        int index1 = min_of(kvdf[diagonal + offset], lim1);
        int index2 = index1 - diagonal;
        if (lim2 < index2) {
            index1 = lim2 + diagonal;
            index2 = lim2;
        }
        if (fbest < index1 + index2) {
            fbest = index1 + index2;
            fbest1 = index1;
        }
        diagonal = diagonal - 2;
    }
    int bbest = LINE_MAX;
    int bbest1 = LINE_MAX;
    diagonal = bmax;
    while (diagonal >= bmin) {
        int index1 = max_of(off1, kvdb[diagonal + offset]);
        int index2 = index1 - diagonal;
        if (index2 < off2) {
            index1 = off2 + diagonal;
            index2 = off2;
        }
        if (index1 + index2 < bbest) {
            bbest = index1 + index2;
            bbest1 = index1;
        }
        diagonal = diagonal - 2;
    }
    if ((lim1 + lim2) - bbest < fbest - (off1 + off2)) {
        spl.i1 = fbest1;
        spl.i2 = fbest - fbest1;
        spl.min_lo = true;
        spl.min_hi = false;
    } else {
        spl.i1 = bbest1;
        spl.i2 = bbest - bbest1;
        spl.min_lo = false;
        spl.min_hi = true;
    }
    return spl;
}

int min_of(int x, int y) {
    if (x < y) {
        return x;
    }
    return y;
}

int max_of(int x, int y) {
    if (x > y) {
        return x;
    }
    return y;
}

int abs_of(int x) {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

// --- cleanup -------------------------------------------------------------------------

// xdl_clean_mmatch: should a line that occurs very often in the other file
// (dis == 2) be thrown out, because it sits in a run of lines that mostly have
// no counterpart?
bool clean_mmatch(List<int> dis, int index, int s_in, int e_in) {
    int scan_start = s_in;
    int scan_end = e_in;
    if (index - scan_start > SIMSCAN_WINDOW) {
        scan_start = index - SIMSCAN_WINDOW;
    }
    if (scan_end - index > SIMSCAN_WINDOW) {
        scan_end = index + SIMSCAN_WINDOW;
    }
    int distance = 1;
    int rdis0 = 0;
    int rpdis0 = 1;
    while (index - distance >= scan_start) {
        if (dis[index - distance] == 0) {
            rdis0 = rdis0 + 1;
        } else if (dis[index - distance] == 2) {
            rpdis0 = rpdis0 + 1;
        } else {
            break;
        }
        distance = distance + 1;
    }
    if (rdis0 == 0) {
        return false;
    }
    distance = 1;
    int rdis1 = 0;
    int rpdis1 = 1;
    while (index + distance <= scan_end) {
        if (dis[index + distance] == 0) {
            rdis1 = rdis1 + 1;
        } else if (dis[index + distance] == 2) {
            rpdis1 = rpdis1 + 1;
        } else {
            break;
        }
        distance = distance + 1;
    }
    if (rdis1 == 0) {
        return false;
    }
    rdis1 = rdis1 + rdis0;
    rpdis1 = rpdis1 + rpdis0;
    return rpdis1 * KPDIS_RUN < rpdis1 + rdis1;
}

// For one file: mark as changed every line in [dstart, dend] with no (or too
// many, in a bad neighbourhood) equal lines in the other file; the survivors
// are what the search sees.
void discard(List<int> cls, List<int> other_count, int dstart, int dend, List<bool> rchg, List<int> kept_classes, List<int> rindex) {
    int line_count = cls.size();
    int mlim = min_of(bogosqrt(line_count), MAX_EQLIMIT);
    List<int> dis = [0; line_count + 1];
    int index = dstart;
    while (index <= dend) {
        int match_count = other_count[cls[index]];
        if (match_count == 0) {
            dis[index] = 0;
        } else if (match_count >= mlim) {
            dis[index] = 2;
        } else {
            dis[index] = 1;
        }
        index = index + 1;
    }
    index = dstart;
    while (index <= dend) {
        if (dis[index] == 1 || (dis[index] == 2 && !clean_mmatch(dis, index, dstart, dend))) {
            kept_classes.push(cls[index]);
            rindex.push(index);
        } else {
            rchg[index] = true;
        }
        index = index + 1;
    }
}

// --- compacting change groups --------------------------------------------------------

// A maximal run of changed lines `[start, end)`, possibly empty. Between two
// consecutive groups of one file is exactly one unchanged line, and both files
// have the same number of unchanged lines, so the groups of the two files pair
// up one to one: `compact` walks both in step.
type Group {
    int start;
    int end;
}

Group group_init(List<bool> rchg) {
    Group group = Group(0, 0);
    while (group.end < rchg.size() && rchg[group.end]) {
        group.end = group.end + 1;
    }
    return group;
}

// True when there is no next group.
bool group_next(List<bool> rchg, Group group) {
    if (group.end == rchg.size()) {
        return true;
    }
    group.start = group.end + 1;
    group.end = group.start;
    while (group.end < rchg.size() && rchg[group.end]) {
        group.end = group.end + 1;
    }
    return false;
}

bool group_previous(List<bool> rchg, Group group) {
    if (group.start == 0) {
        return true;
    }
    group.end = group.start - 1;
    group.start = group.end;
    while (group.start > 0 && rchg[group.start - 1]) {
        group.start = group.start - 1;
    }
    return false;
}

// True when the group could not slide down by one line.
bool group_slide_down(List<bool> rchg, List<int> cls, Group group) {
    if (group.end < rchg.size() && cls[group.start] == cls[group.end]) {
        rchg[group.start] = false;
        group.start = group.start + 1;
        rchg[group.end] = true;
        group.end = group.end + 1;
        while (group.end < rchg.size() && rchg[group.end]) {
            group.end = group.end + 1;
        }
        return false;
    }
    return true;
}

bool group_slide_up(List<bool> rchg, List<int> cls, Group group) {
    if (group.start > 0 && cls[group.start - 1] == cls[group.end - 1]) {
        group.start = group.start - 1;
        rchg[group.start] = true;
        group.end = group.end - 1;
        rchg[group.end] = false;
        while (group.start > 0 && rchg[group.start - 1]) {
            group.start = group.start - 1;
        }
        return false;
    }
    return true;
}

// --- the indent heuristic ---------------------------------------------------------------
//
// xdiff's XDF_INDENT_HEURISTIC (git's default for `git diff` and `git blame`,
// not for merge): when a group of changed lines can slide and does not line up
// with a change in the other file, pick the position whose two splits (before
// and after the group) look most like block boundaries.

const int MAX_INDENT = 200;
const int MAX_BLANKS = 20;
const int START_OF_FILE_PENALTY = 1;
const int END_OF_FILE_PENALTY = 21;
const int TOTAL_BLANK_WEIGHT = -30;
const int POST_BLANK_WEIGHT = 6;
const int RELATIVE_INDENT_PENALTY = -4;
const int RELATIVE_INDENT_WITH_BLANK_PENALTY = 10;
const int RELATIVE_OUTDENT_PENALTY = 24;
const int RELATIVE_OUTDENT_WITH_BLANK_PENALTY = 17;
const int RELATIVE_DEDENT_PENALTY = 23;
const int RELATIVE_DEDENT_WITH_BLANK_PENALTY = 17;
const int INDENT_WEIGHT = 60;
const int INDENT_HEURISTIC_MAX_SLIDING = 100;

type Score {
    int effective_indent;
    int penalty;
}

type Measure {
    bool end_of_file;
    int indent;
    int pre_blank;
    int pre_indent;
    int post_blank;
    int post_indent;
}

bool is_space_byte(int byte) {
    return byte == 32 || (byte >= 9 && byte <= 13);
}

// The width of a line's leading whitespace, or -1 for a line of only whitespace.
int get_indent(bytes line) {
    int result = 0;
    for (int i in 0 .. line.size()) {
        int byte = line[i];
        if (!is_space_byte(byte)) {
            return result;
        }
        if (byte == 32) {
            result = result + 1;
        } else if (byte == 9) {
            result = result + 8 - result % 8;
        }
        if (result >= MAX_INDENT) {
            return MAX_INDENT;
        }
    }
    return -1;
}

Measure measure_split(List<bytes> lines, int split) {
    Measure measure = Measure(false, -1, 0, -1, 0, -1);
    if (split >= lines.size()) {
        measure.end_of_file = true;
    } else {
        measure.indent = get_indent(lines[split]);
    }
    int index = split - 1;
    while (index >= 0) {
        measure.pre_indent = get_indent(lines[index]);
        if (measure.pre_indent != -1) {
            break;
        }
        measure.pre_blank = measure.pre_blank + 1;
        if (measure.pre_blank == MAX_BLANKS) {
            measure.pre_indent = 0;
            break;
        }
        index = index - 1;
    }
    index = split + 1;
    while (index < lines.size()) {
        measure.post_indent = get_indent(lines[index]);
        if (measure.post_indent != -1) {
            break;
        }
        measure.post_blank = measure.post_blank + 1;
        if (measure.post_blank == MAX_BLANKS) {
            measure.post_indent = 0;
            break;
        }
        index = index + 1;
    }
    return measure;
}

void score_add_split(Measure measure, Score score) {
    if (measure.pre_indent == -1 && measure.pre_blank == 0) {
        score.penalty = score.penalty + START_OF_FILE_PENALTY;
    }
    if (measure.end_of_file) {
        score.penalty = score.penalty + END_OF_FILE_PENALTY;
    }
    int post_blank = 0;
    if (measure.indent == -1) {
        post_blank = 1 + measure.post_blank;
    }
    int total_blank = measure.pre_blank + post_blank;
    score.penalty = score.penalty + TOTAL_BLANK_WEIGHT * total_blank;
    score.penalty = score.penalty + POST_BLANK_WEIGHT * post_blank;
    int indent = measure.post_indent;
    if (measure.indent != -1) {
        indent = measure.indent;
    }
    bool has_blanks = total_blank != 0;
    score.effective_indent = score.effective_indent + indent;
    if (indent == -1) {
        return;
    }
    if (measure.pre_indent == -1) {
        return;
    }
    if (indent > measure.pre_indent) {
        if (has_blanks) {
            score.penalty = score.penalty + RELATIVE_INDENT_WITH_BLANK_PENALTY;
        } else {
            score.penalty = score.penalty + RELATIVE_INDENT_PENALTY;
        }
    } else if (indent < measure.pre_indent) {
        if (measure.post_indent != -1 && measure.post_indent > indent) {
            if (has_blanks) {
                score.penalty = score.penalty + RELATIVE_OUTDENT_WITH_BLANK_PENALTY;
            } else {
                score.penalty = score.penalty + RELATIVE_OUTDENT_PENALTY;
            }
        } else if (has_blanks) {
            score.penalty = score.penalty + RELATIVE_DEDENT_WITH_BLANK_PENALTY;
        } else {
            score.penalty = score.penalty + RELATIVE_DEDENT_PENALTY;
        }
    }
}

int score_cmp(Score left, Score right) {
    int cmp_indents = 0;
    if (left.effective_indent > right.effective_indent) {
        cmp_indents = 1;
    } else if (left.effective_indent < right.effective_indent) {
        cmp_indents = -1;
    }
    return INDENT_WEIGHT * cmp_indents + (left.penalty - right.penalty);
}

// xdl_change_compact: slide each group of `rchg` (class numbers `cls`) as far
// up and down as identical lines allow, merging with groups it runs into,
// then park it where it lines up with a group of `rchg_other` if it can, and
// at its lowest position otherwise.
void compact(List<bool> rchg, List<int> cls, List<bool> rchg_other, List<bytes> lines, bool should_use_indent) {
    Group group = group_init(rchg);
    Group other_group = group_init(rchg_other);
    while (true) {
        if (group.end != group.start) {
            int groupsize = 0;
            int earliest_end = 0;
            int end_matching_other = -1;
            while (true) {
                groupsize = group.end - group.start;
                end_matching_other = -1;
                while (!group_slide_up(rchg, cls, group)) {
                    group_previous(rchg_other, other_group);
                }
                earliest_end = group.end;
                if (other_group.end > other_group.start) {
                    end_matching_other = group.end;
                }
                while (true) {
                    if (group_slide_down(rchg, cls, group)) {
                        break;
                    }
                    group_next(rchg_other, other_group);
                    if (other_group.end > other_group.start) {
                        end_matching_other = group.end;
                    }
                }
                if (groupsize == group.end - group.start) {
                    break;
                }
            }
            if (group.end != earliest_end && end_matching_other != -1) {
                while (other_group.end == other_group.start) {
                    group_slide_up(rchg, cls, group);
                    group_previous(rchg_other, other_group);
                }
            } else if (group.end != earliest_end && should_use_indent) {
                int shift = earliest_end;
                if (group.end - groupsize - 1 > shift) {
                    shift = group.end - groupsize - 1;
                }
                if (group.end - INDENT_HEURISTIC_MAX_SLIDING > shift) {
                    shift = group.end - INDENT_HEURISTIC_MAX_SLIDING;
                }
                int best_shift = -1;
                Score best = Score(0, 0);
                while (shift <= group.end) {
                    Score score = Score(0, 0);
                    score_add_split(measure_split(lines, shift), score);
                    score_add_split(measure_split(lines, shift - groupsize), score);
                    if (best_shift == -1 || score_cmp(score, best) <= 0) {
                        best = score;
                        best_shift = shift;
                    }
                    shift = shift + 1;
                }
                while (group.end > best_shift) {
                    group_slide_up(rchg, cls, group);
                    group_previous(rchg_other, other_group);
                }
            }
        }
        if (group_next(rchg, group)) {
            break;
        }
        group_next(rchg_other, other_group);
    }
}

// --- entry points --------------------------------------------------------------------

/// Compare two line lists the way xdiff does (Myers, with xdiff's cleanup,
/// heuristics and change-group compaction).
pub Diff diff_lines(List<bytes> lines_a, List<bytes> lines_b) {
    return diff_lines_with(lines_a, lines_b, false);
}

/// `diff_lines` the way `git diff` and `git blame` run it by default: with the
/// indent heuristic, which only changes where an ambiguous group of added or
/// removed lines is placed, never how many lines change.
pub Diff diff_lines_indent(List<bytes> lines_a, List<bytes> lines_b) {
    return diff_lines_with(lines_a, lines_b, true);
}

Diff diff_lines_with(List<bytes> lines_a, List<bytes> lines_b, bool should_use_indent) {
    int size_a = lines_a.size();
    int size_b = lines_b.size();
    Classes classes = classify(lines_a, lines_b);
    List<bool> flags_a = [false; size_a];
    List<bool> flags_b = [false; size_b];
    int lim = min_of(size_a, size_b);
    int dstart = 0;
    while (dstart < lim && classes.a[dstart] == classes.b[dstart]) {
        dstart = dstart + 1;
    }
    int suffix = 0;
    int room = lim - dstart;
    while (suffix < room && classes.a[size_a - 1 - suffix] == classes.b[size_b - 1 - suffix]) {
        suffix = suffix + 1;
    }
    List<int> keep_a = [];
    List<int> keep_b = [];
    List<int> from_a = [];
    List<int> from_b = [];
    discard(classes.a, classes.count_b, dstart, size_a - suffix - 1, flags_a, keep_a, from_a);
    discard(classes.b, classes.count_a, dstart, size_b - suffix - 1, flags_b, keep_b, from_b);
    int reduced_a = keep_a.size();
    int reduced_b = keep_b.size();
    int ndiags = reduced_a + reduced_b + 3;
    int mxcost = bogosqrt(ndiags);
    if (mxcost < MAX_COST_MIN) {
        mxcost = MAX_COST_MIN;
    }
    Env env = Env(keep_a, keep_b, from_a, from_b, flags_a, flags_b, [0; ndiags + 1], [0; ndiags + 1], reduced_b + 1, mxcost);
    env.recs_cmp(0, reduced_a, 0, reduced_b, false);
    compact(flags_a, classes.a, flags_b, lines_a, should_use_indent);
    compact(flags_b, classes.b, flags_a, lines_b, should_use_indent);
    return Diff(flags_a, flags_b, classes.a, classes.b);
}

/// The groups of changed lines in `d`, in order (xdl_build_script).
pub List<Edit> edits(Diff changes) {
    List<Edit> out = [];
    int size_a = changes.a_changed.size();
    int size_b = changes.b_changed.size();
    int index_a = 0;
    int index_b = 0;
    while (index_a < size_a || index_b < size_b) {
        if ((index_a < size_a && changes.a_changed[index_a]) || (index_b < size_b && changes.b_changed[index_b])) {
            int start_a = index_a;
            int start_b = index_b;
            while (index_a < size_a && changes.a_changed[index_a]) {
                index_a = index_a + 1;
            }
            while (index_b < size_b && changes.b_changed[index_b]) {
                index_b = index_b + 1;
            }
            out.push(Edit(start_a, index_a - start_a, start_b, index_b - start_b));
        } else {
            index_a = index_a + 1;
            index_b = index_b + 1;
        }
    }
    return out;
}

/// `a` against `b` as `lib/diff.m31`'s edit script: unchanged lines are
/// `Keep`, then each group's removed lines before its added lines.
pub List<diff.Op> ops(List<bytes> lines_a, List<bytes> lines_b) {
    Diff changes = diff_lines(lines_a, lines_b);
    List<diff.Op> out = [];
    int size_a = lines_a.size();
    int size_b = lines_b.size();
    int index_a = 0;
    int index_b = 0;
    while (index_a < size_a || index_b < size_b) {
        bool is_a_changed = index_a < size_a && changes.a_changed[index_a];
        bool is_b_changed = index_b < size_b && changes.b_changed[index_b];
        if (is_a_changed || is_b_changed) {
            while (index_a < size_a && changes.a_changed[index_a]) {
                out.push(diff.Op(diff.Kind.Remove, lines_a[index_a]));
                index_a = index_a + 1;
            }
            while (index_b < size_b && changes.b_changed[index_b]) {
                out.push(diff.Op(diff.Kind.Add, lines_b[index_b]));
                index_b = index_b + 1;
            }
        } else {
            out.push(diff.Op(diff.Kind.Keep, lines_a[index_a]));
            index_a = index_a + 1;
            index_b = index_b + 1;
        }
    }
    return out;
}

/// `diff.diff`, with the script xdiff picks instead of Myers' first shortest one:
/// `Binary` if either buffer looks binary (`diff.is_binary`), else `Lines` of
/// `ops` over their lines. This is what the diff view shows and what hunk
/// and line staging edit, so the hunks on screen are the ones `git diff` prints.
pub diff.Diff diff_text(bytes old, bytes new) {
    if (diff.is_binary(old) || diff.is_binary(new)) {
        return diff.Diff.Binary;
    }
    return diff.Diff.Lines(ops(split_lines(old), split_lines(new)));
}
