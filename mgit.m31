// The interactive client -- `docs/design.md`'s locked design, built, and since
// 0.25.0 split into five full-screen modes (`docs/MGIT-MODES.md`): Status,
// Commit, History, Branches and Stash, cycled with Tab, each with its own keys
// on a one-line hint row at the bottom, a help (`?`) and a command palette
// (`:`) generated from one table. Each is a scrollable, collapsible outline
// (or, for Commit, a panel) of what the mode is about; whole-file and hunk
// staging and unstaging; a commit; which-key menus for the follow-ups; and a
// synced jump list, toggled on demand.
//
//   bash scripts/build.sh                  # -> ./mgit
//   ./mgit [PATH] [--mouse on|off]     # PATH default: "."
//   ./mgit --help | --version | --completions bash|zsh|fish
//
// The command line is Oro's grammar (`lib/args`), like `1git`'s: two dashes
// are an option, anything else is data. There is no `--no-mouse`: that spelling
// is refused by the grammar, so the switch is a value, `--mouse off`.
//
// `PATH` is where the repository is, exactly like `git status` run from
// that directory -- it is not walked up through parents the way `1git`'s
// own `--git-dir` discovery is (`GIT_repository.find` still walks up to *find*
// `.git`, but the working tree this client reads and writes is `path`
// itself). Run it from the repository's own top level.
//
// This file is deliberately thin: every piece a test needs to call directly
// -- building the outline, staging or unstaging a path, stripping a commit
// message -- lives in `GIT_client.m31`, which has no top-level statements and
// can be imported. This is `tui's `browse.m31``'s own shape, one file
// further split because this program, unlike that demo, has a real test
// obligation for its logic (`docs/design.md`'s "how you'll know you're
// done").
//
// See `GIT_client.m31`'s own header, "launching `$EDITOR`, and the terminal
// handoff that takes", for why the loop below is a `while`, not a single
// `loop.run` call: `GIT_client.State.edit_message` cannot launch `$EDITOR`
// itself (it has no access to the `term.Session` `TUI_app.Loop.run` owns), so
// it sets `state.want_editor` and returns `Quit`, which unwinds that
// `Session` and hands the now-cooked, normal-screen terminal back here. This
// is the "drop the Session and re-acquire `raw()` afterward" a caller with
// no `suspend`/`restore` pair on the `Session` itself has to do: this loop
// notices `is_editor_wanted`, runs the editor for real (`launch_editor`), and
// calls `loop.run` again -- which re-enters raw mode and always draws its
// first frame with `TUI_diff.full`, never a diff against whatever the editor
// drew. A `q` (a real quit) leaves `is_editor_wanted` false and ends this loop
// too.

import fs;
import io;
import os;
import core.GIT_hash;
import core.GIT_repository;
import term;
import args;
import net.GIT_transport;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import ui.GIT_client;
import ui.GIT_ui_autorefresh;
import ui.GIT_ui_loop;
import ui.GIT_ui_sbs;

args.Parser parser = args.Parser("mgit", summary: "an interactive git client for the terminal: one outline of changes, staging and commits; branches, merges, rebases, stashes");
parser.version = GIT_transport.AGENT.substr(5, GIT_transport.AGENT.size);
parser.epilog = "the mouse is on unless the environment (M31GIT_MOUSE=off) or git config (mgit.mouse = off) says otherwise; --mouse overrides both\n" + "a terminal is needed: mgit reads the keyboard. Tab changes mode (Status, Commit, History, Branches, Stash), ? lists the keys of the one you are in, : opens a palette of every action.";
parser.optional("path", ".", help: "where the repository's work tree is (run it from the top level)", placeholder: "PATH");
parser.value("mouse", help: "mouse reports: on for the wheel and clicks, off to keep the terminal's own text selection", placeholder: "on|off");
parser.completions();
List<str> argv = os.arguments();
args.Parsed parsed = parser.parse_or_exit(argv.slice(1, argv.size()), status: 2);
str path = parsed.optional("path");
str mouse_choice = parsed.value("mouse").or("");
if (mouse_choice != "" && mouse_choice != "on" && mouse_choice != "off") {
    parser.fail("'--mouse' needs one of on, off, and got '" + mouse_choice + "'", status: 2);
}
str git_directory = GIT_repository.find(path);
if (git_directory == "") {
    io.eprint("mgit: not a git repository (or any parent up to /): no .git directory");
    os.exit(1);
}
str refusal = GIT_hash.refusal(git_directory);
if (refusal != "") {
    io.eprint("mgit: " + refusal);
    os.exit(1);
}
if (!term.is_terminal(0)) {
    io.eprint("mgit: standard input is not a terminal");
    os.exit(1);
}
GIT_client.State state = GIT_client.State.open(git_directory, path);
state.reload();
bool is_mouse = GIT_ui_sbs.is_mouse_on(git_directory);
if (mouse_choice != "") {
    is_mouse = mouse_choice == "on";
}
TUI_app.Loop loop = TUI_app.Loop(should_report_mouse: is_mouse);
GIT_ui_autorefresh.AutoRefresh refresher = GIT_ui_autorefresh.open(state.core());
bool is_running = true;
while (is_running) {
    match (GIT_ui_loop.run(loop, (TUI_buffer.Buffer buffer, TUI_geometry.Rect area) => state.draw(buffer, area), (term.Event event) => state.handle(event), refresher)) {
        case Ok(_): {
            if (state.is_editor_wanted) {
                state.launch_editor();
            } else {
                is_running = false;
            }
        }
        case Err(term.Error error): {
            io.eprint("mgit: " + error.to_str());
            is_running = false;
        }
    }
}
