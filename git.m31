// A read-only git plumbing client: `cat-file`, `ls-tree`, `log`, `rev-parse`
// and `refs`, over loose objects only.
//
//   bash scripts/build.sh git.m31 -o ourgit
//
//   ourgit -cat-file --type <object>
//   ourgit -cat-file --size <object>
//   ourgit -cat-file <object>              # --pretty is the default
//   ourgit -ls-tree <tree>
//   ourgit -log [--max N] [<rev>]
//   ourgit -rev-parse <rev>
//   ourgit -refs
//   ourgit [--git-dir DIR] ...             # default: `.git` here or above
//
// --- why the command is `-cat-file` and not `cat-file` ------------------------
//
// `lib/args` has one grammar and it is not git's: a command is `-word`, an
// option is `--word`, and anything else is data (its module header argues for
// this at length). So `git cat-file -t X` is spelled `ourgit -cat-file --type
// X` here. Writing git's own spelling would have meant not using `lib/args`,
// which was the point of the exercise; what it costs is that no muscle memory
// transfers. See docs/FRICTION.md.
//
// --- the output is git's, octet for octet -------------------------------------
//
// `scripts/compare.sh` runs each of these beside the real `git` on a real
// repository and diffs the bytes. Where this program prints something git
// does not, or spells a date differently, that script fails. Two deliberate
// pins, both because the alternative is a moving target rather than a format:
//
//   - abbreviated object names in a `Merge:` line are seven digits, where git
//     derives a length from how many objects the repository has. The
//     comparison runs git with `-c core.abbrev=7`.
//   - there is no `.mailmap`, no `log.decorate`, no colour and no pager,
//     because there is no configuration at all.

import args;
import io;
import os;
import fs;
import date;
import text;
import GIT_object;
import GIT_refs;
import GIT_repository;
import GIT_log;

args.Parser parser = args.Parser("ourgit", summary: "read-only git plumbing over loose objects");
parser.value("git-dir", help: "the repository's git directory", placeholder: "DIR");
args.Parser cat = parser.command("cat-file", "print an object's type, size or contents");
cat.flag("type", help: "print the object's type word");
cat.flag("size", help: "print the size of the object's content");
cat.flag("pretty", help: "print the object itself (the default)");
cat.positional("object", help: "an object name, or an unambiguous prefix of one", placeholder: "OBJECT");
args.Parser list_command = parser.command("ls-tree", "list a tree's entries");
list_command.positional("tree", help: "a tree, or a commit whose tree to list", placeholder: "TREE");
args.Parser log_command = parser.command("log", "commits reachable from a revision, newest commit date first");
log_command.integer("max", help: "stop after this many commits", placeholder: "N");
log_command.optional("rev", "HEAD", help: "where to start", placeholder: "REV");
args.Parser rev_parse_command = parser.command("rev-parse", "the object name a revision resolves to");
rev_parse_command.positional("rev", help: "a ref, or an object name", placeholder: "REV");
args.Parser refs_command = parser.command("refs", "every ref in the repository, with what it points at");
List<str> argv = os.args();
match (parser.parse(argv.slice(1, argv.size()))) {
    case Ok(args.Parsed parsed): {
        match (parsed.help()) {
            case Some(str help_text): {
                print(help_text);
            }
            case None: {
                os.exit(dispatch(parser, parsed));
            }
        }
    }
    case Err(args.UsageError error): {
        io.eprint(error.to_str());
        io.eprint(parser.usage());
        os.exit(2);
    }
}

/// Run every command on the line, in the order it was typed. The exit status
/// is 0 only if all of them worked.
///
/// The parser is a parameter because it cannot be anything else: it is built
/// at the top level, and the top level's variables are locals of the program
/// body that no function can see (reference §2). There is no module state to
/// put it in. See docs/FRICTION.md.
int dispatch(args.Parser parser, args.Parsed parsed) {
    str git_directory = "";
    match (parsed.value("git-dir")) {
        case Some(str directory): {
            git_directory = directory;
        }
        case None: {
            match (discover(".")) {
                case Some(str directory): {
                    git_directory = directory;
                }
                case None: {
                    io.eprint("not a git repository (or any parent up to /): no .git directory");
                    return 128;
                }
            }
        }
    }
    List<args.Parsed> cmds = parsed.commands();
    if (cmds.size() == 0) {
        io.eprint(parser.usage());
        return 2;
    }
    int status = 0;
    for (args.Parsed parsed_command in cmds) {
        int exit_code = 0;
        if (parsed_command.word() == "cat-file") {
            exit_code = cat_file(git_directory, parsed_command);
        } else if (parsed_command.word() == "ls-tree") {
            exit_code = ls_tree(git_directory, parsed_command.positional("tree"));
        } else if (parsed_command.word() == "log") {
            exit_code = log(git_directory, parsed_command);
        } else if (parsed_command.word() == "rev-parse") {
            exit_code = rev_parse(git_directory, parsed_command.positional("rev"));
        } else {
            exit_code = list_refs(git_directory);
        }
        if (exit_code != 0) {
            status = exit_code;
        }
    }
    return status;
}

// --- the commands ------------------------------------------------------------

int cat_file(str git_directory, args.Parsed parsed_command) {
    str spec = parsed_command.positional("object");
    str id = "";
    match (GIT_refs.rev_parse(git_directory, spec)) {
        case Ok(str resolved): {
            id = resolved;
        }
        case Err(GIT_refs.Error error): {
            io.eprint(error.to_str());
            return 1;
        }
    }
    match (GIT_object.read(git_directory, id)) {
        case Ok(GIT_object.Object object): {
            if (parsed_command.flag("type")) {
                say(object.kind());
                return 0;
            }
            if (parsed_command.flag("size")) {
                say(object.raw.size().to_str());
                return 0;
            }
            match (object.body) {
                case Tree(List<GIT_object.Entry> entries): {
                    write(tree_text(entries));
                }
                case Blob: {
                    write(object.raw);
                }
                case Commit: {
                    write(object.raw);
                }
                case Tag: {
                    write(object.raw);
                }
            }
            return 0;
        }
        case Err(GIT_object.Error error): {
            io.eprint(error.to_str());
            return 1;
        }
    }
}

int ls_tree(str git_directory, str spec) {
    str id = "";
    match (GIT_refs.rev_parse(git_directory, spec)) {
        case Ok(str resolved): {
            id = resolved;
        }
        case Err(GIT_refs.Error error): {
            io.eprint(error.to_str());
            return 1;
        }
    }
    // `git ls-tree` takes a tree-ish, so a commit means its tree. A tag is
    // peeled to a commit first, and then the same rule applies.
    for (int hops in 0 .. 12) {
        match (GIT_object.read(git_directory, id)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Tree(List<GIT_object.Entry> entries): {
                        write(tree_text(entries));
                        return 0;
                    }
                    case Commit(GIT_object.Commit commit): {
                        id = commit.tree;
                    }
                    case Tag(GIT_object.Tag tag): {
                        id = tag.object;
                    }
                    case Blob: {
                        io.eprint("not a tree object: " + spec);
                        return 1;
                    }
                }
            }
            case Err(GIT_object.Error error): {
                io.eprint(error.to_str());
                return 1;
            }
        }
    }
    io.eprint("not a tree object: " + spec);
    return 1;
}

int rev_parse(str git_directory, str spec) {
    match (GIT_refs.rev_parse(git_directory, spec)) {
        case Ok(str id): {
            say(id);
            return 0;
        }
        case Err(GIT_refs.Error error): {
            io.eprint(error.to_str());
            return 1;
        }
    }
}

int list_refs(str git_directory) {
    match (GIT_refs.all(git_directory)) {
        case Ok(List<GIT_refs.Ref> ref_list): {
            for (GIT_refs.Ref one in ref_list) {
                say(one.id + " " + one.name);
            }
            return 0;
        }
        case Err(GIT_refs.Error error): {
            io.eprint(error.to_str());
            return 1;
        }
    }
}

int log(str git_directory, args.Parsed parsed_command) {
    str spec = parsed_command.optional("rev");
    int limit = -1;
    match (parsed_command.integer("max")) {
        case Some(int maximum): {
            limit = maximum;
        }
        case None: {
        }
    }
    // The walk itself -- git's date-ordered queue -- lives in `GIT_log.m31`
    // now, shared with the interactive client (`gitui.m31`) so there is one
    // implementation of it rather than two (`docs/design.md`).
    match (GIT_log.walk(git_directory, spec, limit)) {
        case Ok(List<GIT_log.Entry> entries): {
            int shown = 0;
            for (GIT_log.Entry entry in entries) {
                // The blank line goes BETWEEN commits and not after each one:
                // git separates rather than terminates, so `log` of one
                // commit ends at the last line of its message.
                if (shown > 0) {
                    write("\n".to_bytes());
                }
                write(commit_text(entry.id, entry.commit));
                shown = shown + 1;
            }
            return 0;
        }
        case Err(GIT_log.Error error): {
            io.eprint(error.to_str());
            return 1;
        }
    }
}

// --- formatting ---------------------------------------------------------------

// `git ls-tree` and `git cat-file -p` on a tree print the same four fields:
// the six-digit mode, the type word, the object name, a TAB, and the name --
// quoted if it needs it, which is why this builds `bytes` and not a `str`.
bytes tree_text(List<GIT_object.Entry> entries) {
    bytes output = [];
    for (GIT_object.Entry entry in entries) {
        output.extend((entry.mode_text() + " " + entry.type_word() + " " + entry.id + "\t").to_bytes());
        output.extend(quoted(entry.name));
        output.push('\n');
    }
    return output;
}

// git's `quote_c_style`, which is what `core.quotePath` turns on and which
// is on by default.
//
// A name with nothing unusual in it is printed as it is. One containing a
// control character, a quote, a backslash, DEL, or any octet from 0x80 up is
// wrapped in double quotes and escaped C-style: the seven named escapes where
// there is one, a three-digit octal otherwise. So a UTF-8 name comes out as
// `"caf\303\251.txt"` -- the octets, not the characters, because git has no
// more idea than this does what encoding a path is in.
bytes quoted(bytes name) {
    bool is_needed = false;
    for (int byte_value in name) {
        if (byte_value < ' ' || byte_value == '"' || byte_value == '\\' || byte_value >= 127) {
            is_needed = true;
        }
    }
    if (!is_needed) {
        return name;
    }
    bytes output = [];
    output.push('"');
    for (int byte_value in name) {
        if (byte_value == 7) {
            escape(output, 97);
        } else if (byte_value == 8) {
            escape(output, 98);
        } else if (byte_value == '\t') {
            escape(output, 116);
        } else if (byte_value == '\n') {
            escape(output, 110);
        } else if (byte_value == 11) {
            escape(output, 118);
        } else if (byte_value == 12) {
            escape(output, 102);
        } else if (byte_value == '\r') {
            escape(output, 114);
        } else if (byte_value == '"' || byte_value == '\\') {
            escape(output, byte_value);
        } else if (byte_value < ' ' || byte_value >= 127) {
            output.push('\\');
            output.push(48 + (byte_value >> 6 & 7));
            output.push(48 + (byte_value >> 3 & 7));
            output.push(48 + (byte_value & 7));
        } else {
            output.push(byte_value);
        }
    }
    output.push('"');
    return output;
}

void escape(bytes output, int byte_value) {
    output.push('\\');
    output.push(byte_value);
}

// One commit in `git log`'s default format.
bytes commit_text(str id, GIT_object.Commit commit) {
    bytes output = [];
    output.extend(("commit " + id + "\n").to_bytes());
    if (commit.parents.size() > 1) {
        str line = "Merge:";
        for (str par in commit.parents) {
            line = line + " " + par.substr(0, 7);
        }
        output.extend((line + "\n").to_bytes());
    }
    output.extend("Author: ".to_bytes());
    output.extend(commit.author.name);
    output.extend(" <".to_bytes());
    output.extend(commit.author.email);
    output.extend((">\nDate:   " + stamp(commit.author) + "\n\n").to_bytes());
    output.extend(indented(commit.message));
    // git's `pretty_print_commit` trims trailing whitespace from the WHOLE
    // buffer and then `show_log` writes one newline. That is why a commit
    // whose message ends in blank lines shows none of them, why trailing
    // spaces on the last line are gone while the same spaces on a blank line
    // in the middle survive as an indent, and why a commit with no message at
    // all has no blank line after its `Date:`.
    int length = output.size();
    while (length > 0 && is_blank_octet(output[length - 1])) {
        length = length - 1;
    }
    output.truncate(length);
    output.push('\n');
    return output;
}

bool is_blank_octet(int byte_value) {
    return byte_value == ' ' || byte_value == '\t' || byte_value == '\n' || byte_value == '\r' || byte_value == 11 || byte_value == 12;
}

const Array<str> WEEKDAY = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const Array<str> MONTH = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// `Tue Nov 14 21:43:20 2023 +0530`, which is git's `show_date` under
// `DATE_NORMAL`: the wall clock in the author's own zone, then the zone.
//
// The zone comes from the offset in minutes and not from the four characters
// the commit stored, because git does the same: it parses the field into a
// number and prints `%+05d` of it, so a commit written `-0000` prints
// `+0000`.
str stamp(GIT_object.Ident who) {
    date.Civil civil_time = date.civil(who.when + who.offset * 60);
    return WEEKDAY[civil_time.weekday] + " " + MONTH[civil_time.month - 1] + " " + civil_time.day.to_str() + " " + two(civil_time.hour) + ":" + two(civil_time.minute) + ":" + two(civil_time.second) + " " + civil_time.year.to_str() + " " + zone(who.offset);
}

str two(int number) {
    if (number < 10) {
        return "0" + number.to_str();
    }
    return number.to_str();
}

str zone(int minutes) {
    int absolute_minutes = minutes;
    str sign = "+";
    if (absolute_minutes < 0) {
        sign = "-";
        absolute_minutes = 0 - absolute_minutes;
    }
    return sign + two(absolute_minutes / 60) + two(absolute_minutes % 60);
}

// git's `pp_remainder` at indent 4, which is the `medium` format's body.
//
// Three rules, each of which is visible in `git log` and none of which is
// obvious:
//
//   - blank lines at the START of the message are dropped;
//   - a line that is ENTIRELY whitespace becomes the indent and nothing else,
//     so it comes out as four spaces -- trailing spaces on a line that has
//     content are left alone;
//   - TABS are expanded to the next multiple of eight, counting from the
//     start of the line's own text and NOT counting the four-space indent.
//     This is `--expand-tabs`, which is on by default for exactly the formats
//     that indent, and it is why `#\tsrc/lower.rs` in a commit message prints
//     with seven spaces and not with three.
bytes indented(bytes message) {
    bytes output = [];
    int position = 0;
    int length = message.size();
    bool is_first = true;
    while (position < length) {
        int line_end = position;
        while (line_end < length && message[line_end] != '\n') {
            line_end = line_end + 1;
        }
        int end = line_end;
        bool is_empty = true;
        for (int index in position .. line_end) {
            if (!is_blank_octet(message[index])) {
                is_empty = false;
            }
        }
        if (is_empty) {
            end = position;
            if (is_first) {
                position = line_end + 1;
                continue;
            }
        }
        is_first = false;
        output.extend("    ".to_bytes());
        int col = 0;
        for (int i in position .. end) {
            int byte_value = message[i];
            if (byte_value == '\t') {
                int width = 8 - col % 8;
                for (int j in 0 .. width) {
                    output.push(' ');
                }
                col = col + width;
            } else {
                output.push(byte_value);
                col = col + 1;
            }
        }
        output.push('\n');
        position = line_end + 1;
    }
    return output;
}

// --- plumbing ------------------------------------------------------------------

void say(str message) {
    write((message + "\n").to_bytes());
}

void write(bytes data) {
    // `io.stdout()` afresh on every call, for the same reason `dispatch`
    // takes its parser as a parameter: a `File` held in a top-level local is
    // invisible inside a function, and the alternative was threading one
    // through every function that can print. It is safe -- closing a standard
    // stream's `File` marks that `File` closed and leaves the descriptor
    // alone (`lib/io.m31`, `File.release`).
    io.File out = io.stdout();
    match (out.write(data)) {
        case Ok: {
        }
        case Err: {
            // Standard output that will take no more is the end of the
            // program, not something to report through it -- a closed pipe is
            // the ordinary case, and git exits quietly on one too.
            os.exit(0);
        }
    }
}

// `.git` here, or in a parent, or the bare repository this already is.
Option<str> discover(str from) {
    str found = GIT_repository.find(from);
    if (found == "") {
        return Option<str>.None;
    }
    return Option<str>.Some(found);
}
