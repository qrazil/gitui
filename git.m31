// 1git: a git client with a command line of its own. The repository format,
// the wire protocols and the output of the read commands are git's (octet for
// octet, `scripts/compare_*.sh` diffs them against the real `git`); the way
// you ask is Oro's grammar: one dash is a command, two dashes an option,
// anything else data.
//
//   bash scripts/build.sh git.m31 -o 1git
//
//   1git -status
//   1git -log --max 5 --oneline
//   1git -add --all -commit --message "fix the parser" -push
//   1git -log --help
//   1git --help
//
// This file only hands the command line over. The commands are declared in
// `core/GIT_clitable.m31` (one table: the parser, the translation to the
// command functions, the migration from git's own spelling) and run by
// `core/GIT_cli.m31`. docs/CLI.md is the design.

import os;
import core.GIT_cli;

List<str> argv = os.arguments();
os.exit(GIT_cli.start(argv.slice(1, argv.size())));
