/// Pull the current branch from `origin`, fast-forward only (`GIT_pull.pull`):
/// refused on a dirty tree and on a diverged branch. The outcome is the
/// status line's message.
pub void State.pull_current() {
    is_pull_open = false;
    Option<str> url = GIT_config.get(gitdir, "remote", "origin", "url");
    if (!url.is_some()) {
        message = "pull: no remote 'origin' in .git/config";
        return;
    }
    GIT_http_push.Remote remote = GIT_http_push.Remote("", Option<GIT_http_push.Credentials>.None);
    match (GIT_http_push.parse_remote(url.or(""))) {
        case Ok(GIT_http_push.Remote parsed): {
            remote = parsed;
        }
        case Err(GIT_http_push.Error error): {
            message = "pull: " + error.to_str();
            return;
        }
    }
    match (GIT_pull.pull(gitdir, worktree, remote)) {
        case Ok(GIT_pull.Outcome outcome): {
            if (outcome.has_moved) {
                message = "pulled: fast-forwarded " + outcome.old_id.substr(0, 7) + ".." + outcome.new_id.substr(0, 7);
            } else {
                message = "pull: already up to date";
            }
        }
        case Err(GIT_pull.Error error): {
            message = "pull: " + error.to_str();
        }
    }
    reload();
}

