        case Home: {
            return TUI_app.Action.Continue;
        }
        case End: {
            return TUI_app.Action.Continue;
        }
        case PageUp: {
            return TUI_app.Action.Continue;
        }
        case PageDown: {
            return TUI_app.Action.Continue;
        }
        case Insert: {
            return TUI_app.Action.Continue;
        }
        case Delete: {
            return TUI_app.Action.Continue;
