TUI_app.Action State.handle_commit_key(term.Code code) {
    match (code) {
        case Char(int character): {
            if (character == 'e') {
                edit_message();
                // `Quit` unwinds `TUI_app.Loop.run`'s own `Session`, which is
                // what actually leaves raw mode and the alternate screen --
                // see `edit_message`'s own header. `gitui.m31`'s driver
                // reads `is_editor_wanted` on the way out and calls `Loop.run`
                // again once `launch_editor` is done.
                return TUI_app.Action.Quit;
            }
            if (character == 'f') {
                finish_commit();
                return TUI_app.Action.Redraw;
            }
            if (character == 'a') {
                abort_commit();
                return TUI_app.Action.Redraw;
            }
            if (character == 'A') {
                start_amend();
                return TUI_app.Action.Redraw;
            }
            return TUI_app.Action.Continue;
        }
        case Escape: {
            abort_commit();
            return TUI_app.Action.Redraw;
        }
        case Enter: {
            return TUI_app.Action.Continue;
        }
        case Backspace: {
            return TUI_app.Action.Continue;
        }
        case Tab: {
            return TUI_app.Action.Continue;
        }
        case BackTab: {
            return TUI_app.Action.Continue;
        }
        case Up: {
            return TUI_app.Action.Continue;
        }
        case Down: {
            return TUI_app.Action.Continue;
        }
        case Right: {
            return TUI_app.Action.Continue;
        }
        case Left: {
            return TUI_app.Action.Continue;
        }
        case Home: {
            return TUI_app.Action.Continue;
        }
        case End: {
            return TUI_app.Action.Continue;
        }
        case PageUp: {
            return TUI_app.Action.Continue;
        }
        case PageDown: {
            return TUI_app.Action.Continue;
        }
        case Insert: {
            return TUI_app.Action.Continue;
        }
        case Delete: {
            return TUI_app.Action.Continue;
        }
        case F(_): {
            return TUI_app.Action.Continue;
        }
    }
}

/// The `x` confirmation: `y` discards what `discard_current` recorded, and
/// every other key -- any character, Escape, Enter, an arrow -- cancels.
/// Deliberately not "n to cancel": a prompt that only acts on one exact key
/// cannot be fallen into by a keystroke meant for the outline underneath.
TUI_app.Action State.handle_confirm_key(term.Code code) {
    str kind = confirm_kind;
    bytes relative_path = confirm_path;
    is_confirm_open = false;
    confirm_kind = "";
    confirm_path = [];
    match (code) {
        case Char(int character): {
            if (character == 'y') {
                discard_path(kind, relative_path);
                return TUI_app.Action.Redraw;
            }
        }
        case Escape: {
        }
        case Enter: {
        }
        case Backspace: {
        }
        case Tab: {
        }
        case BackTab: {
        }
        case Up: {
        }
        case Down: {
        }
        case Right: {
        }
        case Left: {
        }
        case Home: {
        }
        case End: {
        }
        case PageUp: {
        }
        case PageDown: {
        }
        case Insert: {
        }
        case Delete: {
        }
        case F(_): {
        }
    }
    message = "discard cancelled";
    return TUI_app.Action.Redraw;
}

/// Keys while the diff view is showing: `j`/`k`/the arrows move its cursor
/// The `b` overlay's keys: `c` checks out the branch under the cursor, `n`
/// starts a new one (via `$EDITOR`, the same `Quit`-then-relaunch dance
/// `handle_commit_key`'s `e` does), `a`/`Escape` close it. Anything else is
/// swallowed while the overlay is up, exactly like the commit overlay.
TUI_app.Action State.handle_branch_key(term.Code code) {
    match (code) {
        case Char(int character): {
            if (character == 'c') {
                is_branch_open = false;
                checkout_current();
                return TUI_app.Action.Redraw;
            }
            if (character == 'n') {
                is_branch_open = false;
                new_branch();
                if (is_editor_wanted) {
                    return TUI_app.Action.Quit;
                }
                return TUI_app.Action.Redraw;
            }
            if (character == 'a') {
                is_branch_open = false;
                return TUI_app.Action.Redraw;
            }
            return TUI_app.Action.Continue;
        }
        case Escape: {
            is_branch_open = false;
            return TUI_app.Action.Redraw;
        }
        case Enter: {
            return TUI_app.Action.Continue;
        }
        case Backspace: {
            return TUI_app.Action.Continue;
        }
        case Tab: {
            return TUI_app.Action.Continue;
        }
        case BackTab: {
            return TUI_app.Action.Continue;
        }
        case Up: {
            return TUI_app.Action.Continue;
        }
        case Down: {
            return TUI_app.Action.Continue;
        }
        case Right: {
            return TUI_app.Action.Continue;
        }
        case Left: {
            return TUI_app.Action.Continue;
