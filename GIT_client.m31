}

/// (`DiffView.move`, which is what keeps `at()` meaningful), and `q`,
/// `Escape` and `Backspace` all back out to the outline (`close_diff`).
/// `Backspace` is the "go back" key `tui's `browse.m31``'s own directory
/// descent already uses (see its `up`); `q` and `Escape` join it because a
/// drilled-into diff is what a reader stepping through history opens and
/// closes most, and the key that closes everything else they open here (the
/// commit popup's `Escape`, the program's own `q`) is what their hands reach
/// for -- quitting the whole program from inside a diff was the one place
/// that surprised. `q` in the outline still quits.
TUI_app.Action State.handle_diff_key(term.Code code) {
    match (code) {
        case Char(int character): {
            if (character == 'q') {
                close_diff();
                return TUI_app.Action.Redraw;
            }
            if (character == 'j') {
                diff_view.move(1);
                return TUI_app.Action.Redraw;
            }
            if (character == 'k') {
                diff_view.move(-1);
                return TUI_app.Action.Redraw;
            }
            if (character == 's') {
                stage_hunk_current();
                return TUI_app.Action.Redraw;
            }
            if (character == 'u') {
                unstage_hunk_current();
                return TUI_app.Action.Redraw;
            }
            return TUI_app.Action.Continue;
        }
        case Backspace: {
            close_diff();
            return TUI_app.Action.Redraw;
        }
        case Escape: {
            close_diff();
            return TUI_app.Action.Redraw;
        }
        case Up: {
            diff_view.move(-1);
            return TUI_app.Action.Redraw;
        }
        case Down: {
            diff_view.move(1);
            return TUI_app.Action.Redraw;
        }
        case Enter: {
            return TUI_app.Action.Continue;
        }
        case Tab: {
            return TUI_app.Action.Continue;
        }
        case BackTab: {
            return TUI_app.Action.Continue;
        }
        case Right: {
            return TUI_app.Action.Continue;
        }
        case Left: {
            return TUI_app.Action.Continue;
        }
        case Home: {
            return TUI_app.Action.Continue;
        }
        case End: {
            return TUI_app.Action.Continue;
        }
        case PageUp: {
            return TUI_app.Action.Continue;
        }
        case PageDown: {
            return TUI_app.Action.Continue;
        }
        case Insert: {
            return TUI_app.Action.Continue;
        }
        case Delete: {
            return TUI_app.Action.Continue;
        }
        case F(_): {
            return TUI_app.Action.Continue;
        }
    }
}

/// The commit a row id belongs to, if it is a commit's own section row or
/// its "Files changed" subsection -- the two rows whose unfolding is what
/// first needs that commit's file list. `commit:<40 hex>` or
/// `commit:<40 hex>:files`; every other id (a file row, an author/date/
/// message leaf, any other section) answers `None`.
Option<str> commit_id_of_unfoldable(str id) {
    if (!id.starts_with("commit:") || id.size() < 47) {
        return Option<str>.None;
    }
    str cid = id.substr(7, 47);
    if (id == "commit:" + cid || id == "commit:" + cid + ":files") {
        return Option<str>.Some(cid);
    }
    return Option<str>.None;
}

/// The directory part of a slash-separated path, `.` for a bare name --
/// `GIT_http_fetch.m31`'s own `directory_of`, private to it, repeated here rather than
/// exported from a module about the wire protocol.
str directory_of(str path) {
    int index = path.size() - 1;
    while (index >= 0 && path.byte_at(index) != '/') {
        index = index - 1;
    }
    if (index < 0) {
        return ".";
    }
    return path.substr(0, index);
}

/// `path`'s entry in `ix`, if it has one.
Option<GIT_index.Entry> find_index_entry(GIT_index.Index index, bytes path) {
    int entry_index = 0;
    while (entry_index < index.entries.size()) {
        if (is_bytes_equal(index.entries[entry_index].path, path)) {
            return Option<GIT_index.Entry>.Some(index.entries[entry_index]);
        }
        entry_index = entry_index + 1;
    }
    return Option<GIT_index.Entry>.None;
}

/// Which command real git's own editor flow would launch: `$EDITOR` if it is
/// set, `vi` otherwise -- git's own fallback (`core.editor` and `$VISUAL`
/// come before `vi` in real git's own chain, but both come from
/// `.git/config`, which this client already does not read, `GIT_object.m31`'s
/// own README names that gap). Pure and total, so `t_gitclient.m31` can
/// check it with no environment and no process at all.
pub str pick_editor(Option<str> env_editor) {
    return env_editor.or("vi");
}

str branch_name(str full) {
    str prefix = "refs/heads/";
    if (full.starts_with(prefix)) {
        return full.substr(prefix.size(), full.size());
    }
    return full;
}

// --- index helpers shared by whole-file (stage_path/unstage_path) and hunk-level staging --

GIT_index.Index read_index(str gitdir) {
    match (GIT_index.read(gitdir)) {
        case Ok(GIT_index.Index index): {
            return index;
        }
        case Err: {
            return GIT_index.Index([]);
        }
    }
}

void replace_entry(GIT_index.Index index, GIT_index.Entry entry) {
    int entry_index = 0;
    while (entry_index < index.entries.size()) {
        if (is_bytes_equal(index.entries[entry_index].path, entry.path)) {
            index.entries[entry_index] = entry;
            return;
        }
        entry_index = entry_index + 1;
    }
    index.entries.push(entry);
}

void remove_entry(GIT_index.Index index, bytes path) {
    int entry_index = 0;
    while (entry_index < index.entries.size()) {
        if (is_bytes_equal(index.entries[entry_index].path, path)) {
            index.entries.remove_at(entry_index);
            return;
        }
        entry_index = entry_index + 1;
    }
}

// --- committing ---------------------------------------------------------------

// No `.git/config` is read anywhere in this program (`GIT_object.m31`'s own
// README names this gap); `GIT_AUTHOR_*`/`GIT_COMMITTER_*` are the one
// identity source this client has, the same environment variables real git
// itself honours over its config. `date.now()` is UTC-only
// (`lib/date.m31`'s own header), so every commit this client writes is
// timestamped `+0000`.
GIT_object.Ident author_ident() {
    str who = os.env("GIT_AUTHOR_NAME").or(os.env("USER").or("unknown"));
    str mail = os.env("GIT_AUTHOR_EMAIL").or(who + "@localhost");
    return GIT_object.Ident(who.to_bytes(), mail.to_bytes(), date.now(), 0, "+0000");
}

GIT_object.Ident committer_ident() {
    str who = os.env("GIT_COMMITTER_NAME").or(os.env("USER").or("unknown"));
    str mail = os.env("GIT_COMMITTER_EMAIL").or(who + "@localhost");
    return GIT_object.Ident(who.to_bytes(), mail.to_bytes(), date.now(), 0, "+0000");
}

// --- drawing and input --------------------------------------------------------
