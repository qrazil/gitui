// The interactive client's own state and logic, split out of `gitui.m31` so
// it is importable and unit-testable the way `t_status.m31`/`t_index_stage.m31`
// test `GIT_status.m31`/`GIT_index.m31` directly -- a top-level statement anywhere in
// an imported file is refused (`docs/reference.md` §2), so anything this
// program needs a test harness to call has to live here rather than in the
// `.m31` that actually runs the terminal loop.
//
// `gitui.m31` is the thin driver: parse a path off the command line, build a
// `State`, and hand it to `TUI_app.Loop` exactly as `tui's `browse.m31``
// hands its own `State` to the same loop. Everything a test needs --
// building the outline from a `GIT_status.Status`, staging or unstaging one
// path, stripping a commit message down to what git would actually commit --
// is a method or a free function here, callable with no terminal in sight.
//
// See `docs/design.md`'s "Starting the client" for the scope this
// implements: whole-file staging, a commit via an externally edited message
// file, and the outline/jump-list/which-key/footer wiring the locked design
// names, plus hunk-level staging in the diff view (`GIT_patch.m31`, the
// `git add -p`/`git reset -p` half that section named as the follow-up).
// Push/pull, checkout and rebase are each a named, deliberate gap there,
// not an oversight here.
//
// --- launching `$EDITOR`, and the terminal handoff that takes ---------------
//
// `lib/os.m31` gained `os.run`/`ExitStatus` (`docs/sys-layer.md`'s "Process
// launch", added the same day as this) after this client first shipped with
// only the on-disk contract below -- a message file at a known path
// (`COMMIT_EDITMSG`, git's own name), edited by *something*, read back and
// refused if empty after stripping comments. `os.run` is now that
// "something": the which-key overlay's `e` actually launches `$EDITOR` (`vi`
// if unset, real git's own fallback) on `commit_message_path`.
//
// The wrinkle `os.run`'s own header does not have to solve, and this client
// does: `os.run` leaves stdin/stdout/stderr untouched precisely so an
// interactive child can take over the real terminal, but this program has
// already put that terminal in raw mode with the alternate screen on
// (`TUI_app.Loop.run`'s own `enter`/`leave` sequences) -- the wrong mode for
// an editor expecting a normal, cooked terminal to draw on. `lib/term.m31`'s
// `Session` is exactly the value that knows how to undo that (`restore()`,
// idempotent, called from its own destructor), but `Loop.run` holds it in
// its own function scope and hands a caller only an `Action`
// (`Continue`/`Redraw`/`Quit`) -- there is no `Suspend` a `Handler` can ask
// for, and adding one to that enum would ripple through every `match` on
// `Action` in `tui`, which this task does not own.
//
// So `edit_message` does not call `os.run` itself. It sets `is_editor_wanted` and
// returns `Quit` from the which-key's `e`, which unwinds `Loop.run` exactly
// as a real quit would: the `Session` goes out of scope, its destructor
// calls `restore()`, and the terminal is back in the ORIGINAL cooked mode
// `raw()` snapshotted before it ever touched termios, alternate screen
// already turned off by the `leave` sequence `Loop.run` registered with
// `on_exit`. That is the drop half of "drop the Session and re-acquire
// `raw()` afterward" -- `gitui.m31`'s own top-level driver, watching
// `is_editor_wanted`, is what does both: it runs `os.run` for real now that the
// terminal is cooked and on the normal screen, calls `launch_editor` to
// interpret the result, and -- unless the loop actually asked to quit --
// calls `Loop.run` again. That is the re-acquire half: a fresh `raw()` call,
// and a first frame `Loop.run` always draws with `TUI_diff.full` rather than
// a diff against whatever the editor left on screen.
//
// `f` (finish) and `a` (abort) are untouched: `launch_editor` reuses
// `finish_commit` verbatim for a successful edit (exit 0, non-empty
// message), so the "same stripping/empty-message-refusal logic" runs from
// exactly one place either way. A nonzero exit or a signal is treated as a
// cancelled edit -- `is_commit_open` stays true and the message file is left
// alone, so `e` can be pressed again, `f` can still try to finish whatever
// is on disk, and `a` can still discard it. `os.run` itself returning `Err`
// -- no `$EDITOR`, no `vi`, nothing nowhere on `$PATH` -- falls back to
// exactly the original behaviour: the template is already on disk (written
// before the launch attempt, same as before), and the operator is told to
// edit it externally and press `f`.

import GIT_checkout;
import date;
import fs;
import GIT_config;
import GIT_log;
import GIT_http_push;
import GIT_hunks;
import GIT_patch;
import GIT_index;
import io;
import GIT_object;
import os;
import GIT_pull;
import GIT_refs;
import GIT_status;
import term;
import text;
import tui.TUI_buffer;
import tui.TUI_diff_view;
import tui.TUI_footer;
import tui.TUI_geometry;
import tui.TUI_jump_list;
import tui.TUI_menu;
import tui.TUI_outline;
import tui.TUI_text;
import tui.TUI_widget;
import tui.TUI_style;
import tui.TUI_app;

/// One row of a change list (`GIT_status.Status.staged`/`.unstaged`, or
/// `.untracked`), ready to sort and to show: `path` is what a human reads,
/// `raw` is the exact bytes staging/unstaging needs, and `mark` is the
/// status letter (`'A'`, `'M'`, `'D'`) or `0` for an untracked path, which
/// has none.
type PathRow {
    str path;
    bytes raw;
    int mark;
}

int PathRow.cmp(PathRow other) {
    return str_cmp(path, other.path);
}

/// One row of the outline's "Branches" section: the branch, and its tip's
/// short id and first message line -- read once, in `State.refresh`, so
/// `build_outline` stays free of I/O (its own header's promise).
pub type BranchRow {
    pub GIT_checkout.Branch branch;
    pub str subject;
}

/// One file a commit changed against its first parent (`commit_changes`,
/// below): `old_id`/`new_id` are the two blob ids `show_diff_current`'s own
/// commit-file branch reads to build the diff, `None` on whichever side the
/// path did not exist (an add has no `old_id`, a delete has no `new_id`).
/// `insertions`/`deletions` are exact line counts from the same
/// `GIT_hunks.hunks` call `show_diff_current` itself would make -- computed in
/// `commit_changes`, once per commit, the first time it is unfolded, so the
/// stat the outline shows next to a file never disagrees with the diff
/// `Enter` opens on it. `is_binary` is `GIT_hunks.hunks` reporting `Binary` for this pair;
/// `insertions`/`deletions` are both 0 then, the same "nothing to count"
/// `open_diff`'s own `is_diff_binary` path already means elsewhere.
pub type CommitFileDiff {
    pub bytes path;
    pub GIT_status.Change kind;
    pub Option<str> old_id;
    pub Option<str> new_id;
    pub bool is_binary;
    pub int insertions;
    pub int deletions;
}

// `str` has no ordering operator (`GIT_refs.m31`'s own `before`, the same
// reason, written out again here because a type with a `str` field has to
// supply its own `cmp` and there is nothing to call).
int str_cmp(str left, str right) {
    int length = left.size();
    if (right.size() < length) {
        length = right.size();
    }
    for (int i in 0 .. length) {
        int x = left.byte_at(i);
        int y = right.byte_at(i);
        if (x != y) {
            return x - y;
        }
    }
    return left.size() - right.size();
}

int cmp_bytes(bytes left, bytes right) {
    int length = left.size();
    if (right.size() < length) {
        length = right.size();
    }
    for (int i in 0 .. length) {
        if (left[i] != right[i]) {
            return left[i] - right[i];
        }
    }
    return left.size() - right.size();
}

bool is_bytes_equal(bytes left, bytes right) {
    return left.size() == right.size() && cmp_bytes(left, right) == 0;
}

int find_byte(bytes haystack, int needle, int from) {
    int index = from;
    int length = haystack.size();
    while (index < length) {
        if (haystack[index] == needle) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

/// `GIT_status.Change` to the same character `mark_str` already turns into a
/// letter -- `rows_from_deltas`'s own `GIT_status.Change` -> `int` mapping,
/// pulled out so `commit_node`'s file rows can share it instead of
/// repeating the match.
int change_mark(GIT_status.Change kind) {
    match (kind) {
        case Added: {
            return 'A';
        }
        case Modified: {
            return 'M';
        }
        case Deleted: {
            return 'D';
        }
    }
}

str mark_str(int mark) {
    if (mark == 'A') {
        return "A";
    }
    if (mark == 'D') {
        return "D";
    }
    return "M";
}

/// `deltas`, converted to sorted `PathRow`s -- one status letter per path,
/// `GIT_status.Change`'s own three variants.
pub List<PathRow> rows_from_deltas(List<GIT_status.Delta> deltas) {
    List<PathRow> out = [];
    for (GIT_status.Delta delta in deltas) {
        str path_text = delta.path.utf8().or("<non-utf8 path>");
        out.push(PathRow(path_text, delta.path, change_mark(delta.kind)));
    }
    out.sort();
    return out;
}

/// `paths`, converted to sorted, markless `PathRow`s.
pub List<PathRow> rows_from_untracked(List<bytes> paths) {
    List<PathRow> out = [];
    for (bytes path in paths) {
        out.push(PathRow(path.utf8().or("<non-utf8 path>"), path, 0));
    }
    out.sort();
    return out;
}

/// The first line of a commit message, decoded as far as it will go -- the
/// one-line summary the outline's commit rows show.
pub str first_line(bytes message) {
    int newline_index = find_byte(message, '\n', 0);
    bytes line = message;
    if (newline_index >= 0) {
        line = message.substr(0, newline_index);
    }
    return line.utf8().or("<non-utf8 message>");
}

/// Is `id` expanded, given what the caller has recorded about it and what it
/// defaults to when nothing has been recorded yet? A toggled-closed section
/// survives a rebuild of the outline this way -- see `State.toggle_current`.
bool is_expanded_for(Map<str, bool> collapsed, str id, bool is_default_expanded) {
    match (collapsed.get(id)) {
        case Some(bool is_collapsed): {
            return !is_collapsed;
        }
        case None: {
            return is_default_expanded;
        }
    }
}

// A commit message line, wrapped to a fixed fallback width rather than the
// outline's real render width, because `commit_node` cannot see that width.
//
// `build_outline` (and so `commit_node`) runs once, from `State.reload()`,
// after an action that changes the repository -- not on every frame. The
// outline it returns is then rendered against whatever `TUI_geometry.Rect` the
// terminal loop hands `State.draw()`, which can change across a resize with
// no `reload()` in between (see `draw()` below: it calls `outline.render`
// straight on the stored tree). So the real column count is known only
// inside `TUI_outline.Outline.render`, one row = one screen line, well after
// these nodes are built.
//
// Making `TUI_outline` itself wrap-aware -- so a resize could reflow without
// a full rebuild -- would mean one logical `Row` can occupy a *variable*
// number of physical lines, which reaches into `rows()`, `move()`,
// `did_select_id()` and the `Viewport.reveal`/`clamped` scroll math that all
// currently assume "one row is one line". That is a real feature, but a
// bigger one than this fix: it would change the widget's row model for
// every caller (`tui's `browse.m31`` included), not just this one.
//
// So this wraps eagerly, here, against `COMMIT_BODY_WRAP_COLUMNS` -- a stand-in
// for a typical terminal, chosen so it still looks right at the common case
// rather than picking an arbitrary round number. Neither direction loses a
// character: `TUI_text.wrap` only drops whitespace exactly at a line break
// it introduces, never a non-space byte, so joining a message line's
// wrapped rows back together (with a single space where a break was)
// reproduces the original line. General wrap-awareness in `TUI_outline`
// itself is a real follow-up, not attempted here.
//
// A terminal narrower than this fallback still clips a wrapped row's tail
// in `Outline.render`, exactly as it always could for any other row (a long
// file path, the author line below, never wrapped at all) -- `h`/`l` and
// the left/right arrows now cover that case directly, via
// `TUI_outline.Outline.scroll_h`, rather than waiting on wrap-awareness to
// close it. Content is reachable by scrolling sideways; it no longer just
// clips with no way back.
const int COMMIT_BODY_WRAP_COLUMNS = 72;
/// Columns `h`/`l`/the left and right arrows move the outline's horizontal
/// scroll per press -- a whole word or two at a time, not one column, so a
/// long line clears in a handful of presses.
const int SCROLL_H_STEP = 4;
/// How many commits one `GIT_log.walk` fetches, and by how many the "load
/// more" row at the bottom of the Commits section grows that each time it
/// is activated. A `log` at least this long may have more behind it, which
/// is when `build_outline` appends that row (`LOAD_MORE_ID`).
const int LOG_PAGE = 200;
const str LOAD_MORE_ID = "commits:more";

/// `id`'s blob, or empty if it has none (the add/delete side of a
/// `CommitFileDiff`) -- the commit-history equivalent of `State.read_blob`,
/// free rather than a method since `commit_changes` runs before a `State`
/// exists for the commits it is building rows for (`reload`'s own order:
/// `refresh` first, then this, then `build_outline`).
bytes commit_blob(str gitdir, Option<str> id) {
    match (id) {
        case Some(str old_id): {
            match (GIT_object.read(gitdir, old_id)) {
                case Ok(GIT_object.Object object): {
                    return object.raw;
                }
                case Err: {
                    return [];
                }
            }
        }
        case None: {
            return [];
        }
    }
}

/// Every file `c` changed against its first parent -- the empty tree, for a
/// root commit, matching git's own treatment of the initial commit as
/// entirely additions, since there is nothing to diff it against. First
/// parent only for a merge, the simpler choice `git log --first-parent -p`
/// and GitHub's own PR view make, not git's full combined-diff format: this
/// client is for stepping through history, not auditing a merge's conflict
/// resolution.
///
/// Two trees flattened to `path -> blob id` (`GIT_object.flatten_tree`) and
/// compared by path, the exact three-way split `GIT_status.status` already
/// makes between the index and HEAD's tree (added/modified/deleted) --
/// unchanged paths (`old_id == new_id`) are left out entirely, the same way
/// `GIT_status.status` only ever reports what actually differs.
Result<List<CommitFileDiff>, GIT_object.Error> commit_changes(str gitdir, GIT_object.Commit commit) {
    Map<str, str> new_tree = GIT_object.flatten_tree(gitdir, commit.tree)?;
    Map<str, str> old_tree = {};
    if (commit.parents.size() > 0) {
        match (GIT_object.read(gitdir, commit.parents[0])) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit parent_commit): {
                        old_tree = GIT_object.flatten_tree(gitdir, parent_commit.tree)?;
                    }
                    case Blob: {
                    }
                    case Tree(List<GIT_object.Entry> ignored): {
                    }
                    case Tag: {
                    }
                }
            }
            case Err(GIT_object.Error error): {
                return Result<List<CommitFileDiff>, GIT_object.Error>.Err(error);
            }
        }
    }
    List<str> paths = [];
    for (str path in new_tree.keys()) {
        paths.push(path);
    }
    for (str path in old_tree.keys()) {
        if (!new_tree.contains(path)) {
            paths.push(path);
        }
    }
    paths.sort();
    List<CommitFileDiff> out = [];
    for (str path in paths) {
        Option<str> old_blob_id = old_tree.get(path);
        Option<str> new_blob_id = new_tree.get(path);
        GIT_status.Change kind = GIT_status.Change.Modified;
        bool is_skipping = false;
        match (old_blob_id) {
            case Some(str old_id): {
                match (new_blob_id) {
                    case Some(str new_id): {
                        if (old_id == new_id) {
                            is_skipping = true;
                        }
                    }
                    case None: {
                        kind = GIT_status.Change.Deleted;
                    }
                }
            }
            case None: {
                kind = GIT_status.Change.Added;
            }
        }
        if (is_skipping) {
            continue;
        }
        bytes old_bytes = commit_blob(gitdir, old_blob_id);
        bytes new_bytes = commit_blob(gitdir, new_blob_id);
        bool is_binary = false;
        int insertions = 0;
        int deletions = 0;
        match (GIT_hunks.hunks(old_bytes, new_bytes)) {
            case Binary: {
                is_binary = true;
            }
            case Hunks(List<TUI_diff_view.Hunk> hunks): {
                for (TUI_diff_view.Hunk hunk in hunks) {
                    for (TUI_diff_view.Line line in hunk.lines) {
                        match (line.kind) {
                            case Add: {
                                insertions = insertions + 1;
                            }
                            case Remove: {
                                deletions = deletions + 1;
                            }
                            case Context: {
                            }
                        }
                    }
                }
            }
        }
        out.push(CommitFileDiff(path.to_bytes(), kind, old_blob_id, new_blob_id, is_binary, insertions, deletions));
    }
    return Result<List<CommitFileDiff>, GIT_object.Error>.Ok(out);
}

/// The outline's commit section: one collapsible node per commit, its short
/// id and first message line as the label, and -- expanded -- its author,
/// date and full message as leaf rows underneath. See `TUI_outline.m31`'s own
/// header on why every row needs a stable `id`: folding must not renumber
/// what the jump list or a saved cursor position names.
///
/// Unlike the summary rows this client builds elsewhere (a file path, a
/// commit's own hash-plus-first-line label), a message line is not something
/// anything needs to select as its own addressable row -- so, unlike those,
/// a message line longer than the available width is wrapped across
/// multiple leaf rows here rather than left for `Outline.render` to clip
/// silently. A short line still yields exactly one leaf row.
///
/// A nested "Files changed" subsection follows the message, one addressable
/// row per `CommitFileDiff` in `changes` -- `show_diff_current`'s own
/// commit-file branch is what `Enter` on one of these reaches, through
/// `out_file_diffs`, the same "every leaf row recorded in an out-param"
/// convention `build_outline`'s own header documents for `out_paths`.
/// Open by default once the commit itself is unfolded -- the commit stays
/// collapsed until asked, so nothing is tall until the reader asks for it,
/// and then the files are what they asked for: `Enter` on a commit shows its
/// files at once, `Enter` on a file shows its diff. A fold recorded in
/// `collapsed` still wins, as everywhere else.
List<TUI_outline.Node> commit_node(GIT_log.Entry entry, List<CommitFileDiff> changes, Map<str, bool> collapsed, Map<str, CommitFileDiff> out_file_diffs) {
    str id = "commit:" + entry.id;
    str label = entry.id.substr(0, 7) + "  " + first_line(entry.commit.message);
    List<TUI_outline.Node> body = [];
    str author = entry.commit.author.name.utf8().or("<non-utf8>") + " <" + entry.commit.author.email.utf8().or("<non-utf8>") + ">";
    body.push(TUI_outline.Node.leaf(id + ":author", "Author: " + author));
    body.push(TUI_outline.Node.leaf(id + ":date", "Date:   " + date.iso(entry.commit.author.when)));
    str message = entry.commit.message.utf8().or("<non-utf8 message>");
    int line_index = 0;
    for (str line in text.lines(message)) {
        int wrapped_index = 0;
        for (str wrapped in TUI_text.wrap(line, COMMIT_BODY_WRAP_COLUMNS)) {
            body.push(TUI_outline.Node.leaf(id + ":m" + line_index.to_str() + ":" + wrapped_index.to_str(), "  " + wrapped));
            wrapped_index = wrapped_index + 1;
        }
        line_index = line_index + 1;
    }
    List<TUI_outline.Node> file_nodes = [];
    int file_index = 0;
    for (CommitFileDiff change in changes) {
        str file_id = id + ":file:" + file_index.to_str();
        str path_text = change.path.utf8().or("<non-utf8 path>");
        str stat = "+" + change.insertions.to_str() + " -" + change.deletions.to_str();
        if (change.is_binary) {
            stat = "(binary)";
        }
        file_nodes.push(TUI_outline.Node.leaf(file_id, mark_str(change_mark(change.kind)) + "  " + path_text + "  " + stat));
        out_file_diffs.set(file_id, change);
        file_index = file_index + 1;
    }
    str files_id = id + ":files";
    body.push(TUI_outline.Node.section(files_id, "Files changed (" + file_nodes.size().to_str() + ")", file_nodes, is_expanded: is_expanded_for(collapsed, files_id, true)));
    return [TUI_outline.Node.section(id, label, body, is_expanded: is_expanded_for(collapsed, id, false))];
}

/// The primary document, from a `Status` and a commit walk alone -- no
/// terminal, no `gitdir`, no I/O of any kind, which is what makes this the
/// piece `t_gitclient.m31` calls directly.
///
/// Every leaf row this builds is recorded in `out_paths` (row id -> the raw
/// bytes to stage or unstage), which `State` keeps and `stage_current`/
/// `unstage_current` read from -- there is no other way to get from "the
/// cursor is on this row" back to a path, since `TUI_outline.Row` only knows
/// the label it was given. A commit's own file rows are recorded a second
/// time in `out_file_diffs` (row id -> the `CommitFileDiff` `commit_changes`
/// already computed for it), which `show_diff_current`'s commit-file branch
/// reads instead of re-deriving blob ids from a bare path the way the
/// working-tree sections' rows do -- there is no index or working tree to
/// fall back on for a path that existed only in some past commit.
///
/// `changes_by_commit` is `State.commit_changes_cache`: `commit_changes`'s
/// result for every commit unfolded so far, keyed by commit id. A commit
/// not in it (never unfolded) renders with an empty file list -- which is
/// never visible, since it is only ever the unfolding itself that fills the
/// cache and rebuilds (`State.toggle_current`). The computing happens
/// elsewhere, this only ever renders what it is handed, which is what keeps
/// this function itself free of I/O (this doc comment's own first line).
pub TUI_outline.Outline build_outline(GIT_status.Status status, List<GIT_log.Entry> log, Map<str, List<CommitFileDiff>> changes_by_commit, Map<str, bool> collapsed, Map<str, bytes> out_paths, Map<str, CommitFileDiff> out_file_diffs, List<BranchRow> branches) {
    out_paths.clear();
    out_file_diffs.clear();
    List<TUI_outline.Node> roots = [];
    List<TUI_outline.Node> untracked_children = [];
    for (PathRow row in rows_from_untracked(status.untracked)) {
        str id = "untracked:" + row.path;
        out_paths.set(id, row.raw);
        untracked_children.push(TUI_outline.Node.leaf(id, row.path));
    }
    roots.push(TUI_outline.Node.section("untracked", "Untracked files (" + untracked_children.size().to_str() + ")", untracked_children, is_expanded: is_expanded_for(collapsed, "untracked", true)));
    List<TUI_outline.Node> unstaged_children = [];
    for (PathRow row in rows_from_deltas(status.unstaged)) {
        str id = "unstaged:" + row.path;
        out_paths.set(id, row.raw);
        unstaged_children.push(TUI_outline.Node.leaf(id, mark_str(row.mark) + "  " + row.path));
    }
    roots.push(TUI_outline.Node.section("unstaged", "Unstaged changes (" + unstaged_children.size().to_str() + ")", unstaged_children, is_expanded: is_expanded_for(collapsed, "unstaged", true)));
    List<TUI_outline.Node> staged_children = [];
    for (PathRow row in rows_from_deltas(status.staged)) {
        str id = "staged:" + row.path;
        out_paths.set(id, row.raw);
        staged_children.push(TUI_outline.Node.leaf(id, mark_str(row.mark) + "  " + row.path));
    }
    roots.push(TUI_outline.Node.section("staged", "Staged changes (" + staged_children.size().to_str() + ")", staged_children, is_expanded: is_expanded_for(collapsed, "staged", true)));
    List<TUI_outline.Node> commit_children = [];
    for (GIT_log.Entry entry in log) {
        List<CommitFileDiff> changes = changes_by_commit.get(entry.id).or([]);
        for (TUI_outline.Node node in commit_node(entry, changes, collapsed, out_file_diffs)) {
            commit_children.push(node);
        }
    }
    str commits_label = "Commits (" + log.size().to_str() + ")";
    if (log.size() >= LOG_PAGE) {
        // The walk hit its limit, so there may be more behind it: one last,
        // addressable row that `handle_enter` turns into a longer walk.
        commit_children.push(TUI_outline.Node.leaf(LOAD_MORE_ID, "… load " + LOG_PAGE.to_str() + " more commits"));
        commits_label = "Commits (" + log.size().to_str() + "+)";
    }
    roots.push(TUI_outline.Node.section("commits", commits_label, commit_children, is_expanded: is_expanded_for(collapsed, "commits", true)));
    // Local branches, the current one starred -- `b` acts on the row under
    // the cursor (`checkout_current`). Last, after the commits, so the row
    // positions every existing check counts on (untracked first, commits
    // fourth) are untouched; design.md's own Magit comparison lists branches
    // as one more section of the same document, not a panel of its own.
    List<TUI_outline.Node> branch_children = [];
    for (BranchRow branch_row in branches) {
        str mark = "  ";
        if (branch_row.branch.is_current) {
            mark = "* ";
        }
        branch_children.push(TUI_outline.Node.leaf("branch:" + branch_row.branch.name, mark + branch_row.branch.name + "  " + branch_row.branch.id.substr(0, 7) + "  " + branch_row.subject));
    }
    roots.push(TUI_outline.Node.section("branches", "Branches (" + branch_children.size().to_str() + ")", branch_children, is_expanded: is_expanded_for(collapsed, "branches", true)));
    return TUI_outline.Outline(roots);
}

// --- the commit message: writing the template, reading it back -------------

/// git's own cleanup mode with no flags given: `--cleanup=strip`. Every line
/// beginning with `#` is dropped, and the remainder is trimmed of leading and
/// trailing blank lines and whitespace. An empty result is exactly the case
/// `finish_commit` refuses, matching real `git commit`'s own "Aborting
/// commit due to empty commit message."
pub str strip_comment_lines(str raw) {
    List<str> keep = [];
    for (str line in text.lines(raw)) {
        if (line.starts_with("#")) {
            continue;
        }
        keep.push(line);
    }
    return keep.join("\n").trim();
}

/// The template written at `COMMIT_EDITMSG` for a person (or a script driving
/// one) to edit -- git's own comment lines, minus the fuller status summary
/// real git includes, which needs nothing this client cannot already show in
/// the outline above it.
pub str commit_template() {
    return "\n# Please enter the commit message for your changes. Lines starting\n# with '#' will be ignored, and an empty message aborts the commit.\n";
}

// --- building a tree from the index's flat, sorted paths --------------------

// One entry on its way into a tree, carrying only what `GIT_object.write_tree`
// needs plus the bytes to group by -- not a full `GIT_index.Entry`, so the
// recursion below never has to reconstruct one.
type Leaf {
    int mode;
    str id;
    bytes path;
}

/// The tree `entries` describes, written recursively: `GIT_object.write_tree`
/// already sorts one directory level and hashes it, so this only has to
/// group a flat list of paths into the directories git's tree format
/// actually nests, bottom-up. Grouped by raw `bytes`, not `str`, because
/// `GIT_index.Entry.path` need not be UTF-8 (`GIT_index.m31`'s own module header)
/// and dropping a non-UTF-8 path here -- the way `GIT_status.m31` drops one from
/// a *display* -- would silently leave a real, currently-staged file out of
/// the commit, which is a correctness bug and not a display gap.
pub Result<str, GIT_object.Error> build_tree(str gitdir, List<GIT_index.Entry> entries) {
    List<Leaf> leaves = [];
    for (GIT_index.Entry entry in entries) {
        leaves.push(Leaf(entry.mode, entry.id, entry.path));
    }
    return build_tree_of(gitdir, leaves);
}

Result<str, GIT_object.Error> build_tree_of(str gitdir, List<Leaf> leaves) {
    List<GIT_object.Entry> out = [];
    List<bytes> dirnames = [];
    List<List<Leaf>> groups = [];
    for (Leaf leaf in leaves) {
        int slash = find_byte(leaf.path, '/', 0);
        if (slash < 0) {
            out.push(GIT_object.Entry(leaf.mode, leaf.path, leaf.id));
            continue;
        }
        bytes directory = leaf.path.substr(0, slash);
        bytes rest = leaf.path.substr(slash + 1, leaf.path.size());
        Leaf sub = Leaf(leaf.mode, leaf.id, rest);
        int index = find_directory(dirnames, directory);
        if (index < 0) {
            dirnames.push(directory);
            groups.push([sub]);
        } else {
            groups[index].push(sub);
        }
    }
    int index = 0;
    while (index < dirnames.size()) {
        str sub_id = build_tree_of(gitdir, groups[index])?;
        out.push(GIT_object.Entry(0o40000, dirnames[index], sub_id));
        index = index + 1;
    }
    return GIT_object.write_tree(gitdir, out);
}

int find_directory(List<bytes> dirnames, bytes directory) {
    int index = 0;
    while (index < dirnames.size()) {
        if (is_bytes_equal(dirnames[index], directory)) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// --- finding one path in HEAD's tree, for unstaging --------------------------

/// HEAD's tree, or `None` for an unborn branch or a detached HEAD this
/// cannot read -- `GIT_status.m31`'s own `head_tree`, minus the `Status`-shaped
/// error, since `unstage_path` only needs to know whether there is one.
pub Option<str> head_tree_id(str gitdir) {
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Unborn(str name): {
                    return Option<str>.None;
                }
                case Born(str name, str id): {
                    return commit_tree_id(gitdir, id);
                }
                case Detached(str id): {
                    return commit_tree_id(gitdir, id);
                }
            }
        }
        case Err(_): {
            return Option<str>.None;
        }
    }
}

Option<str> commit_tree_id(str gitdir, str id) {
    match (GIT_object.read(gitdir, id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    return Option<str>.Some(commit.tree);
                }
                case Blob: {
                    return Option<str>.None;
                }
                case Tree: {
                    return Option<str>.None;
                }
                case Tag: {
                    return Option<str>.None;
                }
            }
        }
        case Err: {
            return Option<str>.None;
        }
    }
}

/// The tree entry at `path`, following one path segment per subtree read.
/// `None` for a path this tree does not have, at all or at that type -- a
/// directory where the caller asked for a blob is the same "not there" as a
/// missing name, since either way there is no blob to restore.
pub Option<GIT_object.Entry> find_in_tree(str gitdir, str tree_id, bytes path) {
    int slash = find_byte(path, '/', 0);
    bytes seg = path;
    bytes rest = [];
    bool has_rest = false;
    if (slash >= 0) {
        seg = path.substr(0, slash);
        rest = path.substr(slash + 1, path.size());
        has_rest = true;
    }
    match (GIT_object.read(gitdir, tree_id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Tree(List<GIT_object.Entry> entries): {
                    for (GIT_object.Entry entry in entries) {
                        if (is_bytes_equal(entry.name, seg)) {
                            if (has_rest) {
                                if (entry.is_tree()) {
                                    return find_in_tree(gitdir, entry.id, rest);
                                }
                                return Option<GIT_object.Entry>.None;
                            }
                            return Option<GIT_object.Entry>.Some(entry);
                        }
                    }
                    return Option<GIT_object.Entry>.None;
                }
                case Blob: {
                    return Option<GIT_object.Entry>.None;
                }
                case Commit: {
                    return Option<GIT_object.Entry>.None;
                }
                case Tag: {
                    return Option<GIT_object.Entry>.None;
                }
            }
        }
        case Err: {
            return Option<GIT_object.Entry>.None;
        }
    }
}

// --- the client's own state --------------------------------------------------

/// Everything the interactive client is showing and doing right now. One
/// value, held by `gitui.m31`'s top-level driver and reached by the
/// `draw`/`handle` lambdas the same way `tui's `browse.m31``'s own `State`
/// is -- there is no mutable module state to put it in instead (reference
/// §2).
pub type State {
    pub str gitdir;
    pub str worktree;
    pub TUI_outline.Outline outline = TUI_outline.Outline([]);
    pub TUI_jump_list.JumpList jump = TUI_jump_list.JumpList.empty;
    pub bool is_jump_shown = false;
    pub bool is_jump_focused = false;
    pub bool is_commit_open = false;
    /// The `x` confirmation overlay: discarding is the one destructive thing
    /// this client does to a working tree, so it never happens on a single
    /// keypress -- `discard_current` records what `x` was pressed on here and
    /// opens the prompt, and only `y` (`handle_confirm_key`) actually calls
    /// `discard_path`. `confirm_kind` is the row's section (`untracked`,
    /// `unstaged`, `staged`), which decides what "discard" restores from.
    pub bool is_confirm_open = false;
    str confirm_kind = "";
    bytes confirm_path = [];
    /// `c` then `A`: the commit overlay is replacing HEAD rather than adding a
    /// child to it. `start_amend` sets this (and prefills the message file
    /// with HEAD's own message); `finish_commit` reads it to pick HEAD's
    /// parents and author instead of HEAD-as-parent and a fresh author.
    /// Reset whenever the overlay is opened fresh or aborted.
    pub bool is_amending = false;
    /// The `b` which-key overlay (check out / new branch) is open.
    pub bool is_branch_open = false;
    /// Where `n` (new branch) asks for the name: a file `$EDITOR` is launched
    /// on, exactly like `commit_message_path`, since there is no text-input
    /// widget to type into -- see `new_branch`.
    pub str branch_name_path = "";
    /// Which file the pending `$EDITOR` launch is for -- `launch_editor`
    /// serves both the commit message and the new-branch name.
    bool is_editor_for_branch = false;
    List<BranchRow> branch_rows = [];
    /// The `P` which-key overlay (push), open until a choice or `Escape`.
    pub bool is_push_open = false;
    /// The `F` which-key overlay (pull), open until a choice or `Escape`.
    pub bool is_pull_open = false;
    /// Set by `edit_message` and read by `gitui.m31`'s own top-level driver
    /// after `TUI_app.Loop.run` returns: true means the loop stopped so
    /// `$EDITOR` could have the terminal, not because the operator pressed
    /// `q`. See this module's own header, "launching `$EDITOR`, and the
    /// terminal handoff that takes".
    pub bool is_editor_wanted = false;
    pub str commit_message_path = "";
    pub str branch_label = "";
    pub str message = "";
    /// Whether the primary document is currently showing a hunk-level diff
    /// instead of the outline -- see `show_diff_current`/`close_diff`. One
    /// view the document can show, per `docs/design.md`'s locked "one
    /// primary document" layout, not a second panel competing with the
    /// outline for space.
    pub bool is_diff_open = false;
    /// Set instead of populating `diff_view`, when `GIT_hunks.hunks` reported
    /// `Binary` for the pair being compared -- matching git's own "Binary
    /// files differ" rather than trying to render binary content as text.
    pub bool is_diff_binary = false;
    /// The row label the diff view's border is drawn with, so the file
    /// being diffed stays visible while the outline underneath is hidden.
    pub str diff_title = "";
    /// The hunks of the file under the cursor when `d` was last pressed,
    /// with its own cursor -- `DiffView.at()` -- tracking which header or
    /// line the cursor addresses. Actually staging that address is out of
    /// scope for this change; keeping the addressing live here is what
    /// makes hunk staging a small follow-up instead of another rewrite.
    pub TUI_diff_view.DiffView diff_view = TUI_diff_view.DiffView([]);
    /// Which comparison `diff_view` shows -- "untracked", "unstaged",
    /// "staged" or "commit" -- and for which path, so `s`/`u` in the view
    /// (`stage_hunk_current`/`unstage_hunk_current`) know which index
    /// content to patch and `reopen_diff` can rebuild the same view after.
    /// Empty while the view is closed.
    pub str diff_section = "";
    pub bytes diff_path = [];
    Map<str, bool> collapsed = {};
    Map<str, bytes> paths = {};
    Map<str, CommitFileDiff> file_diffs = {};
    /// `commit_changes`'s result per commit id, filled on demand the first
    /// time that commit is unfolded (`did_compute_commit_changes`, from
    /// `toggle_current`) and never again: a commit is immutable, so what it
    /// changed against its parent is too. A commit nobody has unfolded costs
    /// no tree read at all -- `reload` rebuilds the outline from this map as
    /// it stands, which is what keeps a 200-commit log cheap to refresh.
    Map<str, List<CommitFileDiff>> commit_changes_cache = {};
    /// How many commits `refresh` asks `GIT_log.walk` for -- LOG_PAGE at
    /// first, grown by another LOG_PAGE each time the "load more" row at
    /// the bottom of the Commits section is activated.
    int log_limit = LOG_PAGE;
    GIT_status.Status last_status = GIT_status.Status([], [], []);
    List<GIT_log.Entry> log = [];
}

/// A fresh client over the repository whose git directory is `gitdir` and
/// whose working tree is `worktree`. Call `reload()` before drawing it --
/// this constructor alone does no I/O, which is what makes it safe to build
/// in a test that never touches a real repository.
pub static State State.open(str gitdir, str worktree) {
    State state = State(gitdir, worktree);
    state.commit_message_path = fs.join(gitdir, "COMMIT_EDITMSG");
    state.branch_name_path = fs.join(gitdir, "GITUI_BRANCH_NAME");
    return state;
}

/// Re-read the repository: `GIT_status.status` for the three change lists,
/// `GIT_log.walk` for the commit history, and HEAD for the branch label the
/// status line shows. An unborn branch's `GIT_log.walk` failure is not an
/// error here -- it is exactly what "nothing committed yet" looks like --
/// so it becomes an empty history rather than a message.
pub void State.refresh() {
    match (GIT_status.status(gitdir, worktree)) {
        case Ok(GIT_status.Status status): {
            last_status = status;
        }
        case Err(GIT_status.Error error): {
            last_status = GIT_status.Status([], [], []);
            message = "status: " + error.to_str();
        }
    }
    match (GIT_log.walk(gitdir, "HEAD", log_limit)) {
        case Ok(List<GIT_log.Entry> entries): {
            log = entries;
        }
        case Err: {
            log = [];
        }
    }
    branch_rows = [];
    match (GIT_checkout.branches(gitdir)) {
        case Ok(List<GIT_checkout.Branch> branches): {
            for (GIT_checkout.Branch branch in branches) {
                branch_rows.push(BranchRow(branch, tip_subject(branch.id)));
            }
        }
        case Err: {
        }
    }
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    branch_label = "on " + branch_name(name) + " @ " + id.substr(0, 7);
                }
                case Unborn(str name): {
                    branch_label = "on " + branch_name(name) + " (no commits yet)";
                }
                case Detached(str id): {
                    branch_label = "detached @ " + id.substr(0, 7);
                }
            }
        }
        case Err(_): {
            branch_label = "?";
        }
    }
}

/// Make sure `commit_changes_cache` has an entry for commit `id` -- computed
/// now if it is the first time this commit is unfolded, a no-op afterwards.
/// A commit whose tree or parent's tree cannot be read (a truncated history,
/// a shallow clone's boundary) gets an empty file list rather than failing
/// the unfold -- the same "a read that fails reads as nothing" choice
/// `read_worktree`/`index_blob`/`head_blob` already make elsewhere in this
/// file. Answers whether anything new was computed, so the caller knows the
/// outline it is looking at was built without this commit's files and needs
/// rebuilding.
bool State.did_compute_commit_changes(str id) {
    if (commit_changes_cache.contains(id)) {
        return false;
    }
    for (GIT_log.Entry entry in log) {
        if (entry.id == id) {
            match (commit_changes(gitdir, entry.commit)) {
                case Ok(List<CommitFileDiff> changes): {
                    commit_changes_cache.set(id, changes);
                }
                case Err: {
                    commit_changes_cache.set(id, []);
                }
            }
            return true;
        }
    }
    return false;
}

/// Refresh and rebuild the outline, keeping the cursor on the row it was on
/// (by id, not by position -- `TUI_outline.m31`'s own reason) and the jump
/// list in step with it. Called after every action that changes what the
/// repository looks like: staging, unstaging, committing, and the manual
/// refresh key.
pub void State.reload() {
    str keep_id = "";
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            keep_id = row.node.id;
        }
        case None: {
        }
    }
    refresh();
    outline = build_outline(last_status, log, commit_changes_cache, collapsed, paths, file_diffs, branch_rows);
    if (keep_id != "") {
        outline.did_select_id(keep_id);
    }
    jump.sync_from(outline);
    jump.follow(outline);
}

/// Fold or unfold the row under the cursor, remembering the choice so the
/// next `reload()` (which rebuilds the outline from nothing) respects it.
///
/// Unfolding a commit (or its "Files changed" subsection) is also the moment
/// its file list is first computed -- `did_compute_commit_changes` -- and when
/// that actually computed something, the outline is rebuilt in place from
/// the now-filled cache (the one on screen was built with an empty list for
/// this commit) with the cursor kept on the same row by id, the same way
/// `reload` keeps it. No I/O happens for a fold, or for a commit already
/// unfolded once.
pub void State.toggle_current() {
    outline.toggle();
    str keep_id = "";
    bool is_rebuilding = false;
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            collapsed.set(row.node.id, !row.node.is_expanded);
            keep_id = row.node.id;
            if (row.node.is_expanded) {
                match (commit_id_of_unfoldable(row.node.id)) {
                    case Some(str cid): {
                        is_rebuilding = did_compute_commit_changes(cid);
                    }
                    case None: {
                    }
                }
            }
        }
        case None: {
        }
    }
    if (is_rebuilding) {
        outline = build_outline(last_status, log, commit_changes_cache, collapsed, paths, file_diffs, branch_rows);
        outline.did_select_id(keep_id);
    }
    jump.sync_from(outline);
    jump.follow(outline);
}

pub void State.move_cursor(int delta) {
    outline.move(delta);
    jump.follow(outline);
}

/// Stage the file under the cursor, if it is an untracked or an unstaged row
/// -- a no-op on anything else (a staged row, a section heading, a commit).
/// This is `git add <path>` for exactly one path: read it, `write_blob`,
/// build an entry with `GIT_index.from_stat`, and put it in the index, replacing
/// whatever entry that path already had.
pub void State.stage_current() {
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            if (row.node.id.starts_with("untracked:") || row.node.id.starts_with("unstaged:")) {
                match (paths.get(row.node.id)) {
                    case Some(bytes path): {
                        stage_path(path);
                    }
                    case None: {
                    }
                }
            }
        }
        case None: {
        }
    }
}

pub void State.stage_path(bytes relative_path) {
    str full = fs.join(worktree, relative_path.utf8().or(""));
    bytes content = [];
    match (io.read_bytes(full)) {
        case Ok(bytes contents): {
            content = contents;
        }
        case Err(io.Error error): {
            message = "cannot read " + relative_path.utf8().or("<non-utf8>") + ": " + error.to_str();
            return;
        }
    }
    str blob_id = "";
    match (GIT_object.write_blob(gitdir, content)) {
        case Ok(str id): {
            blob_id = id;
        }
        case Err(GIT_object.Error error): {
            message = "write_blob: " + error.to_str();
            return;
        }
    }
    fs.Stat file_stat = fs.Stat(0, 0, 0);
    match (fs.stat(full)) {
        case Ok(fs.Stat fetched): {
            file_stat = fetched;
        }
        case Err(io.Error error): {
            message = "stat: " + error.to_str();
            return;
        }
    }
    GIT_index.Entry entry = GIT_index.from_stat(relative_path, file_stat, fs.is_link(full), blob_id);
    GIT_index.Index index = read_index(gitdir);
    replace_entry(index, entry);
    match (GIT_index.write(gitdir, index)) {
        case Ok: {
            message = "staged " + relative_path.utf8().or("<non-utf8>");
        }
        case Err(GIT_index.Error error): {
            message = "index write: " + error.to_str();
            return;
        }
    }
    reload();
}

/// Unstage the file under the cursor, if it is a staged row -- a no-op on
/// anything else. This is `git reset HEAD -- <path>`: if HEAD's tree already
/// has this path, the index entry goes back to exactly what HEAD says (mode
/// and blob), with its stat fields forced to never match a real file so the
/// next `status` re-hashes it rather than trusting stale numbers
/// (`GIT_index.m31`'s own rule: a mismatch only ever costs a re-hash, never
/// wrong). If HEAD has no such path -- the file was newly added -- there is
/// nothing to go back to, so the entry is dropped from the index outright,
/// which is what `git reset` does to a new file too (it becomes untracked
/// again, not deleted from disk).
pub void State.unstage_current() {
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            if (row.node.id.starts_with("staged:")) {
                match (paths.get(row.node.id)) {
                    case Some(bytes path): {
                        unstage_path(path);
                    }
                    case None: {
                    }
                }
            }
        }
        case None: {
        }
    }
}

pub void State.unstage_path(bytes relative_path) {
    GIT_index.Index index = read_index(gitdir);
    Option<str> tree = head_tree_id(gitdir);
    match (tree) {
        case Some(str tid): {
            match (find_in_tree(gitdir, tid, relative_path)) {
                case Some(GIT_object.Entry entry): {
                    // size: -1 can never equal a real `fs.stat` size (always
                    // >= 0), so `GIT_status.status`'s mtime/size shortcut always
                    // re-hashes this entry instead of trusting a snapshot
                    // that was never actually taken.
                    GIT_index.Entry restored = GIT_index.Entry(0, 0, 0, 0, 0, 0, entry.mode, 0, 0, -1, entry.id, 0, false, relative_path);
                    replace_entry(index, restored);
                }
                case None: {
                    remove_entry(index, relative_path);
                }
            }
        }
        case None: {
            remove_entry(index, relative_path);
        }
    }
    match (GIT_index.write(gitdir, index)) {
        case Ok: {
            message = "unstaged " + relative_path.utf8().or("<non-utf8>");
        }
        case Err(GIT_index.Error error): {
            message = "index write: " + error.to_str();
            return;
        }
    }
    reload();
}

/// `x`: ask before discarding the changes to the path under the cursor.
/// Only a path row in one of the three working-tree sections can be
/// discarded; a commit, a commit's file row (history is not something this
/// client rewrites from here) or a section heading just gets a message.
/// Nothing is touched until `handle_confirm_key` sees `y`.
pub void State.discard_current() {
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            str kind = "";
            if (row.node.id.starts_with("untracked:")) {
                kind = "untracked";
            } else if (row.node.id.starts_with("unstaged:")) {
                kind = "unstaged";
            } else if (row.node.id.starts_with("staged:")) {
                kind = "staged";
            }
            if (kind == "") {
                message = "discard: nothing to discard here";
                return;
            }
            match (paths.get(row.node.id)) {
                case Some(bytes path): {
                    confirm_kind = kind;
                    confirm_path = path;
                    is_confirm_open = true;
                    message = "";
                }
                case None: {
                    message = "discard: nothing to discard here";
                }
            }
        }
        case None: {
        }
    }
}

/// Throw away the working-tree (and, for a staged row, index) changes to
/// `relative_path`, by section -- each the exact effect of the real git command named,
/// on that one path and nothing else:
///
///   - **untracked** -- `git clean -f -- <path>`: the file is removed, and
///     so is each parent directory that is left empty by that, up to (never
///     including) the working tree's root, which is what `git clean` leaves
///     behind too.
///   - **unstaged** -- `git checkout -- <path>`: the index's blob for the
///     path is written back over whatever is on disk (recreated, if it was
///     deleted), a symlink entry as a symlink. The index entry itself is
///     left alone: it already names exactly this content, and a stale stat
///     only ever costs `GIT_status.status` one re-hash (`GIT_index.m31`'s own rule).
///   - **staged** -- `git checkout HEAD -- <path>`: both the index entry and
///     the file go back to HEAD's blob and mode (`unstage_path`'s own
///     restored-entry shape, with the rewritten file's real stat). A path HEAD does not
///     have -- a newly added file, staged -- has nothing to go back to, so
///     the entry is dropped and the file removed: `git checkout HEAD --` on
///     such a path is an error in real git, and "discard this new file
///     entirely" is the only meaning the operator can have intended.
///
/// A regular file recreated from scratch gets the process's default mode:
/// there is no `chmod` in `lib/fs.m31` yet, so a deleted-then-discarded
/// executable comes back without its executable bit (one that still exists
/// is rewritten in place and keeps it). `pub`, like `stage_path`, so
/// `t_gitclient_ops.m31` can drive each case against real git.
pub void State.discard_path(str kind, bytes relative_path) {
    str shown = relative_path.utf8().or("<non-utf8>");
    str full = fs.join(worktree, relative_path.utf8().or(""));
    if (kind == "untracked") {
        match (fs.remove(full)) {
            case Ok: {
            }
            case Err(io.Error error): {
                message = "cannot remove " + shown + ": " + error.to_str();
                return;
            }
        }
        prune_empty_parents(relative_path);
        message = "discarded " + shown + " (removed)";
        reload();
        return;
    }
    if (kind == "unstaged") {
        GIT_index.Index index = read_index(gitdir);
        match (find_index_entry(index, relative_path)) {
            case Some(GIT_index.Entry entry): {
                if (!did_write_worktree(relative_path, entry.mode, read_blob(entry.id))) {
                    return;
                }
                message = "discarded changes to " + shown;
                reload();
            }
            case None: {
                message = "discard: " + shown + " is not in the index";
            }
        }
        return;
    }
    if (kind == "staged") {
        GIT_index.Index index = read_index(gitdir);
        Option<GIT_object.Entry> in_head = Option<GIT_object.Entry>.None;
        match (head_tree_id(gitdir)) {
            case Some(str tid): {
                in_head = find_in_tree(gitdir, tid, relative_path);
            }
            case None: {
            }
        }
        match (in_head) {
            case Some(GIT_object.Entry entry): {
                if (!did_write_worktree(relative_path, entry.mode, read_blob(entry.id))) {
                    return;
                }
                // The file was just rewritten, so its real stat goes in the
                // entry (as `stage_path` records it): a zeroed stat makes real
                // git report the path modified until something refreshes it.
                fs.Stat file_stat = fs.Stat(0, 0, 0);
                match (fs.stat(full)) {
                    case Ok(fs.Stat fetched): {
                        file_stat = fetched;
                    }
                    case Err(io.Error error): {
                        message = "stat: " + error.to_str();
                        return;
                    }
                }
                GIT_index.Entry fresh = GIT_index.from_stat(relative_path, file_stat, fs.is_link(full), entry.id);
                GIT_index.Entry restored = GIT_index.Entry(fresh.ctime_s, fresh.ctime_ns, fresh.mtime_s, fresh.mtime_ns, 0, 0, entry.mode, 0, 0, fresh.size, entry.id, 0, false, relative_path);
                replace_entry(index, restored);
            }
            case None: {
                remove_entry(index, relative_path);
                if (fs.exists(full) || fs.is_link(full)) {
                    match (fs.remove(full)) {
                        case Ok: {
                        }
                        case Err(io.Error error): {
                            message = "cannot remove " + shown + ": " + error.to_str();
                            return;
                        }
                    }
                    prune_empty_parents(relative_path);
                }
            }
        }
        match (GIT_index.write(gitdir, index)) {
            case Ok: {
                message = "discarded staged changes to " + shown;
            }
            case Err(GIT_index.Error error): {
                message = "index write: " + error.to_str();
                return;
            }
        }
        reload();
        return;
    }
    message = "discard: unknown section " + kind;
}

/// Put `content` at `relative_path` in the working tree as a blob of `mode` would be
/// checked out: a symlink (0o120000) whose target is the content, otherwise
/// a regular file, its parent directories created as needed. A symlink
/// already there is removed first (`fs.symlink` never replaces). False, with
/// `message` set, on any failure.
bool State.did_write_worktree(bytes relative_path, int mode, bytes content) {
    str shown = relative_path.utf8().or("<non-utf8>");
    str full = fs.join(worktree, relative_path.utf8().or(""));
    str directory = directory_of(full);
    if (directory != "." && !fs.is_dir(directory)) {
        match (fs.makedirs(directory)) {
            case Ok: {
            }
            case Err(io.Error error): {
                message = "cannot create " + directory + ": " + error.to_str();
                return false;
            }
        }
    }
    if (mode == 0o120000) {
        if (fs.exists(full) || fs.is_link(full)) {
            match (fs.remove(full)) {
                case Ok: {
                }
                case Err(io.Error error): {
                    message = "cannot replace " + shown + ": " + error.to_str();
                    return false;
                }
            }
        }
        match (fs.symlink(content.utf8().or(""), full)) {
            case Ok: {
                return true;
            }
            case Err(io.Error error): {
                message = "cannot link " + shown + ": " + error.to_str();
                return false;
            }
        }
    }
    if (fs.is_link(full)) {
        // A regular blob over what is currently a symlink: writing through
        // the link would overwrite its target instead of replacing the link.
        match (fs.remove(full)) {
            case Ok: {
            }
            case Err(io.Error error): {
                message = "cannot replace " + shown + ": " + error.to_str();
                return false;
            }
        }
    }
    match (io.write_bytes(full, content)) {
        case Ok: {
            return true;
        }
        case Err(io.Error error): {
            message = "cannot write " + shown + ": " + error.to_str();
            return false;
        }
    }
}

/// After removing `relative_path`, remove each of its parent directories that is now
/// empty, deepest first, stopping at the first that is not (or at the
/// working tree's own root, which is never touched) -- `git clean`'s own
/// tidying of a directory it emptied.
void State.prune_empty_parents(bytes relative_path) {
    str parent_path = directory_of(relative_path.utf8().or(""));
    while (parent_path != "." && parent_path != "") {
        match (fs.rmdir(fs.join(worktree, parent_path))) {
            case Ok: {
            }
            case Err: {
                return;
            }
        }
        parent_path = directory_of(parent_path);
    }
}

/// Real, hunk-level diff for the row under the cursor -- the diff-algorithm
/// track (`lib/diff.m31`/`GIT_hunks.m31`) and the rendering widget
/// (`TUI_diff_view.DiffView`) both already existed; this is the
/// wiring `docs/design.md`'s "Starting the client" section named as the
/// follow-up once they did. A no-op on anything that is not a path row (a
/// section heading or a commit).
///
/// The comparison made depends on which section the row is in, matching
/// `GIT_status.m31`'s own two-stage model exactly rather than picking a
/// simplification of it:
///
///   - **unstaged** -- the index's blob for this path (`GIT_status.m31`'s own
///     "working tree vs index" comparison) against the file's content on
///     disk right now. A path missing from disk (staged-deleted-on-disk)
///     compares against an empty `new`, an all-removed hunk.
///   - **staged** -- HEAD's tree's blob for this path against the index's
///     blob for it (`GIT_status.m31`'s "index vs HEAD" comparison). A path
///     HEAD does not have compares an empty `old` (all-added, the newly
///     staged file's whole content); a path the index no longer has (staged
///     for deletion, though this client's own `stage`/`unstage` never
///     produces that today) compares against an empty `new`.
///   - **untracked** -- there is no "old" side at all, so this compares an
///     empty `old` against the file's content on disk: one all-added hunk,
///     the whole file. Deliberately not a separate "new file" display
///     state: it reuses the exact same `GIT_hunks.hunks`/`DiffView` path every
///     other case does, so an untracked file's diff is addressable and
///     scrollable exactly like any other, and it matches what `git diff`
///     itself shows for an intent-to-add path (`git add -N`) -- the closest
///     real-git analogue to "tracked, nothing committed yet".
///   - **a commit's own file row** -- `commit_changes`'s `old_id`/`new_id`
///     for that path, directly (`file_diffs`, not `paths`: there is no disk
///     or index to fall back on for a path that only ever existed in some
///     past commit, unlike the three cases above). Either side missing
///     (an add or a delete) is `commit_blob`'s own empty-bytes default, the
///     same "no blob there" shape `head_blob` already uses for a path HEAD
///     does not have.
///
/// `GIT_hunks.hunks` reporting `Binary` (either side trips `diff.is_binary`'s
/// NUL heuristic) sets `is_diff_binary` instead of populating `diff_view`,
/// which `draw` shows as "Binary files differ", git's own wording, rather
/// than attempting to render binary content as text.
pub void State.show_diff_current() {
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            if (row.node.id.contains(":file:")) {
                match (file_diffs.get(row.node.id)) {
                    case Some(CommitFileDiff commit_file_diff): {
                        open_diff(row.node.label, commit_blob(gitdir, commit_file_diff.old_id), commit_blob(gitdir, commit_file_diff.new_id));
                        diff_section = "commit";
                        diff_path = commit_file_diff.path;
                    }
                    case None: {
                        message = "diff: nothing to show here";
                    }
                }
                return;
            }
            match (paths.get(row.node.id)) {
                case Some(bytes path): {
                    if (row.node.id.starts_with("untracked:")) {
                        open_diff(row.node.label, [], read_worktree(path));
                        diff_section = "untracked";
                        diff_path = path;
                    } else if (row.node.id.starts_with("unstaged:")) {
                        open_diff(row.node.label, index_blob(path), read_worktree(path));
                        diff_section = "unstaged";
                        diff_path = path;
                    } else if (row.node.id.starts_with("staged:")) {
                        open_diff(row.node.label, head_blob(path), index_blob(path));
                        diff_section = "staged";
                        diff_path = path;
                    } else {
                        message = "diff: nothing to show here";
                    }
                }
                case None: {
                    message = "diff: nothing to show here";
                }
            }
        }
        case None: {
        }
    }
}

/// `relative_path`'s content on disk right now, or empty if it cannot be read (missing,
/// a permissions error) -- the same "missing reads as empty" the unstaged
/// comparison's deleted-on-disk case needs.
bytes State.read_worktree(bytes relative_path) {
    str full = fs.join(worktree, relative_path.utf8().or(""));
    match (io.read_bytes(full)) {
        case Ok(bytes contents): {
            return contents;
        }
        case Err: {
            return [];
        }
    }
}

/// `relative_path`'s blob content as the current index has it, or empty if the index
/// has no entry for it -- the staged comparison's "no longer in the index"
/// case, and a defensive default the unstaged comparison should never
/// actually hit (every unstaged row's path is, by construction, in the
/// index).
bytes State.index_blob(bytes relative_path) {
    GIT_index.Index index = read_index(gitdir);
    match (find_index_entry(index, relative_path)) {
        case Some(GIT_index.Entry entry): {
            return read_blob(entry.id);
        }
        case None: {
            return [];
        }
    }
}

/// `relative_path`'s blob content as HEAD's tree has it, or empty if HEAD has no entry
/// there (an unborn branch, or a path newly staged with nothing committed
/// yet) -- the staged comparison's "old" side.
bytes State.head_blob(bytes relative_path) {
    match (head_tree_id(gitdir)) {
        case Some(str tid): {
            match (find_in_tree(gitdir, tid, relative_path)) {
                case Some(GIT_object.Entry entry): {
                    return read_blob(entry.id);
                }
                case None: {
                    return [];
                }
            }
        }
        case None: {
            return [];
        }
    }
}

bytes State.read_blob(str id) {
    match (GIT_object.read(gitdir, id)) {
        case Ok(GIT_object.Object object): {
            return object.raw;
        }
        case Err(GIT_object.Error error): {
            message = "object read: " + error.to_str();
            return [];
        }
    }
}

/// Compute `old` vs `new`'s hunks and open the diff view over them --
/// `title` is what the border shows while it is open. Shared by every
/// section `show_diff_current` handles, so the binary case and the
/// addressable cursor behave identically regardless of which comparison fed
/// it. `pub`, like `stage_path`/`unstage_path`, so a unit test can drive the
/// hunks/binary wiring directly with hand-built `bytes` and no repository at
/// all -- `t_gitclient.m31`'s own reason for testing those two directly.
pub void State.open_diff(str title, bytes old, bytes new) {
    diff_title = title;
    match (GIT_hunks.hunks(old, new)) {
        case Binary: {
            is_diff_binary = true;
            diff_view = TUI_diff_view.DiffView([]);
        }
        case Hunks(List<TUI_diff_view.Hunk> hunks): {
            is_diff_binary = false;
            diff_view = TUI_diff_view.DiffView(hunks);
        }
    }
    is_diff_open = true;
    message = "";
}

/// Back out of the diff view to the outline -- `backspace`, the same "go
/// back" key `tui's `browse.m31`` already uses for leaving a drilled-into
/// view, and `q`/`Escape` too (`handle_diff_key`'s own comment has why).
pub void State.close_diff() {
    is_diff_open = false;
    is_diff_binary = false;
    diff_view = TUI_diff_view.DiffView([]);
    diff_section = "";
    diff_path = [];
    message = "";
}

/// `s` in the diff view: stage only the hunk under the cursor -- `git add
/// -p`'s "y" for exactly one hunk. Meaningful only for a diff opened from an
/// UNSTAGED row (index vs working tree): the index's content with that one
/// hunk applied becomes the new index blob, so the path is then both staged
/// and unstaged, exactly as git shows a partially staged file (`MM`). An
/// untracked row has no index content to patch -- the outline's own `s`
/// stages the whole file -- and a staged or commit diff has nothing to
/// stage, so those just say so. The cursor on a hunk's header or any line
/// inside it addresses that hunk (`DiffView.at().hunk`); line-level
/// staging is not attempted.
pub void State.stage_hunk_current() {
    if (diff_section != "unstaged") {
        if (diff_section == "untracked") {
            message = "untracked: stage the whole file with s from the outline";
        } else {
            message = "nothing to stage here";
        }
        return;
    }
    match (diff_view.at()) {
        case Some(TUI_diff_view.Row row): {
            int keep = diff_view.cursor;
            if (did_stage_hunk(diff_path, row.hunk)) {
                str said = message;
                reload();
                reopen_diff(keep);
                message = said;
            }
        }
        case None: {
            message = "no hunk under the cursor";
        }
    }
}

/// `u` in the diff view: unstage only the hunk under the cursor -- `git
/// reset -p`'s "y" for one hunk, on a diff opened from a STAGED row (HEAD vs
/// index): the index's content with that one hunk reverted becomes the new
/// index blob. The same no-ops as `stage_hunk_current` for every other
/// section.
pub void State.unstage_hunk_current() {
    if (diff_section != "staged") {
        message = "nothing to unstage here";
        return;
    }
    match (diff_view.at()) {
        case Some(TUI_diff_view.Row row): {
            int keep = diff_view.cursor;
            if (did_unstage_hunk(diff_path, row.hunk)) {
                str said = message;
                reload();
                reopen_diff(keep);
                message = said;
            }
        }
        case None: {
            message = "no hunk under the cursor";
        }
    }
}

/// Stage hunk `k` (0-based, in `GIT_hunks.hunks(index, worktree)`'s order) of
/// `relative_path`'s unstaged change: `GIT_patch.apply_hunk` over the index's blob and
/// the file on disk, written as a new blob and put in the index with the
/// entry's stat fields reset (the same `size: -1` rule `unstage_path`
/// uses, so `GIT_status.status` re-hashes it rather than trusting a snapshot
/// that was never taken). Applying the deletion hunk of a file gone from
/// disk leaves nothing, which is `git add -p`'s "stage deletion": the entry
/// is dropped instead. `pub`, like `stage_path`, so `t_gitclient_ops.m31`
/// can drive it against a real fixture and real git. True when the index
/// changed.
pub bool State.did_stage_hunk(bytes relative_path, int hunk_index) {
    bytes old = index_blob(relative_path);
    bytes new = read_worktree(relative_path);
    match (GIT_patch.apply_hunk(old, new, hunk_index)) {
        case Some(bytes content): {
            str full = fs.join(worktree, relative_path.utf8().or(""));
            if (content.size() == 0 && !fs.exists(full)) {
                return did_drop_index_entry(relative_path, "staged deletion of " + relative_path.utf8().or("<non-utf8>"));
            }
            return did_set_index_blob(relative_path, content, "staged hunk " + (hunk_index + 1).to_str() + " of " + relative_path.utf8().or("<non-utf8>"));
        }
        case None: {
            message = "no such hunk to stage";
            return false;
        }
    }
}

/// Unstage hunk `k` (0-based, in `GIT_hunks.hunks(HEAD, index)`'s order) of
/// `relative_path`'s staged change: `GIT_patch.revert_hunk` over HEAD's blob and the
/// index's, written back the same way `did_stage_hunk` writes. Reverting the
/// one all-added hunk of a path HEAD does not have leaves nothing, which is
/// `git reset -p`'s "unstage addition": the entry is dropped, the file is
/// untracked again. True when the index changed.
pub bool State.did_unstage_hunk(bytes relative_path, int hunk_index) {
    bytes old = head_blob(relative_path);
    bytes new = index_blob(relative_path);
    match (GIT_patch.revert_hunk(old, new, hunk_index)) {
        case Some(bytes content): {
            if (content.size() == 0 && !is_in_head_tree(relative_path)) {
                return did_drop_index_entry(relative_path, "unstaged addition of " + relative_path.utf8().or("<non-utf8>"));
            }
            return did_set_index_blob(relative_path, content, "unstaged hunk " + (hunk_index + 1).to_str() + " of " + relative_path.utf8().or("<non-utf8>"));
        }
        case None: {
            message = "no such hunk to unstage";
            return false;
        }
    }
}

/// Rebuild the open diff view for the same section and path after the index
/// changed under it, keeping the cursor where it was (clamped: the view
/// usually has one hunk fewer now). Nothing left to show -- the last hunk
/// was staged or unstaged -- closes the view, and the outline underneath,
/// already rebuilt by `reload`, no longer has that row either.
void State.reopen_diff(int keep_cursor) {
    str section = diff_section;
    bytes path = diff_path;
    str title = diff_title;
    bytes old = [];
    bytes new = [];
    if (section == "unstaged") {
        old = index_blob(path);
        new = read_worktree(path);
    } else if (section == "staged") {
        old = head_blob(path);
        new = index_blob(path);
    } else {
        return;
    }
    if (GIT_patch.hunk_count(old, new) == 0) {
        close_diff();
        return;
    }
    open_diff(title, old, new);
    diff_section = section;
    diff_path = path;
    diff_view.cursor = keep_cursor;
    diff_view.move(0);
}

/// Does HEAD's tree have `relative_path` at all? False on an unborn branch too.
bool State.is_in_head_tree(bytes relative_path) {
    match (head_tree_id(gitdir)) {
        case Some(str tid): {
            return find_in_tree(gitdir, tid, relative_path).is_some();
        }
        case None: {
            return false;
        }
    }
}

/// `relative_path`'s index entry now names a fresh blob of `content`, mode kept,
/// stat fields reset so the next `status` re-hashes it. `said` becomes the
/// status-line message on success.
bool State.did_set_index_blob(bytes relative_path, bytes content, str said) {
    str blob_id = "";
    match (GIT_object.write_blob(gitdir, content)) {
        case Ok(str id): {
            blob_id = id;
        }
        case Err(GIT_object.Error error): {
            message = "write_blob: " + error.to_str();
            return false;
        }
    }
    GIT_index.Index index = read_index(gitdir);
    int mode = 0o100644;
    match (find_index_entry(index, relative_path)) {
        case Some(GIT_index.Entry entry): {
            mode = entry.mode;
        }
        case None: {
        }
    }
    replace_entry(index, GIT_index.Entry(0, 0, 0, 0, 0, 0, mode, 0, 0, -1, blob_id, 0, false, relative_path));
    match (GIT_index.write(gitdir, index)) {
        case Ok: {
            message = said;
            return true;
        }
        case Err(GIT_index.Error error): {
            message = "index write: " + error.to_str();
            return false;
        }
    }
}

bool State.did_drop_index_entry(bytes relative_path, str said) {
    GIT_index.Index index = read_index(gitdir);
    remove_entry(index, relative_path);
    match (GIT_index.write(gitdir, index)) {
        case Ok: {
            message = said;
            return true;
        }
        case Err(GIT_index.Error error): {
            message = "index write: " + error.to_str();
            return false;
        }
    }
}

/// Write the commit-message template at `commit_message_path`, unless something
/// -- a previous `e`, or a person's own `git commit` in another terminal --
/// already left one there, and ask `gitui.m31`'s own driver to actually
/// launch `$EDITOR` on it once the terminal is safe to hand over.
///
/// This cannot call `os.run` itself: the terminal is still in raw mode with
/// the alternate screen on, owned by a `term.Session` this state has no
/// access to (`TUI_app.Loop.run`'s own scope). Setting `is_editor_wanted` and
/// letting the which-key's `e` return `Quit` is what unwinds that scope --
/// see this module's own header, "launching `$EDITOR`, and the terminal
/// handoff that takes" -- so `launch_editor` below is where the actual
/// launch happens, called back once the terminal is cooked again.
pub void State.edit_message() {
    if (!fs.exists(commit_message_path)) {
        match (io.write(commit_message_path, commit_template())) {
            case Ok: {
            }
            case Err(io.Error error): {
                message = "cannot write " + commit_message_path + ": " + error.to_str();
                return;
            }
        }
    }
    is_editor_wanted = true;
    message = "launching editor...";
}

/// Actually launch `$EDITOR` (or `vi`) on `commit_message_path` and act on how it
/// ended -- called by `gitui.m31`'s driver after `TUI_app.Loop.run` has
/// returned with `is_editor_wanted` set, so the terminal `os.run`'s child
/// inherits is the real, cooked one, not the raw alternate screen this
/// program draws on.
///
/// Every `os.run` outcome the caller needs handled:
///
///   - exited 0: read `commit_message_path` back and try to finish the commit --
///     `finish_commit` is exactly "the same stripping/empty-message-refusal
///     logic that already exists", so this calls it rather than repeating
///     it, which also keeps `f`'s own behaviour the one place it is defined.
///   - exited nonzero, or killed by a signal: a cancelled edit, real git's
///     own treatment of an editor that did not report success (its own
///     "There was a problem with the editor" -- a signal, `^C` most often,
///     gets its own status line, a more unusual case worth naming
///     differently even though the outcome -- leave everything as it is --
///     is the same). `is_commit_open` stays true and the message file is left
///     untouched, so `e` can be pressed again, `f` can still try to finish
///     whatever is on disk right now, and `a` can still discard it.
///   - `os.run` itself failed (`Err`) -- no `$EDITOR`, no `vi`, nothing
///     found on `$PATH` -- there is no process to have run at all, so this
///     falls back to exactly the original, pre-`os.run` behaviour: the
///     template is already on disk (`edit_message` wrote it before setting
///     `is_editor_wanted`), and the operator is told to edit it externally.
pub void State.launch_editor() {
    if (is_editor_for_branch) {
        is_editor_for_branch = false;
        launch_branch_editor();
        return;
    }
    str editor = pick_editor(os.env("EDITOR"));
    match (os.run([editor, commit_message_path])) {
        case Ok(os.ExitStatus exit_status): {
            match (exit_status) {
                case Exited(int code): {
                    if (code == 0) {
                        finish_commit();
                    } else {
                        message = "editor '" + editor + "' exited " + code.to_str() + "; message left at " + commit_message_path + " -- e to edit again, f to finish, a to abort";
                    }
                }
                case Signaled(int sig): {
                    message = "editor '" + editor + "' was killed by signal " + sig.to_str() + "; message left at " + commit_message_path + " -- e to edit again, f to finish, a to abort";
                }
            }
        }
        case Err(io.Error error): {
            message = "cannot launch '" + editor + "' (" + error.to_str() + "); edit " + commit_message_path + " in another terminal, then press f to finish or a to abort";
        }
    }
}

/// Discard the commit-in-progress: drop the template (if a person never got
/// around to editing it, there is nothing to keep) and close the overlay.
// --- branches: listing, checking out, creating ------------------------------

/// `tip`'s first message line, for a branch row's label -- `""` if the commit
/// cannot be read (a ref pointing at something this cannot parse is shown by
/// name and id alone rather than hidden).
str State.tip_subject(str tip) {
    match (GIT_object.read(gitdir, tip)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    return first_line(commit.message);
                }
                case Blob: {
                    return "";
                }
                case Tree(_): {
                    return "";
                }
                case Tag: {
                    return "";
                }
            }
        }
        case Err: {
            return "";
        }
    }
}

/// Check out the branch under the cursor (`b`, then `c`): `GIT_checkout.checkout`
/// with every refusal it makes shown in the message line, word for word --
/// a dirty file, an untracked file in the way, a submodule. A no-op with a
/// message on anything that is not a branch row, or on the current branch.
pub void State.checkout_current() {
    str name = "";
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            if (row.node.id.starts_with("branch:")) {
                name = row.node.id.substr(7, row.node.id.size());
            }
        }
        case None: {
        }
    }
    if (name == "") {
        message = "checkout: put the cursor on a branch first";
        return;
    }
    checkout_branch(name);
}

/// `git switch <name>`, by name -- `checkout_current`'s work, callable from a
/// test harness without an outline.
pub void State.checkout_branch(str name) {
    for (BranchRow branch_row in branch_rows) {
        if (branch_row.branch.name == name) {
            if (branch_row.branch.is_current) {
                message = "already on " + name;
                return;
            }
            match (GIT_checkout.checkout(gitdir, worktree, branch_row.branch.id, branch_row.branch.full)) {
                case Ok(GIT_checkout.Summary summary): {
                    message = "switched to " + name + " (" + summary.written.to_str() + " written, " + summary.removed.to_str() + " removed)";
                    reload();
                }
                case Err(GIT_checkout.Error error): {
                    message = "checkout refused: " + error.to_str();
                }
            }
            return;
        }
    }
    message = "no such branch: " + name;
}

/// `b`, then `n`: ask for a name the same way `c` asks for a message -- a
/// file (`branch_name_path`) handed to `$EDITOR` once `TUI_app.Loop.run` has
/// given the terminal back (see `edit_message`'s own header for why the
/// launch cannot happen here). `launch_branch_editor` reads it back.
pub void State.new_branch() {
    match (io.write(branch_name_path, "\n# Name the new branch on the first line. It starts at HEAD and\n# becomes the current branch. An empty name aborts.\n")) {
        case Ok: {
        }
        case Err(io.Error error): {
            message = "cannot write " + branch_name_path + ": " + error.to_str();
            return;
        }
    }
    is_editor_for_branch = true;
    is_editor_wanted = true;
    message = "launching editor...";
}

/// The second half of `new_branch`, after `$EDITOR` has run: the first
/// non-comment line is the name; `GIT_checkout.create_branch` does the rest.
pub void State.launch_branch_editor() {
    str editor = pick_editor(os.env("EDITOR"));
    bool has_run = false;
    match (os.run([editor, branch_name_path])) {
        case Ok(os.ExitStatus exit_status): {
            match (exit_status) {
                case Exited(int code): {
                    if (code == 0) {
                        has_run = true;
                    } else {
                        message = "editor '" + editor + "' exited " + code.to_str() + "; no branch created";
                    }
                }
                case Signaled(int sig): {
                    message = "editor '" + editor + "' was killed by signal " + sig.to_str() + "; no branch created";
                }
            }
        }
        case Err(io.Error error): {
            message = "cannot launch '" + editor + "' (" + error.to_str() + "); no branch created";
        }
    }
    if (has_run) {
        finish_new_branch();
    }
    if (fs.exists(branch_name_path)) {
        match (fs.remove(branch_name_path)) {
            case Ok: {
            }
            case Err: {
            }
        }
    }
}

/// Create the branch named in `branch_name_path` and switch to it -- split
/// from `launch_branch_editor` so a harness can write the file itself and
/// drive this directly, the way `t_gitclient_ops.m31`'s `commit` does for
/// `finish_commit`.
pub void State.finish_new_branch() {
    str raw = "";
    match (io.read(branch_name_path)) {
        case Ok(str branch_text): {
            raw = branch_text;
        }
        case Err(io.Error error): {
            message = "cannot read " + branch_name_path + ": " + error.to_str();
            return;
        }
    }
    str name = strip_comment_lines(raw).trim();
    if (name == "") {
        message = "no branch created (empty name)";
        return;
    }
    match (GIT_checkout.create_branch(gitdir, name)) {
        case Ok: {
            message = "created and switched to " + name;
            reload();
        }
        case Err(GIT_checkout.Error error): {
            message = "new branch refused: " + error.to_str();
        }
    }
}

pub void State.abort_commit() {
    if (fs.exists(commit_message_path)) {
        match (fs.remove(commit_message_path)) {
            case Ok: {
            }
            case Err: {
            }
        }
    }
    is_commit_open = false;
    is_amending = false;
    message = "commit aborted";
}

/// `c` then `A`: turn the open commit overlay into `git commit --amend`.
/// HEAD's own message is written to `commit_message_path` (with the template's
/// comment lines after it, so `e` opens something a person recognises and
/// `f` straight away is `--amend --no-edit`), and `is_amending` tells
/// `finish_commit` to replace HEAD rather than add to it. Refused, with the
/// overlay left open on its ordinary meaning, when there is no HEAD to
/// amend: an unborn branch, or a HEAD whose commit cannot be read.
pub void State.start_amend() {
    str head_id = "";
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    head_id = id;
                }
                case Unborn(str name): {
                    message = "nothing to amend: no commits yet on " + branch_name(name);
                    return;
                }
                case Detached(str id): {
                    head_id = id;
                }
            }
        }
        case Err(GIT_refs.Error error): {
            message = "nothing to amend: refs.head: " + error.to_str();
            return;
        }
    }
    bytes head_message = [];
    match (GIT_object.read(gitdir, head_id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    head_message = commit.message;
                }
                case Blob: {
                    message = "nothing to amend: HEAD is not a commit";
                    return;
                }
                case Tree(List<GIT_object.Entry> ignored): {
                    message = "nothing to amend: HEAD is not a commit";
                    return;
                }
                case Tag: {
                    message = "nothing to amend: HEAD is not a commit";
                    return;
                }
            }
        }
        case Err(GIT_object.Error error): {
            message = "nothing to amend: cannot read HEAD's commit: " + error.to_str();
            return;
        }
    }
    str prefill = head_message.utf8().or("");
    if (!prefill.ends_with("\n")) {
        prefill = prefill + "\n";
    }
    match (io.write(commit_message_path, prefill + commit_template())) {
        case Ok: {
        }
        case Err(io.Error error): {
            message = "cannot write " + commit_message_path + ": " + error.to_str();
            return;
        }
    }
    is_amending = true;
    message = "amending " + head_id.substr(0, 7) + ": e to edit its message, f to finish, a to abort";
}

/// Read `commit_message_path` back, strip it the way git's default cleanup does,
/// and either refuse (an empty result, git's own "Aborting commit due to
/// empty commit message") or actually commit: `build_tree` over the current
/// index, `GIT_object.write_commit` with HEAD as the sole parent (none for an
/// unborn branch), and `GIT_refs.update` to move the branch -- or `HEAD` itself,
/// detached -- forward by compare-and-swap against the value just read, so a
/// second writer racing this one is refused rather than silently overwritten
/// (`GIT_refs.m31`'s own guarantee).
pub void State.finish_commit() {
    str raw = "";
    match (io.read(commit_message_path)) {
        case Ok(str edited_text): {
            raw = edited_text;
        }
        case Err(io.Error error): {
            message = "cannot read " + commit_message_path + ": " + error.to_str();
            return;
        }
    }
    str commit_message = strip_comment_lines(raw);
    if (commit_message == "") {
        message = "aborting commit due to empty commit message";
        is_commit_open = false;
        is_amending = false;
        return;
    }
    GIT_index.Index index = read_index(gitdir);
    str tree_id = "";
    match (build_tree(gitdir, index.entries)) {
        case Ok(str tree): {
            tree_id = tree;
        }
        case Err(GIT_object.Error error): {
            message = "write_tree: " + error.to_str();
            return;
        }
    }
    List<str> parents = [];
    str ref_name = "HEAD";
    str expect_old = "";
    bool has_old = false;
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    parents.push(id);
                    ref_name = name;
                    expect_old = id;
                    has_old = true;
                }
                case Unborn(str name): {
                    ref_name = name;
                    expect_old = "";
                    has_old = true;
                }
                case Detached(str id): {
                    parents.push(id);
                    ref_name = "HEAD";
                    expect_old = id;
                    has_old = true;
                }
            }
        }
        case Err(GIT_refs.Error error): {
            message = "refs.head: " + error.to_str();
            return;
        }
    }
    GIT_object.Ident author = author_ident();
    if (is_amending) {
        // `--amend`: the new commit takes HEAD's place, so it gets HEAD's own
        // parents and author (date and zone included -- real git keeps the
        // original authorship and only the committer is "now"); HEAD itself
        // is what the compare-and-swap below expects to replace.
        if (parents.size() == 0) {
            message = "nothing to amend: no commits yet";
            return;
        }
        match (GIT_object.read(gitdir, parents[0])) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        parents = commit.parents;
                        author = commit.author;
                    }
                    case Blob: {
                        message = "amend: HEAD is not a commit";
                        return;
                    }
                    case Tree(List<GIT_object.Entry> ignored): {
                        message = "amend: HEAD is not a commit";
                        return;
                    }
                    case Tag: {
                        message = "amend: HEAD is not a commit";
                        return;
                    }
                }
            }
            case Err(GIT_object.Error error): {
                message = "amend: cannot read HEAD's commit: " + error.to_str();
                return;
            }
        }
    }
    GIT_object.Commit commit = GIT_object.Commit(tree_id, parents, author, committer_ident(), [], (commit_message + "\n").to_bytes());
    str commit_id = "";
    match (GIT_object.write_commit(gitdir, commit)) {
        case Ok(str id): {
            commit_id = id;
        }
        case Err(GIT_object.Error error): {
            message = "write_commit: " + error.to_str();
            return;
        }
    }
    Option<str> want = Option<str>.None;
    if (has_old) {
        want = Option<str>.Some(expect_old);
    }
    match (GIT_refs.update(gitdir, ref_name, commit_id, want)) {
        case Ok: {
        }
        case Err(GIT_refs.Error error): {
            message = "refs.update: " + error.to_str();
            return;
        }
    }
    if (fs.exists(commit_message_path)) {
        match (fs.remove(commit_message_path)) {
            case Ok: {
            }
            case Err: {
            }
        }
    }
    if (is_amending) {
        message = "amended: HEAD is now " + commit_id.substr(0, 7);
    } else {
        message = "committed " + commit_id.substr(0, 7);
    }
    is_commit_open = false;
    is_amending = false;
    reload();
}

str State.status_line() {
    if (message != "") {
        return message;
    }
    return branch_label;
}

List<TUI_widget.Span> State.footer_spans(TUI_style.Theme theme) {
    List<TUI_widget.Span> out = [];
    out.push(TUI_widget.Span(" j/k"));
    out.push(TUI_widget.Span(" move  "));
    out.push(TUI_widget.Span("h/l", style: theme.accent));
    out.push(TUI_widget.Span(" scroll  "));
    out.push(TUI_widget.Span("enter", style: theme.accent));
    out.push(TUI_widget.Span(" toggle  "));
    out.push(TUI_widget.Span("s", style: theme.accent));
    if (is_diff_open) {
        out.push(TUI_widget.Span(" stage hunk  "));
    } else {
        out.push(TUI_widget.Span(" stage  "));
    }
    out.push(TUI_widget.Span("u", style: theme.accent));
    if (is_diff_open) {
        out.push(TUI_widget.Span(" unstage hunk  "));
    } else {
        out.push(TUI_widget.Span(" unstage  "));
    }
    out.push(TUI_widget.Span("d", style: theme.accent));
    out.push(TUI_widget.Span(" diff  "));
    out.push(TUI_widget.Span("x", style: theme.accent));
    out.push(TUI_widget.Span(" discard  "));
    if (is_diff_open) {
        out.push(TUI_widget.Span("q/esc/backspace", style: theme.accent));
        out.push(TUI_widget.Span(" back  "));
    }
    out.push(TUI_widget.Span("c", style: theme.accent));
    out.push(TUI_widget.Span(" commit  "));
    out.push(TUI_widget.Span("b", style: theme.accent));
    out.push(TUI_widget.Span(" branch  "));
    out.push(TUI_widget.Span("P", style: theme.accent));
    out.push(TUI_widget.Span(" push  "));
    out.push(TUI_widget.Span("F", style: theme.accent));
    out.push(TUI_widget.Span(" pull  "));
    out.push(TUI_widget.Span("J", style: theme.accent));
    out.push(TUI_widget.Span(" jump  "));
    out.push(TUI_widget.Span("w", style: theme.accent));
    out.push(TUI_widget.Span(" focus  "));
    out.push(TUI_widget.Span("r", style: theme.accent));
    out.push(TUI_widget.Span(" refresh"));
    if (!is_diff_open) {
        out.push(TUI_widget.Span("  "));
        out.push(TUI_widget.Span("q", style: theme.accent));
        out.push(TUI_widget.Span(" quit"));
    }
    return out;
}

/// The frame: the primary document -- either the outline (and, toggled on,
/// the jump list beside it), or, once `d` has been pressed, the hunk-level
/// diff view in its place -- then the two-row footer `TUI_footer.split`
/// reserves -- a status line and the fixed key legend -- and, on top of
/// everything, the commit which-key overlay when it is open. See
/// `docs/design.md`'s locked layout: one primary document, one optional
/// jump-list panel, a persistent footer, and overlays drawn over all of it
/// rather than replacing any of it. The diff view is not an overlay: it
/// REPLACES the document the way `tui's `browse.m31``'s preview pane
/// changes with the selection, which is why the jump list (synced to the
/// outline's own entries) is not shown alongside it.
pub void State.draw(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_style.Theme theme = TUI_style.Theme.plain;
    str frame_title = worktree;
    if (frame_title == ".") {
        frame_title = "git";
    }
    TUI_widget.Block frame = TUI_widget.Block(title: frame_title, borders: TUI_widget.Borders.Rounded);
    frame.render(buffer, area);
    TUI_geometry.Rect body = frame.inner(area);
    List<TUI_geometry.Rect> bands = TUI_footer.split(body, 2);
    TUI_geometry.Rect main = bands[0];
    TUI_geometry.Rect footer_area = bands[1];
    if (is_diff_open) {
        draw_diff(buffer, main);
    } else {
        TUI_geometry.Rect outline_area = main;
        if (is_jump_shown) {
            List<TUI_geometry.Rect> columns = TUI_geometry.columns(main, [TUI_geometry.Constraint.Fill(1), TUI_geometry.Constraint.Length(28)]);
            outline_area = columns[0];
            outline.render(buffer, outline_area);
            TUI_widget.Block jump_block = TUI_widget.Block(title: "jump", borders: TUI_widget.Borders.Single);
            jump_block.render(buffer, columns[1]);
            jump.render(buffer, jump_block.inner(columns[1]));
        } else {
            outline.render(buffer, outline_area);
        }
    }
    TUI_widget.Line status_row = TUI_widget.Line([TUI_widget.Span(" " + status_line(), style: theme.dim)]);
    status_row.render(buffer, TUI_geometry.Rect(footer_area.x, footer_area.y, footer_area.width, 1));
    TUI_footer.Footer(footer_spans(theme)).render(buffer, TUI_geometry.Rect(footer_area.x, footer_area.y + 1, footer_area.width, 1));
    if (is_commit_open) {
        str title = "commit";
        str finish = "finish: write the commit";
        if (is_amending) {
            title = "amend HEAD";
            finish = "finish: replace HEAD with the amended commit";
        }
        TUI_menu.WhichKey which_key = TUI_menu.WhichKey(title, [TUI_menu.Item("e", "edit message in $EDITOR (" + commit_message_path + ")"), TUI_menu.Item("f", finish), TUI_menu.Item("A", "amend HEAD: its message prefilled, its parents and author kept"), TUI_menu.Item("a", "abort")]);
        which_key.render(buffer, body);
    }
    if (is_confirm_open) {
        str what = "changes to " + confirm_path.utf8().or("<non-utf8>");
        if (confirm_kind == "untracked") {
            what = "untracked file " + confirm_path.utf8().or("<non-utf8>") + " (it will be removed)";
        } else if (confirm_kind == "staged") {
            what = "staged changes to " + confirm_path.utf8().or("<non-utf8>") + " (index and working tree)";
        }
        TUI_menu.WhichKey which_key = TUI_menu.WhichKey("discard " + what + "?", [TUI_menu.Item("y", "yes, discard"), TUI_menu.Item("any other key", "no, keep it")]);
        which_key.render(buffer, body);
    }
    if (is_branch_open) {
        TUI_menu.WhichKey which_key = TUI_menu.WhichKey("branch", [TUI_menu.Item("c", "check out the branch under the cursor"), TUI_menu.Item("n", "new branch from HEAD: name it in $EDITOR, then switch to it"), TUI_menu.Item("a", "abort")]);
        which_key.render(buffer, body);
    }
    if (is_push_open) {
        TUI_menu.WhichKey which_key = TUI_menu.WhichKey("push", [TUI_menu.Item("p", "push current branch to origin (fast-forward only)")]);
        which_key.render(buffer, body);
    }
    if (is_pull_open) {
        TUI_menu.WhichKey which_key = TUI_menu.WhichKey("pull", [TUI_menu.Item("p", "pull current branch from origin (fast-forward only)")]);
        which_key.render(buffer, body);
    }
}

/// The diff view, in place of the outline: a bordered block naming the file
/// (`diff_title`), and inside it either "binary files differ" (git's own
/// wording, `is_diff_binary`) or `diff_view` itself -- a `DiffView` whose
/// `at()`/`move()` already give hunk- and line-granular addressing, even
/// though nothing in this change acts on that address yet.
void State.draw_diff(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_widget.Block block = TUI_widget.Block(title: "diff: " + diff_title, borders: TUI_widget.Borders.Single);
    block.render(buffer, area);
    TUI_geometry.Rect inner = block.inner(area);
    if (is_diff_binary) {
        TUI_widget.Paragraph("binary files differ").render(buffer, inner);
        return;
    }
    diff_view.render(buffer, inner);
}

/// One decoded key, dispatched exactly as `tui's `browse.m31``'s own
/// `State.handle` is: every `term.Code` variant named, so a key this client
/// does not use is `Continue` rather than missing from the match entirely
/// (there is no `default`, reference §5.6).
pub TUI_app.Action State.handle(term.Event event) {
    match (event) {
        case Key(term.Key key): {
            return handle_key(key.code);
        }
        case Mouse(_): {
            return TUI_app.Action.Continue;
        }
        case Paste(_): {
            return TUI_app.Action.Continue;
        }
        case Unknown(_): {
            return TUI_app.Action.Continue;
        }
    }
}

TUI_app.Action State.handle_key(term.Code code) {
    if (is_confirm_open) {
        return handle_confirm_key(code);
    }
    if (is_commit_open) {
        return handle_commit_key(code);
    }
    if (is_branch_open) {
        return handle_branch_key(code);
    }
    if (is_push_open) {
        return handle_push_key(code);
    }
    if (is_pull_open) {
        return handle_pull_key(code);
    }
    if (is_diff_open) {
        return handle_diff_key(code);
    }
    match (code) {
        case Char(int character): {
            return handle_char(character);
        }
        case Enter: {
            handle_enter();
            return TUI_app.Action.Redraw;
        }
        case Escape: {
            return TUI_app.Action.Quit;
        }
        case Up: {
            move_cursor(-1);
            return TUI_app.Action.Redraw;
        }
        case Down: {
            move_cursor(1);
            return TUI_app.Action.Redraw;
        }
        case Backspace: {
            return TUI_app.Action.Continue;
        }
        case Tab: {
            return TUI_app.Action.Continue;
        }
        case BackTab: {
            return TUI_app.Action.Continue;
        }
        case Right: {
            outline.scroll_h(SCROLL_H_STEP);
            return TUI_app.Action.Redraw;
        }
        case Left: {
            outline.scroll_h(-SCROLL_H_STEP);
            return TUI_app.Action.Redraw;
        }
        case Home: {
            return TUI_app.Action.Continue;
        }
        case End: {
            return TUI_app.Action.Continue;
        }
        case PageUp: {
            return TUI_app.Action.Continue;
        }
        case PageDown: {
            return TUI_app.Action.Continue;
        }
        case Insert: {
            return TUI_app.Action.Continue;
        }
        case Delete: {
            return TUI_app.Action.Continue;
        }
        case F(_): {
            return TUI_app.Action.Continue;
        }
    }
}

TUI_app.Action State.handle_char(int character) {
    if (character == 'q') {
        return TUI_app.Action.Quit;
    }
    if (character == 'j') {
        step_or_move(1);
        return TUI_app.Action.Redraw;
    }
    if (character == 'k') {
        step_or_move(-1);
        return TUI_app.Action.Redraw;
    }
    if (character == 'h') {
        outline.scroll_h(-SCROLL_H_STEP);
        return TUI_app.Action.Redraw;
    }
    if (character == 'l') {
        outline.scroll_h(SCROLL_H_STEP);
        return TUI_app.Action.Redraw;
    }
    if (character == 's') {
        stage_current();
        return TUI_app.Action.Redraw;
    }
    if (character == 'u') {
        unstage_current();
        return TUI_app.Action.Redraw;
    }
    if (character == 'd') {
        show_diff_current();
        return TUI_app.Action.Redraw;
    }
    if (character == 'c') {
        is_commit_open = true;
        is_amending = false;
        return TUI_app.Action.Redraw;
    }
    if (character == 'x') {
        discard_current();
        return TUI_app.Action.Redraw;
    }
    if (character == 'b') {
        is_branch_open = true;
        return TUI_app.Action.Redraw;
    }
    if (character == 'P') {
        is_push_open = true;
        return TUI_app.Action.Redraw;
    }
    if (character == 'F') {
        is_pull_open = true;
        return TUI_app.Action.Redraw;
    }
    if (character == 'r') {
        reload();
        return TUI_app.Action.Redraw;
    }
    if (character == 'J') {
        is_jump_shown = !is_jump_shown;
        return TUI_app.Action.Redraw;
    }
    if (character == 'w') {
        is_jump_focused = !is_jump_focused;
        return TUI_app.Action.Redraw;
    }
    return TUI_app.Action.Continue;
}

void State.step_or_move(int delta) {
    if (is_jump_focused && is_jump_shown) {
        jump.step(delta);
    } else {
        move_cursor(delta);
    }
}

/// `Enter` folds or unfolds the row under the cursor everywhere else
/// (`toggle_current`) -- a leaf row has nothing to fold, so that is already
/// a no-op on an author/date/message line. A commit's own file row is the
/// one leaf where `Enter` means something: pop its diff view directly,
/// the same one `d` opens for a staged/unstaged/untracked row, rather than
/// doing nothing. Checked by id, not by `r.node.has_children()`, so an
/// empty "Files changed (0)" section itself (there is nothing to diff a
/// merge whose first-parent diff touched no files) still just folds.
void State.handle_enter() {
    if (is_jump_focused && is_jump_shown) {
        jump.did_activate(outline);
        is_jump_focused = false;
        return;
    }
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            if (row.node.id.contains(":file:")) {
                show_diff_current();
                return;
            }
            if (row.node.id == LOAD_MORE_ID) {
                log_limit = log_limit + LOG_PAGE;
                reload();
                return;
            }
        }
        case None: {
        }
    }
    toggle_current();
}

/// Push the current branch to the same-named branch on `origin`, over
/// smart HTTP, fast-forward only. The outcome -- success or the reason it
/// did not happen -- is the status line's message; a password is never part
/// of it (`GIT_http_push.parse_remote` strips it from the URL before anything
/// else sees the URL).
pub void State.push_current() {
    is_push_open = false;
    str refname = "";
    str id = "";
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str old_id): {
                    refname = name;
                    id = old_id;
                }
                case Unborn(str name): {
                    message = "push: " + name + " has no commits yet";
                    return;
                }
                case Detached(str old_id): {
                    message = "push: HEAD is detached; check out a branch first";
                    return;
                }
            }
        }
        case Err(GIT_refs.Error error): {
            message = "push: " + error.to_str();
            return;
        }
    }
    Option<str> url = GIT_config.get(gitdir, "remote", "origin", "url");
    if (!url.is_some()) {
        message = "push: no remote 'origin' in .git/config";
        return;
    }
    GIT_http_push.Remote remote = GIT_http_push.Remote("", Option<GIT_http_push.Credentials>.None);
    match (GIT_http_push.parse_remote(url.or(""))) {
        case Ok(GIT_http_push.Remote parsed): {
            remote = parsed;
        }
        case Err(GIT_http_push.Error error): {
            message = "push: " + error.to_str();
            return;
        }
    }
    match (GIT_http_push.push(gitdir, remote, refname, id)) {
        case Ok(GIT_http_push.Report report): {
            if (report.is_ok) {
                message = "pushed " + refname + " to origin";
            } else {
                message = "push refused by origin: " + report.reason;
            }
        }
        case Err(GIT_http_push.Error error): {
            message = "push: " + error.to_str();
        }
    }
    reload();
}

TUI_app.Action State.handle_push_key(term.Code code) {
    match (code) {
        case Char(int character): {
