// `TUI_app.Loop.run` with one addition: a `Ticker` the loop calls while idle.
//
// `Loop.run` reads with a timeout (`tick_ms`) and does nothing when it times
// out, so a program cannot notice anything that happens without a key -- here,
// the worktree changing under it. This is that loop's body, copied with the
// timeout case made to call `ticker.tick()` (answering true means redraw).
// Everything else is as `TUI_app.Loop.run` documents: raw mode in, the terminal restored on every
// path out by the `Session`'s destructor, resize noticed once per tick, the
// first frame and every resized one drawn with `TUI_diff.full`, the rest as a
// diff against the frame before.

import io;
import term;
import tui.TUI_app;
import tui.TUI_buffer;
import tui.TUI_diff;
import tui.TUI_widget;

/// What the loop asks while idle.
pub interface Ticker {
    /// Called once per timed-out read. True: something changed, redraw.
    bool tick();
}

pub Result<int, term.Error> run(TUI_app.Loop loop, TUI_widget.Widget view, TUI_app.Handler on_event, Ticker ticker) {
    if (!term.is_terminal(0)) {
        return Result<int, term.Error>.Err(term.Error.NotATerminal);
    }
    match (term.raw()) {
        case Err(term.Error error): {
            return Result<int, term.Error>.Err(error);
        }
        case Ok(term.Session session): {
            session.on_exit(loop.leave);
            term.Writer writer = term.writer(io.stdout());
            writer.put(loop.enter);
            term.Reader reader = term.reader();
            term.Size window_size = TUI_app.screen_size();
            TUI_buffer.Buffer previous = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
            TUI_buffer.Buffer next = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
            view.render(previous, previous.area());
            writer.put_bytes(TUI_diff.full(previous, loop.depth));
            flush(writer);
            bool is_running = true;
            while (is_running) {
                bool should_redraw = false;
                match (reader.read(loop.tick_ms)) {
                    case Ok(term.Input inp): {
                        match (inp) {
                            case Got(term.Event event): {
                                match (on_event.handle(event)) {
                                    case Continue: {
                                    }
                                    case Redraw: {
                                        should_redraw = true;
                                    }
                                    case Quit: {
                                        is_running = false;
                                    }
                                }
                            }
                            case Timeout: {
                                if (ticker.tick()) {
                                    should_redraw = true;
                                }
                            }
                            case End: {
                                is_running = false;
                            }
                        }
                    }
                    case Err(term.Error error): {
                        is_running = false;
                    }
                }
                if (is_running) {
                    term.Size now = TUI_app.screen_size();
                    bool did_resize = TUI_app.has_resized(window_size, now);
                    window_size = now;
                    if (should_redraw || did_resize) {
                        if (did_resize) {
                            next = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
                            previous = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
                        } else {
                            next.clear();
                        }
                        view.render(next, next.area());
                        if (did_resize) {
                            writer.put_bytes(TUI_diff.full(next, loop.depth));
                        } else {
                            writer.put_bytes(TUI_diff.diff(previous, next, loop.depth));
                        }
                        flush(writer);
                        TUI_buffer.Buffer shown = previous;
                        previous = next;
                        next = shown;
                    }
                }
            }
        }
    }
    return Result<int, term.Error>.Ok(0);
}

void flush(term.Writer writer) {
    match (writer.flush()) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}
