// Applying ONE hunk of a diff, exactly -- the piece `git add -p` and
// `git reset -p` are built on, for `GIT_client.m31`'s hunk-level `s`/`u` in
// the diff view.
//
// API
// ---
//   GIT_patch.apply_hunk(old, new, k, context:)   -> Option<bytes>
//       `old` with only the k-th hunk of diff(old, new) applied: the
//       index's new content when staging hunk k of an unstaged diff.
//   GIT_patch.revert_hunk(old, new, k, context:)  -> Option<bytes>
//       `new` with only the k-th hunk of diff(old, new) undone: the index's
//       new content when unstaging hunk k of a staged (HEAD vs index) diff.
//   GIT_patch.hunk_count(old, new, context:)      -> int  (0 for a binary pair)
//
//   GIT_patch.apply_lines(old_text, ops, selected)   -> Option<bytes>
//       `old_text` with the new side taken for the SELECTED ops of the edit
//       script `ops` (indices into it) and the old side for all the rest:
//       staging individual lines (`git add -p`'s `e`, or a line-range
//       stage in a GUI).
//   GIT_patch.revert_lines(new_text, ops, selected)  -> Option<bytes>
//       `new_text` with the old side taken for the selected ops and the new
//       side for the rest: unstaging or discarding individual lines.
//   GIT_patch.change_ops(ops, span)                  -> List<int>
//       the indices of the added and removed lines inside a hunk's span, to
//       select a whole hunk (or to start from it) with the two above.
//
// `None` from the hunk functions: the pair is binary (`diff.is_binary`, no line diff
// exists to pick a hunk from) or `k` names no hunk.
//
// --- why this works on `diff.Op`s, not on `TUI_diff_view.Hunk`s ------------
//
// A rendered `TUI_diff_view.Line.text` is a `str` with its line terminator
// stripped, and a line that is not UTF-8 renders as a hex placeholder
// (`GIT_hunks.m31`'s `line_text`) -- fine to look at, lossy to rebuild a file
// from: `\n` vs `\r\n` vs no terminator on the last line would all come
// back as the same text. `diff.Op.line` still holds every byte of every
// line, terminator included (that is what makes `diff.reconstruct_old`/
// `reconstruct_new` exact), so this re-runs the same `GIT_xdiff.diff_text` the view
// was built from and edits the op script instead. `GIT_hunks.spans` is the one
// shared definition of where hunk k starts and ends, so the hunk the cursor
// is on in a `DiffView` and the span edited here are the same hunk by
// construction, not two groupings that happen to agree today.
//
// Applying hunk k = rebuild the file taking, for every op OUTSIDE span k,
// the `old` side (Keep and Remove lines), and for every op INSIDE it, the
// `new` side (Keep and Add lines). Reverting is the mirror image. Both are
// total over the script, which is why the round-trip property `t_patch.m31`
// checks holds exactly: apply hunk 0 repeatedly and `old` becomes `new`;
// revert hunk 0 repeatedly and `new` becomes `old`.

import text.diff;
import GIT_hunks;
import GIT_xdiff;

/// `old` with exactly one hunk of diff(old, new) applied.
pub Option<bytes> apply_hunk(bytes old, bytes new, int hunk_index, int context = GIT_hunks.DEFAULT_CONTEXT) {
    match (GIT_xdiff.diff_text(old, new)) {
        case Binary: {
            return Option<bytes>.None;
        }
        case Lines(List<diff.Op> ops): {
            List<GIT_hunks.Span> sps = GIT_hunks.spans(ops, context: context);
            if (hunk_index < 0 || hunk_index >= sps.size()) {
                return Option<bytes>.None;
            }
            return Option<bytes>.Some(rebuild(ops, sps[hunk_index], true));
        }
    }
}

/// `new` with exactly one hunk of diff(old, new) undone.
pub Option<bytes> revert_hunk(bytes old, bytes new, int hunk_index, int context = GIT_hunks.DEFAULT_CONTEXT) {
    match (GIT_xdiff.diff_text(old, new)) {
        case Binary: {
            return Option<bytes>.None;
        }
        case Lines(List<diff.Op> ops): {
            List<GIT_hunks.Span> sps = GIT_hunks.spans(ops, context: context);
            if (hunk_index < 0 || hunk_index >= sps.size()) {
                return Option<bytes>.None;
            }
            return Option<bytes>.Some(rebuild(ops, sps[hunk_index], false));
        }
    }
}

/// How many hunks diff(old, new) has -- 0 for a binary pair, the same count
/// `GIT_hunks.hunks` would hand a `DiffView`.
pub int hunk_count(bytes old, bytes new, int context = GIT_hunks.DEFAULT_CONTEXT) {
    match (GIT_xdiff.diff_text(old, new)) {
        case Binary: {
            return 0;
        }
        case Lines(List<diff.Op> ops): {
            return GIT_hunks.spans(ops, context: context).size();
        }
    }
}

// `is_applying`: outside the span take the old side, inside take the new side
// (the file after staging this one hunk). Otherwise the mirror: outside the
// span take the new side, inside take the old side (the file after
// unstaging this one hunk).
bytes rebuild(List<diff.Op> ops, GIT_hunks.Span span, bool is_applying) {
    bytes out = [];
    int position = 0;
    int op_count = ops.size();
    while (position < op_count) {
        bool is_inside = position >= span.start && position < span.end;
        bool is_taking_new = is_inside == is_applying;
        match (ops[position].kind) {
            case Keep: {
                out.extend(ops[position].line);
            }
            case Add: {
                if (is_taking_new) {
                    out.extend(ops[position].line);
                }
            }
            case Remove: {
                if (!is_taking_new) {
                    out.extend(ops[position].line);
                }
            }
        }
        position = position + 1;
    }
    return out;
}

// --- single lines ---------------------------------------------------------------
//
// A selection is a list of indices into an edit script (`ops`, as `GIT_xdiff.diff_text`
// returned it and `GIT_hunks.spans` groups it), each naming an `Add` or `Remove`
// op; indices of `Keep` ops select nothing. `apply_lines` is, op by op:
//
//     Keep                    the line
//     Remove, selected        (dropped: the removal is staged)
//     Remove, not selected    the line
//     Add, selected           the line
//     Add, not selected       (dropped)
//
// and `revert_lines` is the same table with "selected" and "not selected"
// swapped for the two kinds of change, over the NEW file: a selected `Add` is
// dropped and a selected `Remove` is put back. These are the bytes `git apply
// --cached` (resp. `-R`) gives for a patch holding exactly the selected
// lines -- an unselected `-` line turned into context and an unselected `+`
// line left out -- which is how `tests/oracles/oracle_lines.py` checks it.
//
// The one place that is not a plain table is a last line without a newline.
// `Op.line` for it has no terminator and the bytes are used as they are, as
// `git apply` does: a result that goes on after such a line glues the next line
// onto it. This happens when only half of an end-of-file newline change is
// selected -- say only the `+c` of `b` -> `b\nc`: the old `b` (no newline) is
// kept and `c` follows, so the result is `bc`, exactly what git makes of the
// same patch (it is why `git add -p` offers the `-b`/`+b` pair as one edit). A
// caller that wants to avoid that selects both lines of such a pair.
//
// `old_text` / `new_text` must be exactly what `ops` was made from (the file
// each function is staging into); `None` is the answer for a mismatch and
// for an index outside `ops`, since either means the selection was made against
// a different file than the one it is being applied to.

/// The indices of the changed (`Add`/`Remove`) ops of `ops` in `[span.start, span.end)`.
pub List<int> change_ops(List<diff.Op> ops, GIT_hunks.Span span) {
    List<int> out = [];
    int position = span.start;
    while (position < span.end && position < ops.size()) {
        match (ops[position].kind) {
            case Keep: {
            }
            case Add: {
                out.push(position);
            }
            case Remove: {
                out.push(position);
            }
        }
        position = position + 1;
    }
    return out;
}

// `selected` as one flag per op, or None if an index is out of range.
Option<List<bool>> flags_of(int op_count, List<int> selected) {
    List<bool> flags = [false; op_count];
    for (int index in selected) {
        if (index < 0 || index >= op_count) {
            return Option<List<bool>>.None;
        }
        flags[index] = true;
    }
    return Option<List<bool>>.Some(flags);
}

/// `old_text` with the selected changes of `ops` applied (see above).
pub Option<bytes> apply_lines(bytes old_text, List<diff.Op> ops, List<int> selected) {
    if (diff.reconstruct_old(ops) != old_text) {
        return Option<bytes>.None;
    }
    match (flags_of(ops.size(), selected)) {
        case None: {
            return Option<bytes>.None;
        }
        case Some(List<bool> flags): {
            return Option<bytes>.Some(pick_lines(ops, flags, true));
        }
    }
}

/// `new_text` with the selected changes of `ops` undone (see above).
pub Option<bytes> revert_lines(bytes new_text, List<diff.Op> ops, List<int> selected) {
    if (diff.reconstruct_new(ops) != new_text) {
        return Option<bytes>.None;
    }
    match (flags_of(ops.size(), selected)) {
        case None: {
            return Option<bytes>.None;
        }
        case Some(List<bool> flags): {
            return Option<bytes>.Some(pick_lines(ops, flags, false));
        }
    }
}

// Staging (`is_applying`): a selected change takes the new side. Reverting: a
// selected change takes the old side, so the unselected ones keep the new.
bytes pick_lines(List<diff.Op> ops, List<bool> flags, bool is_applying) {
    bytes out = [];
    int position = 0;
    while (position < ops.size()) {
        diff.Op operation = ops[position];
        bool should_take_line = true;
        match (operation.kind) {
            case Keep: {
            }
            case Add: {
                should_take_line = flags[position] == is_applying;
            }
            case Remove: {
                should_take_line = flags[position] != is_applying;
            }
        }
        if (should_take_line) {
            out.extend(operation.line);
        }
        position = position + 1;
    }
    return out;
}
