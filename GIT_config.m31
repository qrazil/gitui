// The one thing this program reads out of `.git/config`: a remote's URL.
//
//   GIT_config.get(gitdir, "remote", "origin", "url")  -> Option<str>
//
// Nothing else in this program reads the config file at all (`GIT_object.m31`'s
// own header, `GIT_client.m31`'s identity note) -- author identity comes from
// the environment exactly as real git's own `GIT_AUTHOR_*` override does,
// and the object store needs nothing from it. `push` is the first feature
// that genuinely cannot do without it: where `origin` lives is written
// nowhere else. So this is the smallest reader that answers that one
// question honestly, not a general config library:
//
//   - `[section "subsection"]` and the deprecated `[section.subsection]`
//     header shapes both resolve; the section and key names compare
//     case-insensitively and the subsection case-sensitively, which is
//     git-config(1)'s own rule;
//   - `key = value`, trimmed, with a surrounding pair of double quotes
//     removed and `\"`/`\\` inside them unescaped;
//   - `#`/`;` comment lines and blank lines are skipped. A comment *after*
//     a value on the same line is not stripped -- a URL is the only value
//     asked for and none contains ` #` or ` ;`, and getting quoted-versus-
//     unquoted comment rules right is a config parser, which this is not.
//
// The last assignment wins, as in git. Includes (`[include]`,
// `[includeIf]`) are not followed; a remote configured only through one
// reads as absent, and the message the client shows says exactly that.

import fs;
import io;
import GIT_repository;

/// `key`'s value under `[section "subsection"]` (`subsection` may be `""`
/// for a bare `[section]`), or `None` if the config file, the section or the
/// key is not there.
pub Option<str> get(str gitdir, str section, str subsection, str key) {
    str path = fs.join(GIT_repository.common(gitdir), "config");
    match (io.read(path)) {
        case Ok(str text): {
            return find(text, section, subsection, key);
        }
        case Err: {
            return Option<str>.None;
        }
    }
}

/// `get`, over config text already in memory -- the parser on its own, for a
/// test with no repository.
pub Option<str> find(str text, str section, str subsection, str key) {
    str want_section = section.to_lower();
    str want_key = key.to_lower();
    bool is_in_section = false;
    Option<str> found = Option<str>.None;
    for (str raw in text.split("\n")) {
        str line = raw.trim();
        if (line == "" || line.starts_with("#") || line.starts_with(";")) {
            continue;
        }
        if (line.starts_with("[")) {
            is_in_section = is_matching_header(close_header(line), want_section, subsection);
            continue;
        }
        if (!is_in_section) {
            continue;
        }
        match (line.index_of("=")) {
            case Some(int equals_index): {
                str line_key = line.substr(0, equals_index).trim().to_lower();
                if (line_key == want_key) {
                    found = Option<str>.Some(unquote(strip_comment(line.substr(equals_index + 1, line.size()).trim())));
                }
            }
            case None: {
                // `key` alone means `key = true`; nothing this reader asks
                // for is boolean, so the line is simply not a match.
            }
        }
    }
    return found;
}

/// One assignment found by `all`: the subsection of the section it sat in
/// (the `<base>` of `url.<base>.insteadOf`) and its value.
pub type Entry {
    pub str subsection;
    pub str value;
}

/// Every assignment of `section.*.key` in `text`, in file order, whatever
/// the subsection -- what a multi-valued key under many subsections needs
/// (`url.<base>.insteadOf`), where `find` can only ask about one named
/// subsection and takes the last value. Same line syntax as `find`.
pub List<Entry> all(str text, str section, str key) {
    str want_section = section.to_lower();
    str want_key = key.to_lower();
    bool is_in_section = false;
    str sub = "";
    List<Entry> out = [];
    for (str raw in text.split("\n")) {
        str line = raw.trim();
        if (line == "" || line.starts_with("#") || line.starts_with(";")) {
            continue;
        }
        if (line.starts_with("[")) {
            is_in_section = false;
            match (parse_header(close_header(line))) {
                case Some(Header header): {
                    if (header.name.to_lower() == want_section) {
                        is_in_section = true;
                        sub = header.sub;
                    }
                }
                case None: {
                }
            }
            continue;
        }
        if (!is_in_section) {
            continue;
        }
        match (line.index_of("=")) {
            case Some(int equals_index): {
                str line_key = line.substr(0, equals_index).trim().to_lower();
                if (line_key == want_key) {
                    out.push(Entry(sub, unquote(strip_comment(line.substr(equals_index + 1, line.size()).trim()))));
                }
            }
            case None: {
            }
        }
    }
    return out;
}

/// `all`, over the repository's own config file (empty if it has none).
pub List<Entry> all_in(str gitdir, str section, str key) {
    str path = fs.join(GIT_repository.common(gitdir), "config");
    match (io.read(path)) {
        case Ok(str text): {
            return all(text, section, key);
        }
        case Err: {
            List<Entry> none = [];
            return none;
        }
    }
}

// A header line up to and including its last `]`, dropping a trailing
// comment (`[remote "x"] ; note`).
str close_header(str line) {
    int position = line.size();
    while (position > 0) {
        position = position - 1;
        if (line.substr(position, position + 1) == "]") {
            return line.substr(0, position + 1);
        }
    }
    return line;
}

// A value without a trailing `#`/`;` comment that sits outside double quotes.
str strip_comment(str value) {
    bool is_quoted = false;
    int position = 0;
    while (position < value.size()) {
        str character = value.substr(position, position + 1);
        if (character == "\\") {
            position = position + 2;
            continue;
        }
        if (character == "\"") {
            is_quoted = !is_quoted;
        } else if (!is_quoted && (character == "#" || character == ";")) {
            return value.substr(0, position).trim();
        }
        position = position + 1;
    }
    return value;
}

// A section header's two parts: its (not yet lower-cased) name and its
// subsection, `""` for a bare `[section]`.
type Header {
    str name;
    str sub;
}

// Split a `[...]` header line (already cut at its last `]`) into its section
// and subsection, or `None` if it is not well-formed.
Option<Header> parse_header(str line) {
    if (!line.ends_with("]")) {
        return Option<Header>.None;
    }
    str inner = line.substr(1, line.size() - 1).trim();
    str name = inner;
    str sub = "";
    match (inner.index_of("\"")) {
        case Some(int quote_index): {
            name = inner.substr(0, quote_index).trim();
            str quoted = inner.substr(quote_index, inner.size());
            if (quoted.size() >= 2 && quoted.ends_with("\"")) {
                sub = unescape(quoted.substr(1, quoted.size() - 1));
            } else {
                return Option<Header>.None;
            }
        }
        case None: {
            match (inner.index_of(".")) {
                case Some(int dot): {
                    name = inner.substr(0, dot);
                    sub = inner.substr(dot + 1, inner.size());
                }
                case None: {
                }
            }
        }
    }
    return Option<Header>.Some(Header(name, sub));
}

// Does a `[...]` header line name `section`/`subsection`?
bool is_matching_header(str line, str want_section, str want_sub) {
    match (parse_header(line)) {
        case Some(Header header): {
            return header.name.to_lower() == want_section && header.sub == want_sub;
        }
        case None: {
            return false;
        }
    }
}

// A value with its surrounding double quotes removed and unescaped, or
// itself if it is not quoted.
str unquote(str value) {
    if (value.size() >= 2 && value.starts_with("\"") && value.ends_with("\"")) {
        return unescape(value.substr(1, value.size() - 1));
    }
    return value;
}

// `\"` -> `"`, `\\` -> `\`; any other escape is left as written.
str unescape(str text) {
    if (!text.contains("\\")) {
        return text;
    }
    List<int> out = [];
    List<int> characters = text.chars();
    int position = 0;
    while (position < characters.size()) {
        int character = characters[position];
        if (character == '\\' && position + 1 < characters.size() && (characters[position + 1] == '"' || characters[position + 1] == '\\')) {
            out.push(characters[position + 1]);
            position = position + 2;
            continue;
        }
        out.push(character);
        position = position + 1;
    }
    return str.from_chars(out);
}
