// Putting a received pack into a repository, as `git fetch` does: a small
// pack (fewer than `fetch.unpackLimit`, 100, objects) is unpacked into loose
// objects, a larger one is kept whole with an `.idx` of its own (version 2)
// next to it. Either way every object is checked: the pack's trailing
// checksum first, then each object's name as its content hashes.

import io;
import fs;
import random;
import core.GIT_hash;
import core.GIT_object;
import core.GIT_pack;
import core.GIT_repository;
import net.GIT_wire;

pub const int DEFAULT_UNPACK_LIMIT = 100;

// --- crc32 (the idx wants one per entry) ----------------------------------------------

List<int> crc_table() {
    List<int> table = [];
    for (int n in 0 .. 256) {
        int c = n;
        for (int k in 0 .. 8) {
            if ((c & 1) != 0) {
                c = 0xEDB88320 ^ (c >> 1);
            } else {
                c = c >> 1;
            }
        }
        table.push(c);
    }
    return table;
}

int crc32(List<int> table, bytes data, int from, int to) {
    int c = 0xFFFFFFFF;
    for (int i in from .. to) {
        c = table[(c ^ data[i]) & 0xFF] ^ (c >> 8);
    }
    return c ^ 0xFFFFFFFF;
}

void put32(bytes out, int value) {
    out.push((value >> 24) & 0xFF);
    out.push((value >> 16) & 0xFF);
    out.push((value >> 8) & 0xFF);
    out.push(value & 0xFF);
}

int nibble(int c) {
    if (c >= '0' && c <= '9') {
        return c - 48;
    }
    return c - 87;
}

/// The raw octets of a hex object name.
pub bytes unhex(str id) {
    bytes out = [];
    bytes chars = id.to_bytes();
    int i = 0;
    while (i + 1 < chars.size() + 0 && i < chars.size()) {
        out.push(nibble(chars[i]) * 16 + nibble(chars[i + 1]));
        i = i + 2;
    }
    return out;
}

/// Order: by raw id, byte-wise; hex ids sort the same way.
type IdxEntry {
    str id;
    int offset;
    int crc;
}

bytes build_idx(int raw, List<GIT_pack.Unpacked> objects, bytes pack) {
    List<int> table = crc_table();
    Map<str, IdxEntry> by_name = {};
    List<str> names = [];
    for (GIT_pack.Unpacked one in objects) {
        if (!by_name.contains(one.id)) {
            names.push(one.id);
        }
        by_name.set(one.id, IdxEntry(one.id, one.start, crc32(table, pack, one.start, one.end)));
    }
    names.sort();
    List<IdxEntry> entries = [];
    for (str name in names) {
        entries.push(by_name.get(name).or(IdxEntry("", 0, 0)));
    }
    bytes out = [0xFF, 0x74, 0x4F, 0x63];
    put32(out, 2);
    List<int> fanout = [];
    for (int i in 0 .. 256) {
        fanout.push(0);
    }
    for (IdxEntry entry in entries) {
        int first = nibble(entry.id.byte_at(0)) * 16 + nibble(entry.id.byte_at(1));
        for (int b in first .. 256) {
            fanout[b] = fanout[b] + 1;
        }
    }
    for (int count in fanout) {
        put32(out, count);
    }
    for (IdxEntry entry in entries) {
        out.extend(unhex(entry.id));
    }
    for (IdxEntry entry in entries) {
        put32(out, entry.crc);
    }
    bytes big = [];
    int big_count = 0;
    for (IdxEntry entry in entries) {
        if (entry.offset >= 0x80000000) {
            put32(out, 0x80000000 | big_count);
            put32(big, (entry.offset >> 32) & 0xFFFFFFFF);
            put32(big, entry.offset & 0xFFFFFFFF);
            big_count = big_count + 1;
        } else {
            put32(out, entry.offset);
        }
    }
    out.extend(big);
    out.extend(pack.substr(pack.size() - raw, pack.size()));
    out.extend(GIT_hash.digest(raw, out));
    return out;
}

Result<bool, str> write_file(str path, bytes data) {
    str temp = path + ".tmp" + random.system().hex(8);
    match (io.write_bytes(temp, data)) {
        case Ok(_): {
        }
        case Err(_): {
            return Result<bool, str>.Err("unable to write '" + path + "'");
        }
    }
    match (fs.rename(temp, path)) {
        case Ok(_): {
            return Result<bool, str>.Ok(true);
        }
        case Err(_): {
            return Result<bool, str>.Err("unable to write '" + path + "'");
        }
    }
}

/// Verify `pack` and add its objects to `gitdir`. The count of objects.
pub Result<int, str> store(str gitdir, bytes pack, int unpack_limit) {
    int raw = GIT_hash.raw_length(gitdir);
    int count = 0;
    match (GIT_wire.check_pack(pack, raw: raw)) {
        case Ok(int got): {
            count = got;
        }
        case Err(GIT_wire.Error why): {
            return Result<int, str>.Err("fatal: the received pack is unusable: " + why.to_str());
        }
    }
    if (count == 0) {
        return Result<int, str>.Ok(0);
    }
    List<GIT_pack.Unpacked> objects = [];
    match (GIT_pack.read_pack(gitdir, pack)) {
        case Ok(List<GIT_pack.Unpacked> got): {
            objects = got;
        }
        case Err(GIT_pack.Error why): {
            return Result<int, str>.Err("fatal: the received pack could not be read: " + why.to_str());
        }
    }
    if (count < unpack_limit) {
        for (GIT_pack.Unpacked one in objects) {
            match (GIT_object.write(gitdir, one.kind, one.content)) {
                case Ok(_): {
                }
                case Err(_): {
                    return Result<int, str>.Err("fatal: unable to write object " + one.id);
                }
            }
        }
        return Result<int, str>.Ok(count);
    }
    str directory = fs.join(fs.join(GIT_repository.common(gitdir), "objects"), "pack");
    match (GIT_repository.ensure_dir(directory)) {
        case Ok(_): {
        }
        case Err(_): {
            return Result<int, str>.Err("fatal: unable to create '" + directory + "'");
        }
    }
    str name = "pack-" + pack.substr(pack.size() - raw, pack.size()).hex();
    write_file(fs.join(directory, name + ".pack"), pack)?;
    write_file(fs.join(directory, name + ".idx"), build_idx(raw, objects, pack))?;
    return Result<int, str>.Ok(count);
}
