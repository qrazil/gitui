// A line-based three-way merge that gives the answer git's xdiff merge gives,
// and the reading side of its conflict markers: parse a merged file back into
// text and conflicts, and resolve a conflict one way or another.
//
// API
// ---
//   GIT_diff3.merge3(base, ours, theirs, labels, style:, level:)  -> Merged
//       `Merged.text` is the merged file, with conflicts spelled out in
//       markers; `Merged.conflicts` how many there are (0: a clean merge).
//   GIT_diff3.parse_conflicts(text)           -> List<Segment>
//   GIT_diff3.render(segments)                -> bytes   (exact inverse)
//   GIT_diff3.count_conflicts(segments)       -> int
//   GIT_diff3.resolve(conflict, choice)       -> bytes   one conflict, resolved
//   GIT_diff3.resolve_at(segments, n, choice) -> List<Segment>  n-th conflict -> Text
//   GIT_diff3.resolve_all(segments, choice)   -> bytes   whole file, no markers left
//
// --- what is promised ------------------------------------------------------
//
// `merge3` is a port of xdl_merge (xdiff/xmerge.c): with the default `Style.Merge`
// and `Level.ZealousAlnum` its output is byte for byte `git merge-file -p`'s,
// and with `Style.Diff3` it is `git merge-file -p --diff3`'s; `Level.Zealous`
// is what `git merge` itself runs. `tests/test_diff3.sh` holds that to thousands
// of seeded random triples (repeated lines, empty lines, moved blocks, CRLF, a
// missing final newline, empty files). In short, and as git does it:
//
//   - the two sides are each diffed against the base (`GIT_xdiff`, which
//     makes xdiff's own choices; `lib/diff.m31`'s Myers would pick a different
//     one of several equally short scripts, and so sometimes a different
//     conflict);
//   - a change on one side only is taken; a change on both sides is a conflict,
//     unless both made exactly the same change, which is taken once;
//   - changes that TOUCH (one ends where the other begins, with no unchanged
//     line between) are a conflict, as git has it;
//   - a conflict is then narrowed to the lines that really differ (`Zealous`),
//     and two conflicts at most three lines apart, or apart by lines that
//     contain nothing alphanumeric (`ZealousAlnum`), are joined into one;
//   - `Style.Diff3` caps the level at `Eager` (no narrowing, as git does for
//     `--diff3`) and adds the base between `|||||||` and `=======`;
//   - a conflict side that does not end in a newline is given one before the
//     next marker; the marker lines end in CRLF when the lines around the
//     conflict do (xdiff's `is_cr_needed`);
//   - when only one side differs from the base, the result is that side,
//     verbatim, whatever its bytes.
//
// --- where this deliberately differs from git ------------------------------
//
//   - No binary check: git refuses ("Cannot merge binary files") when a side
//     has a NUL in its first 8000 bytes. Callers who care use `diff.is_binary`
//     first; here a NUL is just a byte of a line.
//   - An empty label means no label ("<<<<<<<" alone). Git's `-L ""` prints
//     "<<<<<<< " with a trailing space. Labels are otherwise printed as given.
//   - No `zdiff3` style, no favor (`--ours`/`--theirs`/`--union`) and no
//     configurable marker size (7). Resolving is done on the parsed
//     result instead (`resolve`).

import GIT_xdiff;

/// How conflicts are written.
pub enum Style {
    /// `<<<<<<<` ours `=======` theirs `>>>>>>>`.
    Merge;
    /// `<<<<<<<` ours `|||||||` base `=======` theirs `>>>>>>>`.
    Diff3;
}

/// How hard `merge3` works to avoid or shrink conflicts (xdiff's XDL_MERGE_*).
pub enum Level {
    /// Every change on both sides is a conflict, even an identical one.
    Minimal;
    /// Identical changes on both sides are taken once.
    Eager;
    /// ... and a conflict is narrowed to the lines that differ, close ones
    /// joined (the level `git merge` uses).
    Zealous;
    /// ... and conflicts separated by lines with no letter or digit are joined
    /// too (the level `git merge-file` uses).
    ZealousAlnum;
}

/// The names printed after the markers: ours after `<<<<<<<`, base after
/// `|||||||` (Diff3 only), theirs after `>>>>>>>`. Empty: no name.
pub type Labels {
    pub str ours;
    pub str base;
    pub str theirs;
}

pub type Merged {
    pub bytes text;
    pub int conflicts;
}

// --- merging -----------------------------------------------------------------

const int MARKER_SIZE = 7;

// One stretch of the merge, in the three files' lines: [i0, i0 + chg0) of the
// base, [i1, i1 + chg1) of ours, [i2, i2 + chg2) of theirs. `mode` says what
// to emit: 0 a conflict, 1 ours, 2 theirs.
type Piece {
    int mode;
    int i0;
    int chg0;
    int i1;
    int chg1;
    int i2;
    int chg2;
}

type Ctx {
    List<bytes> base;
    List<bytes> ours;
    List<bytes> theirs;
    Labels labels;
    Style style;
}

bool is_diff3(Style style) {
    match (style) {
        case Merge: {
            return false;
        }
        case Diff3: {
            return true;
        }
    }
}

int level_rank(Level level) {
    match (level) {
        case Minimal: {
            return 0;
        }
        case Eager: {
            return 1;
        }
        case Zealous: {
            return 2;
        }
        case ZealousAlnum: {
            return 3;
        }
    }
}

/// Merge `ours` and `theirs`, two edits of `base`.
pub Merged merge3(bytes base, bytes ours, bytes theirs, Labels labels, Style style = Style.Merge, Level level = Level.ZealousAlnum) {
    Ctx context = Ctx(GIT_xdiff.split_lines(base), GIT_xdiff.split_lines(ours), GIT_xdiff.split_lines(theirs), labels, style);
    List<GIT_xdiff.Edit> script_ours = GIT_xdiff.edits(GIT_xdiff.diff_lines(context.base, context.ours));
    List<GIT_xdiff.Edit> script_theirs = GIT_xdiff.edits(GIT_xdiff.diff_lines(context.base, context.theirs));
    if (script_ours.size() == 0) {
        return Merged(theirs, 0);
    }
    if (script_theirs.size() == 0) {
        return Merged(ours, 0);
    }
    int rank = level_rank(level);
    if (is_diff3(style) && rank > 1) {
        rank = 1;
    }
    List<Piece> pieces = combine(context, script_ours, script_theirs, rank);
    if (rank >= 2) {
        refine_conflicts(context, pieces);
        simplify_non_conflicts(context, pieces, rank > 2);
    }
    int conflicts = 0;
    for (Piece piece in pieces) {
        if (piece.mode == 0) {
            conflicts = conflicts + 1;
        }
    }
    return Merged(fill(context, pieces), conflicts);
}

// Add a stretch to the list, joining it to the previous one when they touch
// or overlap in ours or in theirs (xdl_append_merge).
void append_piece(List<Piece> pieces, int mode, int base_start, int chg0, int ours_start, int chg1, int theirs_start, int chg2) {
    int piece_count = pieces.size();
    if (piece_count > 0) {
        Piece last = pieces[piece_count - 1];
        if (ours_start <= last.i1 + last.chg1 || theirs_start <= last.i2 + last.chg2) {
            if (mode != last.mode) {
                last.mode = 0;
            }
            last.chg0 = base_start + chg0 - last.i0;
            last.chg1 = ours_start + chg1 - last.i1;
            last.chg2 = theirs_start + chg2 - last.i2;
            return;
        }
    }
    pieces.push(Piece(mode, base_start, chg0, ours_start, chg1, theirs_start, chg2));
}

bool same_lines(List<bytes> left, int left_start, List<bytes> right, int right_start, int count) {
    int offset = 0;
    while (offset < count) {
        if (left[left_start + offset] != right[right_start + offset]) {
            return false;
        }
        offset = offset + 1;
    }
    return true;
}

// Walk the two edit scripts together (xdl_do_merge): in each script an edit is
// `a_*` in the base and `b_*` in that side.
List<Piece> combine(Ctx context, List<GIT_xdiff.Edit> script1, List<GIT_xdiff.Edit> script2, int rank) {
    List<Piece> pieces = [];
    int first_position = 0;
    int second_position = 0;
    while (first_position < script1.size() && second_position < script2.size()) {
        GIT_xdiff.Edit first_edit = script1[first_position];
        GIT_xdiff.Edit second_edit = script2[second_position];
        if (first_edit.a_start + first_edit.a_len < second_edit.a_start) {
            append_piece(pieces, 1, first_edit.a_start, first_edit.a_len, first_edit.b_start, first_edit.b_len, second_edit.b_start - second_edit.a_start + first_edit.a_start, first_edit.a_len);
            first_position = first_position + 1;
            continue;
        }
        if (second_edit.a_start + second_edit.a_len < first_edit.a_start) {
            append_piece(pieces, 2, second_edit.a_start, second_edit.a_len, first_edit.b_start - first_edit.a_start + second_edit.a_start, second_edit.a_len, second_edit.b_start, second_edit.b_len);
            second_position = second_position + 1;
            continue;
        }
        if (rank == 0 || first_edit.a_start != second_edit.a_start || first_edit.a_len != second_edit.a_len || first_edit.b_len != second_edit.b_len || !same_lines(context.ours, first_edit.b_start, context.theirs, second_edit.b_start, first_edit.b_len)) {
            int off = first_edit.a_start - second_edit.a_start;
            int ffo = off + first_edit.a_len - second_edit.a_len;
            int base_start = first_edit.a_start;
            int ours_start = first_edit.b_start;
            int theirs_start = second_edit.b_start;
            if (off > 0) {
                base_start = base_start - off;
                ours_start = ours_start - off;
            } else {
                theirs_start = theirs_start + off;
            }
            int chg0 = first_edit.a_start + first_edit.a_len - base_start;
            int chg1 = first_edit.b_start + first_edit.b_len - ours_start;
            int chg2 = second_edit.b_start + second_edit.b_len - theirs_start;
            if (ffo < 0) {
                chg0 = chg0 - ffo;
                chg1 = chg1 - ffo;
            } else {
                chg2 = chg2 + ffo;
            }
            append_piece(pieces, 0, base_start, chg0, ours_start, chg1, theirs_start, chg2);
        }
        int end1 = first_edit.a_start + first_edit.a_len;
        int end2 = second_edit.a_start + second_edit.a_len;
        if (end1 >= end2) {
            second_position = second_position + 1;
        }
        if (end2 >= end1) {
            first_position = first_position + 1;
        }
    }
    int delta2 = context.theirs.size() - context.base.size();
    while (first_position < script1.size()) {
        GIT_xdiff.Edit first_edit = script1[first_position];
        append_piece(pieces, 1, first_edit.a_start, first_edit.a_len, first_edit.b_start, first_edit.b_len, first_edit.a_start + delta2, first_edit.a_len);
        first_position = first_position + 1;
    }
    int delta1 = context.ours.size() - context.base.size();
    while (second_position < script2.size()) {
        GIT_xdiff.Edit second_edit = script2[second_position];
        append_piece(pieces, 2, second_edit.a_start, second_edit.a_len, second_edit.a_start + delta1, second_edit.a_len, second_edit.b_start, second_edit.b_len);
        second_position = second_position + 1;
    }
    return pieces;
}

List<bytes> slice(List<bytes> lines, int start, int count) {
    List<bytes> out = [];
    int offset = 0;
    while (offset < count) {
        out.push(lines[start + offset]);
        offset = offset + 1;
    }
    return out;
}

// Narrow every conflict to the lines of it that differ (xdl_refine_conflicts):
// diff ours' side of it against theirs', and let each difference stand as a
// conflict of its own.
void refine_conflicts(Ctx context, List<Piece> pieces) {
    List<Piece> out = [];
    for (Piece each in pieces) {
        Piece piece = clone(each);
        if (piece.mode != 0 || piece.chg1 == 0 || piece.chg2 == 0) {
            out.push(piece);
            continue;
        }
        int base1 = piece.i1;
        int base2 = piece.i2;
        List<GIT_xdiff.Edit> script = GIT_xdiff.edits(GIT_xdiff.diff_lines(slice(context.ours, piece.i1, piece.chg1), slice(context.theirs, piece.i2, piece.chg2)));
        if (script.size() == 0) {
            // Both sides came to the same lines after all.
            piece.mode = 1;
            out.push(piece);
            continue;
        }
        int parent_i0 = piece.i0;
        int parent_chg0 = piece.chg0;
        bool is_first = true;
        for (GIT_xdiff.Edit edit in script) {
            if (is_first) {
                piece.i1 = edit.a_start + base1;
                piece.chg1 = edit.a_len;
                piece.i2 = edit.b_start + base2;
                piece.chg2 = edit.b_len;
                out.push(piece);
                is_first = false;
            } else {
                out.push(Piece(0, parent_i0, parent_chg0, edit.a_start + base1, edit.a_len, edit.b_start + base2, edit.b_len));
            }
        }
    }
    pieces.clear();
    for (Piece piece in out) {
        pieces.push(piece);
    }
}

bool is_alnum_byte(int code) {
    return (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
}

bool lines_contain_alnum(List<bytes> lines, int start, int count) {
    int offset = 0;
    while (offset < count) {
        for (int code in lines[start + offset]) {
            if (is_alnum_byte(code)) {
                return true;
            }
        }
        offset = offset + 1;
    }
    return false;
}

// Join two conflicts that have almost nothing between them
// (xdl_simplify_non_conflicts): at most three lines in ours, or, at the
// highest level, no letter or digit at all.
void simplify_non_conflicts(Ctx context, List<Piece> pieces, bool should_simplify_if_no_alnum) {
    List<Piece> out = [];
    for (Piece piece in pieces) {
        int output_count = out.size();
        if (output_count > 0) {
            Piece previous = out[output_count - 1];
            int begin = previous.i1 + previous.chg1;
            int end = piece.i1;
            if (previous.mode == 0 && piece.mode == 0 && (end - begin <= 3 || (should_simplify_if_no_alnum && !lines_contain_alnum(context.ours, begin, end - begin)))) {
                previous.chg1 = piece.i1 + piece.chg1 - previous.i1;
                previous.chg2 = piece.i2 + piece.chg2 - previous.i2;
                continue;
            }
        }
        out.push(piece);
    }
    pieces.clear();
    for (Piece piece in out) {
        pieces.push(piece);
    }
}

// --- writing the merge -------------------------------------------------------

// Does the line end in CR LF? 1 yes, 0 no, -1 cannot tell (xdiff's is_eol_crlf).
int is_eol_crlf(List<bytes> file, int index) {
    int line_count = file.size();
    if (line_count == 0) {
        return -1;
    }
    int current = index;
    if (current >= line_count - 1) {
        bytes last = file[current];
        int size = last.size();
        if (size > 0 && last[size - 1] == 10) {
            if (size > 1 && last[size - 2] == 13) {
                return 1;
            }
            return 0;
        }
        if (current == 0) {
            return -1;
        }
        current = current - 1;
    }
    bytes line = file[current];
    int length = line.size();
    if (length > 1 && line[length - 2] == 13) {
        return 1;
    }
    return 0;
}

// Marker lines end in CR LF when the lines around the conflict do (xdiff's
// is_cr_needed): the line before the conflict in ours and in theirs, and the
// FIRST line of the base, all end in CR LF (an empty file or a lone unterminated
// line cannot say, and does not veto).
bool is_cr_needed(Ctx context, Piece piece) {
    int at1 = 0;
    if (piece.i1 > 0) {
        at1 = piece.i1 - 1;
    }
    int needs = is_eol_crlf(context.ours, at1);
    if (needs != 0) {
        int at2 = 0;
        if (piece.i2 > 0) {
            at2 = piece.i2 - 1;
        }
        needs = is_eol_crlf(context.theirs, at2);
    }
    if (needs != 0) {
        needs = is_eol_crlf(context.base, 0);
    }
    return needs > 0;
}

// Append lines [start, start + count); `add_nl`: and a newline (CR LF when
// `needs_cr`) if the last of them has none (xdl_recs_copy).
void copy_lines(bytes out, List<bytes> lines, int start, int count, bool needs_cr, bool should_add_newline) {
    if (count < 1) {
        return;
    }
    int offset = 0;
    while (offset < count) {
        out.extend(lines[start + offset]);
        offset = offset + 1;
    }
    if (should_add_newline) {
        bytes last = lines[start + count - 1];
        int size = last.size();
        if (size == 0 || last[size - 1] != 10) {
            if (needs_cr) {
                out.push(13);
            }
            out.push(10);
        }
    }
}

void marker(bytes out, int marker_byte, str label, bool needs_cr) {
    int offset = 0;
    while (offset < MARKER_SIZE) {
        out.push(marker_byte);
        offset = offset + 1;
    }
    if (label.size() > 0) {
        out.push(32);
        out.extend(label.to_bytes());
    }
    if (needs_cr) {
        out.push(13);
    }
    out.push(10);
}

void conflict_hunk(Ctx context, bytes out, Piece piece, int done) {
    bool needs_cr = is_cr_needed(context, piece);
    copy_lines(out, context.ours, done, piece.i1 - done, false, false);
    marker(out, 60, context.labels.ours, needs_cr);
    copy_lines(out, context.ours, piece.i1, piece.chg1, needs_cr, true);
    if (is_diff3(context.style)) {
        marker(out, 124, context.labels.base, needs_cr);
        copy_lines(out, context.base, piece.i0, piece.chg0, needs_cr, true);
    }
    marker(out, 61, "", needs_cr);
    copy_lines(out, context.theirs, piece.i2, piece.chg2, needs_cr, true);
    marker(out, 62, context.labels.theirs, needs_cr);
}

bytes fill(Ctx context, List<Piece> pieces) {
    bytes out = [];
    int done = 0;
    for (Piece piece in pieces) {
        if (piece.mode == 0) {
            conflict_hunk(context, out, piece, done);
        } else {
            copy_lines(out, context.ours, done, piece.i1 - done, false, false);
            if (piece.mode == 1) {
                copy_lines(out, context.ours, piece.i1, piece.chg1, false, false);
            } else {
                copy_lines(out, context.theirs, piece.i2, piece.chg2, false, false);
            }
        }
        done = piece.i1 + piece.chg1;
    }
    copy_lines(out, context.ours, done, context.ours.size() - done, false, false);
    return out;
}

// --- reading conflict markers --------------------------------------------------

/// One conflict as it stands in a file. The marker lines are kept exactly as
/// read (`<<<<<<< ours\n`, `=======\r\n`, ...) so that `render` gives the file
/// back byte for byte.
pub type Conflict {
    pub bytes ours;
    pub bytes base;
    pub bytes theirs;
    /// The file had a `|||||||` section (diff3 style); `base` is its text.
    pub bool has_base;
    pub bytes start_marker;
    pub bytes base_marker;
    pub bytes mid_marker;
    pub bytes end_marker;
}

/// A file is a run of these: plain text, and conflicts.
pub enum Segment {
    Text(bytes);
    Conflict(Conflict);
}

/// Which side of a conflict to keep.
pub enum Choice {
    Ours;
    Theirs;
    /// Ours, then theirs.
    Both;
    /// Theirs, then ours.
    BothReversed;
    /// The common ancestor; needs a diff3-style conflict, else it is empty.
    Base;
}

// A marker line: `ch` MARKER_SIZE times, then the end of the line or a space.
bool is_marker(bytes line, int marker_byte) {
    if (line.size() < MARKER_SIZE) {
        return false;
    }
    int offset = 0;
    while (offset < MARKER_SIZE) {
        if (line[offset] != marker_byte) {
            return false;
        }
        offset = offset + 1;
    }
    if (line.size() == MARKER_SIZE) {
        return true;
    }
    return line[MARKER_SIZE] == 32 || line[MARKER_SIZE] == 10 || line[MARKER_SIZE] == 13;
}

// The conflict whose start marker is lines[at], and how many lines it takes,
// or 0 lines if what follows is not a complete conflict.
type Found {
    Conflict conflict;
    int used;
}

Option<Found> read_conflict(List<bytes> lines, int start) {
    int line_count = lines.size();
    bytes ours = [];
    bytes base = [];
    bytes theirs = [];
    bytes base_marker = [];
    bytes mid_marker = [];
    int phase = 0;
    int cursor = start + 1;
    while (cursor < line_count) {
        bytes line = lines[cursor];
        if (is_marker(line, 60)) {
            return Option<Found>.None;
        }
        if (phase == 0 && is_marker(line, 124)) {
            base_marker = line;
            phase = 1;
        } else if (phase <= 1 && is_marker(line, 61)) {
            mid_marker = line;
            phase = 2;
        } else if (phase == 2 && is_marker(line, 62)) {
            return Option<Found>.Some(Found(Conflict(ours, base, theirs, base_marker.size() > 0, lines[start], base_marker, mid_marker, line), cursor - start + 1));
        } else if (phase == 0) {
            ours.extend(line);
        } else if (phase == 1) {
            base.extend(line);
        } else {
            theirs.extend(line);
        }
        cursor = cursor + 1;
    }
    return Option<Found>.None;
}

/// `text` as plain text and conflicts, in order. A conflict is a complete
/// `<<<<<<<` ... `=======` ... `>>>>>>>` (with an optional `|||||||`) at
/// the start of lines; anything else that looks like a marker stays text.
pub List<Segment> parse_conflicts(bytes text) {
    List<bytes> lines = GIT_xdiff.split_lines(text);
    List<Segment> out = [];
    bytes plain = [];
    int cursor = 0;
    while (cursor < lines.size()) {
        if (is_marker(lines[cursor], 60)) {
            match (read_conflict(lines, cursor)) {
                case Some(Found found): {
                    if (plain.size() > 0) {
                        out.push(Segment.Text(plain));
                        plain = [];
                    }
                    out.push(Segment.Conflict(found.conflict));
                    cursor = cursor + found.used;
                    continue;
                }
                case None: {
                }
            }
        }
        plain.extend(lines[cursor]);
        cursor = cursor + 1;
    }
    if (plain.size() > 0) {
        out.push(Segment.Text(plain));
    }
    return out;
}

/// The file `segments` came from, byte for byte.
pub bytes render(List<Segment> segments) {
    bytes out = [];
    for (Segment segment in segments) {
        match (segment) {
            case Text(bytes text): {
                out.extend(text);
            }
            case Conflict(Conflict conflict): {
                out.extend(conflict.start_marker);
                out.extend(conflict.ours);
                if (conflict.has_base) {
                    out.extend(conflict.base_marker);
                    out.extend(conflict.base);
                }
                out.extend(conflict.mid_marker);
                out.extend(conflict.theirs);
                out.extend(conflict.end_marker);
            }
        }
    }
    return out;
}

/// How many conflicts `segments` holds.
pub int count_conflicts(List<Segment> segments) {
    int count = 0;
    for (Segment segment in segments) {
        match (segment) {
            case Text(_): {
            }
            case Conflict(_): {
                count = count + 1;
            }
        }
    }
    return count;
}

/// What a conflict becomes when `choice` is taken.
pub bytes resolve(Conflict conflict, Choice choice) {
    bytes out = [];
    match (choice) {
        case Ours: {
            out.extend(conflict.ours);
        }
        case Theirs: {
            out.extend(conflict.theirs);
        }
        case Both: {
            out.extend(conflict.ours);
            out.extend(conflict.theirs);
        }
        case BothReversed: {
            out.extend(conflict.theirs);
            out.extend(conflict.ours);
        }
        case Base: {
            out.extend(conflict.base);
        }
    }
    return out;
}

/// `segments` with the `index`-th conflict (counting conflicts only, from 0)
/// replaced by its resolution; the list is unchanged if there is no such one.
pub List<Segment> resolve_at(List<Segment> segments, int index, Choice choice) {
    List<Segment> out = [];
    int seen = 0;
    for (Segment segment in segments) {
        match (segment) {
            case Text(bytes text): {
                out.push(Segment.Text(text));
            }
            case Conflict(Conflict conflict): {
                if (seen == index) {
                    out.push(Segment.Text(resolve(conflict, choice)));
                } else {
                    out.push(segment);
                }
                seen = seen + 1;
            }
        }
    }
    return out;
}

/// The file with every conflict resolved the same way.
pub bytes resolve_all(List<Segment> segments, Choice choice) {
    bytes out = [];
    for (Segment segment in segments) {
        match (segment) {
            case Text(bytes text): {
                out.extend(text);
            }
            case Conflict(Conflict conflict): {
                out.extend(resolve(conflict, choice));
            }
        }
    }
    return out;
}
