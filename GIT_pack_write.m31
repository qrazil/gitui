// Writing a packfile -- the half of the pack format `GIT_pack.m31` deliberately
// left alone ("reading only -- writing one, for `push`, is later, separate
// work", `docs/design.md`'s "Going remote"). This is that later work, and
// it is the simplest packfile git accepts, on purpose:
//
//   `PACK`, version 2, the object count -- then every object as a FULL
//   entry (its type and size in the varint header, its content as one zlib
//   stream), then the SHA-1 of everything before it.
//
// No deltas. `OBJ_OFS_DELTA`/`OBJ_REF_DELTA` are a sender's optimisation,
// never a requirement: a pack of whole objects is exactly what
// `git unpack-objects` and `index-pack --strict` are happy to receive, it is
// what git itself sends when `GIT_pack.window=0`, and it means the only thing
// this module can get wrong is framing, which `test_push.sh` checks against
// real `index-pack --strict` and against `GIT_pack.m31`'s own reader. The zlib
// stream is `GIT_zlib.compress`'s stored-block one -- bigger on the wire than
// git's, never different in meaning; a Huffman encoder can replace it later
// without this file changing (GIT_zlib.m31's own note).
//
// --- which objects to send ---------------------------------------------------
//
// `objects_to_send` answers `git rev-list --objects <tips> ^<known>`, the
// same way git does for a push: every commit reachable from `tips` that is
// not reachable from `known` (the remote's advertised refs), plus every tree
// and blob those commits' trees reach, MINUS the trees and blobs reachable
// from the *boundary* -- the known commits the interesting walk ran into as
// parents. Objects the remote already has but that sit outside the boundary
// trees get sent again; that is harmless (git deduplicates on receipt) and
// it is the trade git itself makes rather than walking the remote's whole
// history. A `known` id this repository does not have at all (the remote is
// ahead) is simply not a stopping point -- `GIT_http_push.push` refuses that case
// before this is ever asked.

import GIT_object;
import GIT_sha1;
import GIT_zlib;

/// Why a pack could not be built or an object set computed. Payload-free
/// (`docs/errors-decision.md` §4): the id involved is context the caller
/// already has.
pub enum Error {
    /// An object to pack, or to walk through, could not be read.
    Object;
    /// A tip (after peeling any tag) is not a commit.
    NotCommit;
}

pub str Error.to_str() {
    match (this) {
        case Object: {
            return "an object could not be read from the repository";
        }
        case NotCommit: {
            return "a tip does not name a commit";
        }
    }
}

pub const int OBJ_COMMIT = 1;
pub const int OBJ_TREE = 2;
pub const int OBJ_BLOB = 3;
pub const int OBJ_TAG = 4;

/// The pack's own number for a kind word, `0` for a word that is none of
/// the four.
pub int type_number(str kind) {
    if (kind == "commit") {
        return OBJ_COMMIT;
    }
    if (kind == "tree") {
        return OBJ_TREE;
    }
    if (kind == "blob") {
        return OBJ_BLOB;
    }
    if (kind == "tag") {
        return OBJ_TAG;
    }
    return 0;
}

/// One entry's header: the type in bits 4-6 of the first byte and the low
/// four bits of the size below it, then the rest of the size seven bits a
/// byte, least significant first, every byte but the last with its top bit
/// set -- `GIT_pack.m31`'s own reader, inverted.
pub bytes entry_header(int type_num, int size) {
    bytes out = [];
    int rest = size >> 4;
    int first = type_num << 4 | size & 0x0F;
    if (rest > 0) {
        first = first | 0x80;
    }
    out.push(first);
    while (rest > 0) {
        int octet = rest & 0x7F;
        rest = rest >> 7;
        if (rest > 0) {
            octet = octet | 0x80;
        }
        out.push(octet);
    }
    return out;
}

/// A packfile holding exactly `ids`, in that order, each as a whole object.
/// Zero ids is a legal, empty pack (header and trailer only), which is what
/// a push that updates a ref to an object the remote already has sends.
pub Result<bytes, Error> build(str gitdir, List<str> ids) {
    bytes out = "PACK".to_bytes();
    be32(out, 2);
    be32(out, ids.size());
    for (str id in ids) {
        match (GIT_object.read(gitdir, id)) {
            case Ok(GIT_object.Object object): {
                out.extend(entry_header(type_number(object.kind()), object.raw.size()));
                out.extend(GIT_zlib.compress(object.raw));
            }
            case Err(_): {
                return Result<bytes, Error>.Err(Error.Object);
            }
        }
    }
    bytes trailer = GIT_sha1.sum(out);
    out.extend(trailer);
    return Result<bytes, Error>.Ok(out);
}

void be32(bytes out, int value) {
    out.push(value >> 24 & 0xFF);
    out.push(value >> 16 & 0xFF);
    out.push(value >> 8 & 0xFF);
    out.push(value & 0xFF);
}

/// `git rev-list --objects <tips> ^<known>` -- see the module note. Commits
/// first (newest-visited first), then trees, then blobs, then any annotated
/// tag a tip named; the order inside a pack is nothing git relies on.
pub Result<List<str>, Error> objects_to_send(str gitdir, List<str> tips, List<str> known) {
    // Every commit reachable from a known ref this repository actually has.
    Map<str, bool> stop = {};
    for (str known_id in known) {
        match (peel(gitdir, known_id)) {
            case Ok(str commit_id): {
                reachable_commits(gitdir, commit_id, stop);
            }
            case Err(_): {
                // Not here at all: the remote is ahead of us somewhere, which
                // is not this function's problem (module note).
            }
        }
    }
    // The interesting commits, and the boundary they ran into.
    Map<str, bool> seen = {};
    List<str> commits = [];
    List<str> tags = [];
    Map<str, bool> boundary = {};
    List<str> queue = [];
    for (str tip in tips) {
        str commit_id = peel_collecting(gitdir, tip, tags)?;
        if (stop.contains(commit_id) || seen.contains(commit_id)) {
            continue;
        }
        seen.set(commit_id, true);
        queue.push(commit_id);
    }
    int position = 0;
    while (position < queue.size()) {
        str id = queue[position];
        position = position + 1;
        match (GIT_object.read(gitdir, id)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        commits.push(id);
                        for (str parent in commit.parents) {
                            if (stop.contains(parent)) {
                                boundary.set(parent, true);
                                continue;
                            }
                            if (!seen.contains(parent)) {
                                seen.set(parent, true);
                                queue.push(parent);
                            }
                        }
                    }
                    case Blob: {
                        return Result<List<str>, Error>.Err(Error.NotCommit);
                    }
                    case Tree: {
                        return Result<List<str>, Error>.Err(Error.NotCommit);
                    }
                    case Tag: {
                        return Result<List<str>, Error>.Err(Error.NotCommit);
                    }
                }
            }
            case Err(_): {
                return Result<List<str>, Error>.Err(Error.Object);
            }
        }
    }
    // What the boundary already has, then what the interesting commits need
    // beyond it.
    Map<str, bool> have = {};
    List<str> ignored = [];
    for (str boundary_id in boundary.keys()) {
        match (GIT_object.read(gitdir, boundary_id)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        tree_objects(gitdir, commit.tree, have, ignored, ignored)?;
                    }
                    case Blob: {
                    }
                    case Tree: {
                    }
                    case Tag: {
                    }
                }
            }
            case Err(_): {
                return Result<List<str>, Error>.Err(Error.Object);
            }
        }
    }
    List<str> trees = [];
    List<str> blobs = [];
    for (str commit_id in commits) {
        match (GIT_object.read(gitdir, commit_id)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        tree_objects(gitdir, commit.tree, have, trees, blobs)?;
                    }
                    case Blob: {
                    }
                    case Tree: {
                    }
                    case Tag: {
                    }
                }
            }
            case Err(_): {
                return Result<List<str>, Error>.Err(Error.Object);
            }
        }
    }
    List<str> out = [];
    for (str commit_id in commits) {
        out.push(commit_id);
    }
    for (str tree_id in trees) {
        out.push(tree_id);
    }
    for (str blob_id in blobs) {
        out.push(blob_id);
    }
    for (str tag_id in tags) {
        out.push(tag_id);
    }
    return Result<List<str>, Error>.Ok(out);
}

// The commit `id` names: itself, or -- for an annotated tag -- what the tag
// (chain) finally points at.
Result<str, Error> peel(str gitdir, str id) {
    List<str> ignored = [];
    return peel_collecting(gitdir, id, ignored);
}

// `peel`, recording every tag object passed through in `tags` -- a pushed
// tag has to travel in the pack along with what it points at.
Result<str, Error> peel_collecting(str gitdir, str id, List<str> tags) {
    str current = id;
    for (int depth in 0 .. 16) {
        match (GIT_object.read(gitdir, current)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit: {
                        return Result<str, Error>.Ok(current);
                    }
                    case Tag(GIT_object.Tag tag): {
                        tags.push(current);
                        current = tag.object;
                    }
                    case Blob: {
                        return Result<str, Error>.Err(Error.NotCommit);
                    }
                    case Tree: {
                        return Result<str, Error>.Err(Error.NotCommit);
                    }
                }
            }
            case Err(_): {
                return Result<str, Error>.Err(Error.Object);
            }
        }
    }
    return Result<str, Error>.Err(Error.NotCommit);
}

// Mark every commit reachable from `start` in `out`. An unreadable parent
// ends that line of the walk rather than failing it: a known ref whose
// history is partly missing here still stops the interesting walk wherever
// it can.
void reachable_commits(str gitdir, str start, Map<str, bool> out) {
    if (out.contains(start)) {
        return;
    }
    List<str> queue = [start];
    out.set(start, true);
    int position = 0;
    while (position < queue.size()) {
        str id = queue[position];
        position = position + 1;
        match (GIT_object.read(gitdir, id)) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        for (str parent in commit.parents) {
                            if (!out.contains(parent)) {
                                out.set(parent, true);
                                queue.push(parent);
                            }
                        }
                    }
                    case Blob: {
                    }
                    case Tree: {
                    }
                    case Tag: {
                    }
                }
            }
            case Err: {
            }
        }
    }
}

// Every tree and blob under `tree_id` not already in `have`, appended to
// `trees`/`blobs` and added to `have` -- so a second call over a tree that
// shares subtrees with the first visits each shared subtree once.
Result<bool, Error> tree_objects(str gitdir, str tree_id, Map<str, bool> have, List<str> trees, List<str> blobs) {
    if (have.contains(tree_id)) {
        return Result<bool, Error>.Ok(true);
    }
    have.set(tree_id, true);
    trees.push(tree_id);
    match (GIT_object.read(gitdir, tree_id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Tree(List<GIT_object.Entry> entries): {
                    for (GIT_object.Entry entry in entries) {
                        if (entry.is_commit()) {
                            // A submodule: a commit in another repository,
                            // never an object of this one.
                            continue;
                        }
                        if (entry.is_tree()) {
                            tree_objects(gitdir, entry.id, have, trees, blobs)?;
                        } else if (!have.contains(entry.id)) {
                            have.set(entry.id, true);
                            blobs.push(entry.id);
                        }
                    }
                    return Result<bool, Error>.Ok(true);
                }
                case Blob: {
                    return Result<bool, Error>.Err(Error.Object);
                }
                case Commit: {
                    return Result<bool, Error>.Err(Error.Object);
                }
                case Tag: {
                    return Result<bool, Error>.Err(Error.Object);
                }
            }
        }
        case Err(_): {
            return Result<bool, Error>.Err(Error.Object);
        }
    }
}
