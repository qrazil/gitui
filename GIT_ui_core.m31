    table.push(Binding(SCOPE_OUTLINE, CMD_UNSTAGE, ["u"], "unstage the file under the cursor", "u", "unstage"));
    table.push(Binding(SCOPE_OUTLINE, CMD_STAGE_ALL, ["S"], "stage everything: every unstaged and untracked file", "S", "stage all"));
    table.push(Binding(SCOPE_OUTLINE, CMD_UNSTAGE_ALL, ["U"], "unstage everything", "U", "unstage all"));
    table.push(Binding(SCOPE_OUTLINE, CMD_DIFF, ["d"], "open the hunk-level diff of the row", "d", "diff"));
