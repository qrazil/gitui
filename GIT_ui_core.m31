/// How many lines of the command log are kept; the oldest go first.
pub const int COMMAND_LOG_CAPACITY = 500;

/// One key, as the footer and the help overlay show it.
pub type Hint {
    pub str keys;
    pub str label;
}

/// One row of the key table. `keys` are `term.Code.to_str()` names ("j",
/// "enter", "escape", "S"); `help` is the sentence the help overlay shows;
/// `footer_keys`/`footer_label` are what the one-line footer shows, with
/// `footer_keys == ""` meaning "help overlay only".
pub type Binding {
    pub str scope;
    pub str cmd;
    pub List<str> keys;
    pub str help;
    pub str footer_keys;
    pub str footer_label;
}

/// A modal layer over the document. Whichever overlay is last in
/// `Core.overlays` gets every key, and all of them draw, bottom to top.
pub interface Overlay {
    /// One decoded key. The overlay closes itself with `pop_overlay`.
    TUI_app.Action handle_key(term.Code code);
    /// Draw over `area` (the whole frame body).
    void render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area);
    /// The keys this overlay answers to, for the footer.
    List<Hint> hints();
}

/// Everything the interactive client is showing and doing right now. One
/// value, shared by every layer above it and by every overlay.
pub type Core {
    pub str gitdir;
    pub str worktree;
    pub TUI_outline.Outline outline = TUI_outline.Outline([]);
    pub TUI_jump_list.JumpList jump = TUI_jump_list.JumpList.empty;
    pub bool is_jump_shown = false;
    pub bool is_jump_focused = false;
    /// Set by an operation that finished the job the top overlay was opened
    /// for (`abort_commit`, `finish_commit`): the client pops that overlay
    /// when it next settles (`GIT_client.State.settle`). An operation that
    /// failed leaves it false, so the overlay stays open for a retry.
    pub bool is_overlay_done = false;
    /// The overlay stack: last is on top. Empty means the document has the keys.
    pub List<Overlay> overlays = [];
    /// `c` then `A`: the commit overlay is replacing HEAD rather than adding a
    /// child to it. `start_amend` sets this (and prefills the message file
    /// with HEAD's own message); `finish_commit` reads it to pick HEAD's
    /// parents and author instead of HEAD-as-parent and a fresh author.
    /// Reset whenever the overlay is opened fresh or aborted.
    pub bool is_amending = false;
    /// Where `n` (new branch) asks for the name: a file `$EDITOR` is launched
    /// on, exactly like `commit_message_path`, since there is no text-input
    /// widget to type into -- see `new_branch`.
    pub str branch_name_path = "";
    /// Which file the pending `$EDITOR` launch is for -- `launch_editor`
    /// serves both the commit message and the new-branch name.
    pub bool is_editor_for_branch = false;
    pub List<GIT_ui_model.BranchRow> branch_rows = [];
    /// `stash@{n}: <message>` per stash, newest first -- the "Stashes" section.
    pub List<str> stash_labels = [];
    /// Set by `edit_message` and read by `gitui.m31`'s own top-level driver
    /// after `TUI_app.Loop.run` returns: true means the loop stopped so
    /// `$EDITOR` could have the terminal, not because the operator pressed
    /// `q`. See `GIT_client.m31`'s header, "launching `$EDITOR`".
    pub bool is_editor_wanted = false;
    pub str commit_message_path = "";
    pub str branch_label = "";
    pub str message = "";
    /// Whether the primary document is currently showing a hunk-level diff
    /// instead of the outline -- see `show_diff_current`/`close_diff`.
    pub bool is_diff_open = false;
    /// Set instead of populating `diff_view`, when `GIT_hunks.hunks` reported
    /// `Binary` for the pair being compared.
    pub bool is_diff_binary = false;
    /// The row label the diff view's border is drawn with.
    pub str diff_title = "";
    pub TUI_diff_view.DiffView diff_view = TUI_diff_view.DiffView([]);
    /// Which comparison `diff_view` shows -- "untracked", "unstaged",
    /// "staged" or "commit" -- and for which path. Empty while closed.
    pub str diff_section = "";
    pub bytes diff_path = [];
    /// For a "commit" diff: the commit the file diff belongs to (40 hex), so
    /// `B` / `H` in the diff view know which revision to start from.
    pub str diff_rev = "";
    pub Map<str, bool> collapsed = {};
    pub Map<str, bytes> paths = {};
    pub Map<str, GIT_ui_model.CommitFileDiff> file_diffs = {};
    /// `commit_changes`'s result per commit id, filled on demand the first
    /// time that commit is unfolded and never again: a commit is immutable.
    pub Map<str, List<GIT_ui_model.CommitFileDiff>> commit_changes_cache = {};
    /// How many commits `refresh` asks `GIT_log.walk` for.
    pub int log_limit = GIT_ui_model.LOG_PAGE;
    pub GIT_status.Status last_status = GIT_status.Status([], [], []);
    pub List<GIT_log.Entry> log = [];
    /// The `@` ring buffer: one line per write operation, oldest first.
    pub List<str> command_log = [];
    /// The last `/` query, for `n`/`N`.
    pub str search_query = "";
    /// What a finished picker was for and what it picked; the client reads and
    /// clears them after every key (`GIT_client.State.settle`).
    pub str picked_purpose = "";
    pub str picked_item = "";
    /// A merge is under way (`MERGE_HEAD` exists); set by `refresh`.
    pub bool is_merging = false;
    /// A cherry-pick or revert is under way; `sequence_word` is its banner
    /// (`CHERRY-PICKING` or `REVERTING`) and `sequence_left` the steps after
    /// the stopped one. Set by `refresh`.
    pub bool is_sequencing = false;
    pub str sequence_word = "";
    pub int sequence_left = 0;
    /// A rebase is under way; it also sets the three `sequence_` fields, so
    /// the banner and the blocking work as for a cherry-pick.
    pub bool is_rebasing = false;
    /// The file the conflict-resolution view asked `$EDITOR` for, and whether
    /// the editor ran since the view last read it (see `GIT_ui_merge`).
    pub str resolve_edit_path = "";
    pub bool is_resolve_dirty = false;
}

pub void Core.push_overlay(Overlay overlay) {
    overlays.push(overlay);
}

/// Close the top overlay. A no-op with none open.
pub void Core.pop_overlay() {
    if (overlays.size() > 0) {
        overlays.pop();
    }
}

pub bool Core.has_overlay() {
    return overlays.size() > 0;
}

/// The keys the footer should show right now: the top overlay's, else the
/// everywhere keys (`?` help, `@` log) and then the current view's. The
/// everywhere keys come first because the footer is one row: on a narrow
/// terminal it is the end that is cut off, and `?` is how a user finds the
/// rest.
pub List<Hint> Core.active_hints() {
    if (overlays.size() > 0) {
        return overlays[overlays.size() - 1].hints();
    }
    List<Hint> out = hints_for(SCOPE_GLOBAL);
    List<Hint> view = hints_for(SCOPE_OUTLINE);
    if (is_diff_open) {
        view = hints_for(SCOPE_DIFF);
    }
    for (Hint hint in view) {
        out.push(hint);
    }
    return out;
}

/// The logging hook: record one write operation, one line. Called by the ops
/// that change the repository (`stage_path`, `finish_commit`, ...) right after
/// the engine call succeeded.
pub void Core.log_command(str line) {
    command_log.push(line);
    while (command_log.size() > COMMAND_LOG_CAPACITY) {
        command_log.remove_at(0);
    }
}

/// Re-read the repository: `GIT_status.status` for the three change lists,
/// `GIT_log.walk` for the commit history, and HEAD for the branch label the
/// status line shows. An unborn branch's `GIT_log.walk` failure is not an
/// error here -- it is exactly what "nothing committed yet" looks like --
/// so it becomes an empty history rather than a message.
pub void Core.refresh() {
    match (GIT_status.status(gitdir, worktree)) {
        case Ok(GIT_status.Status status): {
            last_status = status;
        }
        case Err(GIT_status.Error error): {
            last_status = GIT_status.Status([], [], []);
            message = "status: " + error.to_str();
        }
    }
    match (GIT_log.walk(gitdir, "HEAD", log_limit)) {
        case Ok(List<GIT_log.Entry> entries): {
            log = entries;
        }
        case Err: {
            log = [];
        }
    }
    is_merging = GIT_merge.is_in_progress(gitdir);
    is_sequencing = false;
    sequence_word = "";
    sequence_left = 0;
    match (GIT_sequencer.state(gitdir)) {
        case Some(GIT_sequencer.State found): {
            is_sequencing = true;
            sequence_word = GIT_sequencer.banner(gitdir);
            sequence_left = found.todo.size();
            if (found.is_stopped && sequence_left > 0) {
                sequence_left = sequence_left - 1;
            }
        }
        case None: {
        }
    }
    is_rebasing = false;
    match (GIT_rebase.state(gitdir)) {
        case Some(GIT_rebase.State found): {
            is_rebasing = true;
            is_sequencing = true;
            sequence_word = GIT_rebase.banner(gitdir);
            sequence_left = found.upcoming.size();
        }
        case None: {
        }
    }
    branch_rows = [];
    match (GIT_checkout.branches(gitdir)) {
        case Ok(List<GIT_checkout.Branch> branches): {
            List<str> names = [];
            for (GIT_checkout.Branch branch in branches) {
                names.push(branch.name);
            }
            // Upstream and ahead/behind, one config read and one graph for all.
            Map<str, GIT_branches.Tracking> found = GIT_branches.tracking_all(gitdir, names);
            for (GIT_checkout.Branch branch in branches) {
                GIT_ui_model.BranchRow row = GIT_ui_model.BranchRow(branch, tip_subject(branch.id));
                match (found.get(branch.name)) {
                    case Some(GIT_branches.Tracking tracking): {
                        row.upstream = tracking.upstream;
                        row.track = tracking.label();
                    }
                    case None: {
                    }
                }
                branch_rows.push(row);
            }
        }
        case Err: {
        }
    }
    stash_labels = GIT_stash.labels(gitdir);
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    branch_label = "on " + GIT_ui_model.branch_name(name) + " @ " + id.substr(0, 7) + track_suffix(GIT_ui_model.branch_name(name));
                }
                case Unborn(str name): {
                    branch_label = "on " + GIT_ui_model.branch_name(name) + " (no commits yet)";
                }
                case Detached(str id): {
                    branch_label = "detached @ " + id.substr(0, 7);
                }
            }
        }
        case Err(_): {
            branch_label = "?";
        }
    }
    if (is_sequencing) {
        branch_label = branch_label + "  " + sequence_word;
    }
}

/// True, with a message, while a cherry-pick or revert is under way: `what`
/// would change HEAD or the tree under it. The caller returns without acting.
pub bool Core.is_blocked_by_sequence(str what) {
    if (!is_sequencing) {
        return false;
    }
    str keys = "A or V";
    if (is_rebasing) {
        keys = "r";
    }
    message = what + " is blocked while " + sequence_word + " (" + keys + ": continue, skip or abort)";
    return true;
}

// " [ahead 2, behind 1]" for the header, "" when level or without upstream.
pub str Core.track_suffix(str name) {
    for (GIT_ui_model.BranchRow row in branch_rows) {
        if (row.branch.name == name && row.track != "") {
            return " " + row.track;
        }
    }
    return "";
}

/// Make sure `commit_changes_cache` has an entry for commit `id` -- computed
/// now if it is the first time this commit is unfolded, a no-op afterwards.
/// A commit whose tree or parent's tree cannot be read (a truncated history,
/// a shallow clone's boundary) gets an empty file list rather than failing
/// the unfold. Answers whether anything new was computed, so the caller knows
/// the outline it is looking at was built without this commit's files and
/// needs rebuilding.
pub bool Core.did_compute_commit_changes(str id) {
    if (commit_changes_cache.contains(id)) {
        return false;
    }
    for (GIT_log.Entry entry in log) {
        if (entry.id == id) {
            match (GIT_ui_model.commit_changes(gitdir, entry.commit)) {
                case Ok(List<GIT_ui_model.CommitFileDiff> changes): {
                    commit_changes_cache.set(id, changes);
                }
                case Err: {
                    commit_changes_cache.set(id, []);
                }
            }
            return true;
        }
    }
    return false;
}

/// Refresh and rebuild the outline, keeping the cursor on the row it was on
/// (by id, not by position -- `TUI_outline.m31`'s own reason) and the jump
/// list in step with it. Called after every action that changes what the
/// repository looks like: staging, unstaging, committing, and the manual
/// refresh key.
pub void Core.reload() {
    str keep_id = "";
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            keep_id = row.node.id;
        }
        case None: {
        }
    }
    refresh();
    outline = GIT_ui_model.build_outline(last_status, log, commit_changes_cache, collapsed, paths, file_diffs, branch_rows, stashes: stash_labels);
    List<TUI_outline.Node> merge_roots = GIT_ui_merge_model.merge_roots(last_status, is_merging, collapsed, paths, sequence_word, sequence_left);
    if (merge_roots.size() > 0) {
        for (TUI_outline.Node node in outline.roots) {
            merge_roots.push(node);
        }
        outline.roots = merge_roots;
    }
    if (keep_id != "") {
        outline.did_select_id(keep_id);
    }
    jump.sync_from(outline);
    jump.follow(outline);
}

/// `tip`'s first message line, for a branch row's label -- `""` if the commit
/// cannot be read (a ref pointing at something this cannot parse is shown by
/// name and id alone rather than hidden).
pub str Core.tip_subject(str tip) {
    match (GIT_object.read(gitdir, tip)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    return GIT_ui_model.first_line(commit.message);
                }
                case Blob: {
                    return "";
                }
                case Tree(_): {
                    return "";
                }
                case Tag: {
                    return "";
                }
            }
        }
        case Err: {
            return "";
        }
    }
}

/// What the status line shows: the last message, else the branch label.
pub str Core.status_line() {
    if (message != "") {
        return message;
    }
    return branch_label;
}

/// Set the status-line message. For overlays, which hold a layer and cannot
/// assign a promoted field from outside the type.
pub void Core.say(str text) {
    message = text;
}

/// The `Core` itself, for passing to an overlay that holds only a `Core`
/// (the embedded value is not reachable as a field).
pub Core Core.core() {
    return this;
}

/// Remember the search query (`/` and `n` / `N` read it back).
pub void Core.set_search(str query) {
    search_query = query;
}

/// The picker's answer: what the pick was for and the item chosen. The top
/// module's `settle` reads it and does the work (`PICK_CHECKOUT` checks the
/// branch out), so the picker stays ignorant of what it is picking for.
pub void Core.finish_pick(str purpose, str item) {
    picked_purpose = purpose;
    picked_item = item;
}

/// Take the picker's answer, leaving none behind.
pub Option<str> Core.take_pick(str purpose) {
    if (picked_purpose == purpose && picked_item != "") {
        str item = picked_item;
        picked_purpose = "";
        picked_item = "";
        return Option<str>.Some(item);
    }
    return Option<str>.None;
}

/// Point the two `$EDITOR` files at their places in the git directory: the
/// commit message (`COMMIT_EDITMSG`, git's own name) and the new branch's name.
pub void Core.set_editor_paths() {
    commit_message_path = fs.join(gitdir, "COMMIT_EDITMSG");
    branch_name_path = fs.join(gitdir, "GITUI_BRANCH_NAME");
}

// --- the key table ------------------------------------------------------------

/// The table. Order matters: it is the order of the footer and of the help
/// overlay. A function, not a module-level value, because m31 has no
/// module-level mutable state and building 60 small values per keypress is
/// nothing.
