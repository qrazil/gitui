    table.push(Binding(SCOPE_UNDO, CMD_YES, ["y", "enter"], "do it", "y", "confirm"));
    table.push(Binding(SCOPE_UNDO, CMD_REDO, ["r"], "show redo instead of undo", "r", "redo"));
    table.push(Binding(SCOPE_UNDO, CMD_UNDO, ["z"], "show undo instead of redo", "z", "undo"));
    table.push(Binding(SCOPE_UNDO, CMD_CLOSE, ["escape", "n", "q"], "cancel", "esc", "cancel"));
    table.push(Binding(SCOPE_TAGS, CMD_DOWN, ["j", "down"], "next tag", "j/k", "move"));
    table.push(Binding(SCOPE_TAGS, CMD_UP, ["k", "up"], "previous tag", "", ""));
    table.push(Binding(SCOPE_TAGS, CMD_NEW, ["n"], "new lightweight tag at HEAD (or the commit under the outline cursor)", "n", "new"));
    table.push(Binding(SCOPE_TAGS, CMD_ANNOTATE, ["a"], "new annotated tag: name, then message", "a", "annotate"));
    table.push(Binding(SCOPE_TAGS, CMD_DELETE, ["d"], "delete the tag under the cursor (asks first)", "d", "delete"));
    table.push(Binding(SCOPE_TAGS, CMD_CLOSE, ["escape", "q"], "close", "q", "close"));
    table.push(Binding(SCOPE_PROMPT, CMD_SUBMIT, ["enter"], "accept what is typed", "enter", "ok"));
    table.push(Binding(SCOPE_PROMPT, CMD_CLOSE, ["escape"], "cancel", "esc", "cancel"));
    table.push(Binding(SCOPE_PROMPT, CMD_ERASE, ["backspace"], "erase the last character", "", ""));
    table.push(Binding(SCOPE_PICKER, CMD_SUBMIT, ["enter"], "choose the highlighted item", "enter", "choose"));
    table.push(Binding(SCOPE_PICKER, CMD_DOWN, ["down", "tab"], "highlight the next item", "down", "next"));
    table.push(Binding(SCOPE_PICKER, CMD_UP, ["up", "back-tab"], "highlight the previous item", "up", "prev"));
    table.push(Binding(SCOPE_PICKER, CMD_ERASE, ["backspace"], "erase the last character of the filter", "", ""));
    table.push(Binding(SCOPE_PICKER, CMD_CLOSE, ["escape"], "cancel", "esc", "cancel"));
    return table;
}

/// The first seven characters of an object id, for a status line or a log
/// line; an empty id (no old value: an unborn branch) is seven zeros.
pub str short_id(str id) {
    if (id == "") {
        return "0000000";
    }
    if (id.size() <= 7) {
        return id;
    }
    return id.substr(0, 7);
}

/// The command `code` is bound to in `scope`, if any.
pub Option<str> lookup(str scope, term.Code code) {
    str name = code.to_str();
    for (Binding binding in key_table()) {
        if (binding.scope == scope && binding.keys.contains(name)) {
            return Option<str>.Some(binding.cmd);
        }
    }
    return Option<str>.None;
}

/// Every binding of `scope`, in table order.
pub List<Binding> bindings_in(str scope) {
    List<Binding> out = [];
    for (Binding binding in key_table()) {
        if (binding.scope == scope) {
            out.push(binding);
        }
    }
    return out;
}

/// What the footer shows for `scope`: the bindings that have footer text.
pub List<Hint> hints_for(str scope) {
    List<Hint> out = [];
    for (Binding binding in bindings_in(scope)) {
        if (binding.footer_keys != "") {
            out.push(Hint(binding.footer_keys, binding.footer_label));
        }
    }
    return out;
}

/// A heading for `scope` in the help overlay.
pub str scope_title(str scope) {
    if (scope == SCOPE_OUTLINE) {
        return "outline";
    }
    if (scope == SCOPE_DIFF) {
        return "diff view";
    }
    if (scope == SCOPE_GLOBAL) {
        return "everywhere";
    }
    if (scope == SCOPE_COMMIT) {
        return "commit overlay (c)";
    }
    if (scope == SCOPE_BRANCH) {
        return "branch overlay (b)";
    }
    if (scope == SCOPE_PUSH) {
        return "push overlay (P)";
    }
    if (scope == SCOPE_PULL) {
        return "pull overlay (F)";
    }
    if (scope == SCOPE_CONFIRM) {
        return "discard confirmation (x)";
    }
    if (scope == SCOPE_LOG) {
        return "command log (@)";
    }
    if (scope == SCOPE_HELP) {
        return "this help (?)";
    }
    if (scope == SCOPE_SEARCH) {
        return "search prompt (/)";
    }
    if (scope == SCOPE_PICKER) {
        return "branch picker";
    }
    if (scope == SCOPE_MERGE) {
        return "merge menu (m)";
    }
    if (scope == SCOPE_MERGE_ASK) {
        return "yes / no question (merge, abort a cherry-pick or revert)";
    }
    if (scope == SCOPE_PICK) {
        return "cherry-pick menu (A)";
    }
    if (scope == SCOPE_REVERT) {
        return "revert menu (V)";
    }
    if (scope == SCOPE_SEQUENCE) {
        return "cherry-pick / revert under way (A or V)";
    }
    if (scope == SCOPE_REBASE) {
        return "rebase menu (r)";
    }
    if (scope == SCOPE_REBASE_BUSY) {
        return "rebase under way (r)";
    }
    if (scope == SCOPE_REBASE_TODO) {
        return "rebase todo list";
    }
    if (scope == SCOPE_PULL_ASK) {
        return "diverged pull: merge or rebase (F, then p)";
    }
    if (scope == SCOPE_RESOLVE) {
        return "conflict resolution (Enter on an unmerged path)";
    }
    if (scope == SCOPE_STASH) {
        return "stash overlay (z)";
    }
    if (scope == SCOPE_STASH_LIST) {
        return "stash list (z, then l)";
    }
    if (scope == SCOPE_STASH_PROMPT) {
        return "stash message / branch name prompt";
    }
    if (scope == SCOPE_BLAME) {
        return "blame view (B)";
    }
    if (scope == SCOPE_FILELOG) {
        return "file history (H)";
    }
    if (scope == SCOPE_SHOW) {
        return "commit view";
    }
    if (scope == SCOPE_UNDO) {
        return "undo / redo (Z)";
    }
    if (scope == SCOPE_TAGS) {
        return "tags (T)";
    }
    if (scope == SCOPE_PROMPT) {
        return "text prompt";
    }
    return scope;
}

/// Every scope, in the order the help overlay lists them.
pub List<str> all_scopes() {
    return [SCOPE_OUTLINE, SCOPE_DIFF, SCOPE_GLOBAL, SCOPE_COMMIT, SCOPE_BRANCH, SCOPE_PUSH, SCOPE_PULL, SCOPE_CONFIRM, SCOPE_LOG, SCOPE_HELP, SCOPE_SEARCH, SCOPE_PICKER, SCOPE_MERGE, SCOPE_MERGE_ASK, SCOPE_RESOLVE, SCOPE_STASH, SCOPE_STASH_LIST, SCOPE_STASH_PROMPT, SCOPE_BLAME, SCOPE_FILELOG, SCOPE_SHOW, SCOPE_UNDO, SCOPE_TAGS, SCOPE_PROMPT, SCOPE_PICK, SCOPE_REVERT, SCOPE_SEQUENCE, SCOPE_REBASE, SCOPE_REBASE_BUSY, SCOPE_REBASE_TODO, SCOPE_PULL_ASK];
}

